(* Fuzz target: recoverable external calls. A deferred call's `Error` arm runs as its own
   phase with the revert data; a query's outcome picks a `case` arm in the transition.
   The interpreter answers 0xcd with the call's own arguments, reverts at 0xee with them as
   the revert data, and answers 0x1 with one malformed byte; other addresses fail queries. *)

error Unavailable;

interface Ext is {
  function swap(amount : uint) : uint;
  function notify(id : uint);
  view function price(asset : uint) : uint;
  view function small(asset : uint) : uint8;
}

storage is record {
  status : uint;
  out : uint;
  failures : uint;
  notified : bool;
  price : uint;
  small : uint8;
  reason : bytes;
}

external function execute(const ex : Ext; const amount : uint) is {
  storage.status := 1;
  defer ex.swap(amount) then {
    | Ok(result : uint) -> {
        storage.status := 2;
        storage.out := result;
      }
    | Error(reason : bytes) -> {
        storage.status := 3;
        storage.reason := reason;
        storage.failures := storage.failures + 1;
      }
  };
}

external function ping(const ex : Ext; const id : uint) is {
  defer ex.notify(id) then {
    | Ok -> {
        storage.notified := true;
      }
    | Error(_) -> {
        storage.notified := false;
      }
  };
}

external function read(const ex : Ext; const asset : uint)
  raises Unavailable
is {
  case query ex.price(asset) of {
    | Ok(price) -> {
        storage.price := price;
      }
    | Error(_) -> {
        fail Unavailable;
      }
  }
}

external function readSmall(const ex : Ext; const asset : uint) is {
  case query ex.small(asset) of {
    | Ok(value) -> {
        storage.small := value;
      }
    | Error(reason) -> {
        storage.reason := reason;
      }
  }
}

(* A plain query reverts on failure, and on an answer that does not fit its type. *)
external function readPlain(const ex : Ext; const asset : uint) is {
  const value : uint8 := query ex.small(asset);
  storage.small := value;
}

(* The same, with the query issued before the write that precedes it. *)
external function readEarly(const ex : Ext; const asset : uint) is {
  storage.status := 9;
  const value : uint8 := query ex.small(asset);
  storage.small := value;
}

external view function status() : uint is storage.status

external view function reason() : bytes is storage.reason
