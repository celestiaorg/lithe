(* Fuzz target: deferred calls with continuations. Each continuation is a new phase that
   re-reads storage, may emit and defer again, and runs right after its call returns.
   The interpreter answers 0xcd with the call's own arguments, 0x2 with them as `bytes`,
   and 0x1 with one malformed byte. `text` echoes an ABI string whose length may run past
   the data. *)

error Too_small of uint;

interface Exchange is {
  payable function swap(amount : uint) : uint;
  function narrow(amount : uint) : uint8;
  function split(a : uint; b : uint) : (uint, uint);
  function text(offset : uint; len : uint; data : uint) : string;
  function digest(amount : uint) : string;
  function poke();
}

storage is record {
  status : uint;
  out : uint;
  small : uint8;
  a : uint;
  b : uint;
  name : string;
  steps : uint;
  paid : uint;
  seen : map(address, uint);
}

event Executed of record {
  indexed who : address;
  amount_out : uint;
}

external function execute(const ex : Exchange; const amount : uint)
  raises Too_small
is {
  const before : uint := storage.out;
  storage.status := 1;
  defer ex.swap(amount % 1000)
    then (result : uint) {
      assert(result >= before % 7, Too_small(result));
      storage.status := storage.status + 1;
      storage.out := result;
      storage.seen[Evm.sender()] := storage.seen[Evm.sender()] + result;
      emit Executed { who = Evm.sender(); amount_out = result; };
    };
  storage.steps := storage.steps + 1;
}

external function narrow(const ex : Exchange; const amount : uint) is {
  defer ex.narrow(amount)
    then (small : uint8) {
      storage.small := small;
    };
}

external function split(const ex : Exchange; const a : uint; const b : uint) is {
  defer ex.split(a, b)
    then ((x, y) : (uint, uint)) {
      storage.a := x;
      storage.b := y;
    };
}

external function chain(const ex : Exchange; const amount : uint) is {
  const op : operation := ex.swap(amount % 100);
  defer ex.poke();
  defer op
    then (first : uint) {
      storage.out := first;
      defer ex.swap(first + 1)
        then (second : uint) {
          storage.a := second + storage.out;
        };
      defer ex.poke()
        then {
          storage.steps := storage.steps + 10;
        };
    };
  defer ex.poke()
    then {
      storage.b := storage.a;
    };
}

external function rename(const ex : Exchange; const len : uint; const data : uint) is {
  defer ex.text(32, len % 40, data)
    then (name : string) {
      storage.name := name;
    };
}

external function hashed(const ex : Exchange; const amount : uint) is {
  defer ex.digest(amount)
    then (name : string) {
      storage.name := name;
      storage.steps := storage.steps + 1;
    };
}

external function fund(const ex : Exchange; const amount : uint) is {
  defer ex.swap(amount % 5)
    with value = amount % 5
    then (got : uint) {
      storage.paid := storage.paid + got;
    };
}

external view function status() : uint is storage.status

external view function out() : uint is storage.out

external view function name() : string is storage.name
