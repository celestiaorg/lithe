(* Fuzz target: bodies that query, so storage goes through the image. Shared functions
   read and write it, asserts read it for their errors, and branches follow the query.
   Address 2 is the SHA-256 precompile, which answers any query with a word. *)

import "std/evm";

error NotOwner of address;
error TooBig of record {
  have : uint;
  limit : uint;
}

interface Oracle is {
  view function price(amount : uint) : uint;
}

storage is record {
  owner : address;
  ready : bool;
  a : uint;
  b : uint;
  c : uint;
  small : uint8;
  total : uint;
  seen : map(address, uint);
}

event Moved of record {
  indexed who : address;
  amount : uint;
}

view function checkOwner()
  raises NotOwner
is {
  assert(storage.owner = Evm.sender() or not storage.ready, NotOwner(storage.owner));
}

function bump(const k : uint) is {
  storage.a := storage.a + k % 1000;
  storage.b := storage.b + storage.a;
  storage.seen[Evm.sender()] := storage.seen[Evm.sender()] + 1;
}

external function claim() is {
  storage.owner := Evm.sender();
  storage.ready := true;
}

external function refresh(const o : Oracle; const k : uint)
  raises NotOwner | TooBig
is {
  checkOwner();
  bump(k);
  const p : uint := query o.price(k);
  if p % 2 = 0 then {
    storage.c := p % 100000;
  } else {
    storage.small := uint8(p % 200);
    bump(p % 7);
  }
  assert(storage.b < 1000000000, TooBig { have = storage.b; limit = storage.total; });
  storage.total := storage.total + 1;
  emit Moved {
    who = Evm.sender();
    amount = storage.c;
  };
}

external function poke(const k : uint)
  raises NotOwner
is {
  checkOwner();
  bump(k);
}

external view function state() : (uint, uint, uint, uint8, uint) is
  (storage.a, storage.b, storage.c, storage.small, storage.total)

external view function seen(const who : address) : uint is
  storage.seen[who]
