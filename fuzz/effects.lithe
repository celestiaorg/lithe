(* Fuzz target: queries, deferred calls, transfers, and guarded entries. *)

import "std/evm";

error NotOwner;
error Low of uint;

interface Oracle is {
  view function price() : uint;
  view function quote(amount : uint) : uint;
}

interface Sink is {
  function deposit(amount : uint);
  function ping();
}

storage is record {
  owner : address;
  last : uint;
  sent : wei;
  calls : uint;
}

view function onlyOwner()
  raises NotOwner
is {
  assert(Evm.sender() = storage.owner, NotOwner);
}

external function read(const o : Oracle; const amount : uint) is {
  storage.last := query o.quote(amount) + query o.price();
}

external payable function forward(const s : Sink; const amount : uint)
  raises Low
is {
  assert(amount < 100, Low(amount));
  storage.sent += Evm.value();
  storage.calls += 1;
  defer s.deposit(amount);
  if amount > 3 then {
    defer s.ping();
  } else {
    skip
  }
  defer Evm.transfer(Evm.sender(), 0wei);
}

external function sweep(const to : address)
  raises NotOwner
is {
  onlyOwner();
  defer Evm.transfer(to, Evm.balance(Evm.self()));
}

external function claim(const next : address)
  raises NotOwner
is {
  onlyOwner();
  storage.owner := next;
}

external view function last() : uint is
  storage.last
