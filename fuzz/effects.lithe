(* Fuzz target: queries, deferred calls, transfers, and guarded entries. *)

error Not_owner;
error Low of nat;

interface Oracle is {
  view function price() : nat;
  view function quote(amount : nat) : nat;
}

interface Sink is {
  function deposit(amount : nat);
  function ping();
}

storage is record {
  owner : address;
  last : nat;
  sent : wei;
  calls : nat;
}

view function only_owner()
  raises Not_owner
is {
  assert(Evm.sender() = storage.owner, Not_owner);
}

external function read(const o : Oracle; const amount : nat) is {
  storage.last := query o.quote(amount) + query o.price();
}

external payable function forward(const s : Sink; const amount : nat)
  raises Low
is {
  assert(amount < 100n, Low(amount));
  storage.sent := storage.sent + Evm.value();
  storage.calls := storage.calls + 1n;
  defer s.deposit(amount);
  if amount > 3n then {
    defer s.ping();
  } else {
    skip
  }
  defer Evm.transfer(Evm.sender(), 0wei);
}

external function sweep(const to : address)
  raises Not_owner
is {
  only_owner();
  defer Evm.transfer(to, Evm.balance(Evm.self()));
}

external function claim(const next : address)
  raises Not_owner
is {
  only_owner();
  storage.owner := next;
}

external view function last() : nat is
  storage.last
