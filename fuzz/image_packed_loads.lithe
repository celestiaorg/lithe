(* Two leaves of one packed slot, `fee` and `who`, each read in two inlined copies of
   `payOut`, load into the image once each before their first use. Each load is built
   apart from the code it lands in, so the slot word one keeps must not serve the other. *)

import "std/evm";

interface Roy is {
  view function royaltyInfo(id : uint; price : uint) : (address, uint);
}

type Kind is BUY | SELL

type Order is record {
  kind : Kind;
  filled : uint;
}

storage s at "t" is record {
  orders : map(uint, Order);
  fee : uint16;
  who : address;
  tok : address;
}

event Fee of record {
  amount : uint;
}

external function setUp(const who : address; const tok : address) is {
  storage.s.fee := 250;
  storage.s.who := who;
  storage.s.tok := tok;
  storage.s.orders[1] := { kind = SELL; filled = 0; };
}

view function roy(const p : uint) : (address, uint) is
  case query Roy(storage.s.tok).royaltyInfo(1, p) of {
    | Ok(t) -> t
    | Error(_) -> (storage.s.who, 0)
  }

function payOut(const p : uint) is {
  const fee : uint := p * uint(storage.s.fee) / 10000;
  emit Fee { amount = fee; };
  if fee > 0 then {
    defer Evm.transfer(storage.s.who, wei(fee));
  }
  const (r, a) : (address, uint) := roy(p);
}

function take(const id : uint) is {
  const o : Order := storage.s.orders[id];
  storage.s.orders[id].filled := o.filled + 1;
  if o.kind = BUY then {
    payOut(1000000);
  } else {
    payOut(1000000);
  }
}

external payable function a(const id : uint) is take(id)
