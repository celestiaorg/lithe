(* Fuzz target: a `fallback` that runs another contract's code here for every call it has
   no entrypoint for. It takes no value, and short calldata reaches it. *)

import "std/evm";

storage is record {
  target : address;
  seen   : uint;
}

(* Never this contract: a call passed on to itself would go round until its gas ran out. *)
external function setTarget(const target : address) is {
  if target <> Evm.self() then {
    storage.target := target;
  }
}

external function mark(const n : uint) is {
  storage.seen := n % 100;
}

external view function seen() : uint is
  storage.seen

fallback delegates to storage.target;
