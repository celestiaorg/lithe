(* Fuzz target: records stored in maps, laid out like Solidity structs from the value's
   slot. Fields pack, a nested record starts a new slot, and a map of maps holds records
   too. Reads and writes go field by field or a whole record at a time. `priced` queries,
   so its storage goes through the journal; `setPrice` does the same work directly.
   Address 2 is the SHA-256 precompile, which answers any query with a word. *)

import "std/evm";

type Inner is record {
  flag : bool;
  delta : int16;
}

type Order is record {
  status : uint8;
  owner : address;
  amount : uint;
  small : uint32;
  inner : Inner;
  last : uint64;
}

type Pair is record {
  a : uint128;
  b : uint128;
}

error Missing of uint;

interface Oracle is {
  view function price(amount : uint) : uint;
}

event Placed of record {
  indexed id : uint;
  amount : uint;
  status : uint8;
}

storage is record {
  count : uint;
  orders : map(uint, Order);
  pairs : map(address, map(uint, Pair));
  tail : uint8;
}

external function place(const id : uint; const amount : uint; const small : uint32; const delta : int16) is {
  storage.orders[id] := {
    status = uint8(1);
    owner = Evm.sender();
    amount = amount;
    small = small;
    inner = { flag = true; delta = delta; };
    last = uint64(7);
  };
  storage.count := storage.count + 1;
  emit Placed { id = id; amount = storage.orders[id].amount; status = storage.orders[id].status; };
}

external function bump(const id : uint; const by : uint)
  raises Missing
is {
  assert(storage.orders[id].status > uint8(0), Missing(id));
  storage.orders[id].status := storage.orders[id].status + uint8(1);
  storage.orders[id].amount := storage.orders[id].amount + by;
  storage.orders[id].inner.delta := storage.orders[id].inner.delta - int16(1);
  storage.orders[id].last := storage.orders[id].last + uint64(1);
  storage.tail := storage.orders[id].status;
}

external function copy(const src : uint; const dst : uint) is {
  const o : Order := storage.orders[src];
  storage.orders[dst] := o;
  storage.orders[dst].inner := { flag = not o.inner.flag; delta = o.inner.delta; };
}

external function pairSet(const k : uint; const a : uint128; const b : uint128) is {
  storage.pairs[Evm.sender()][k] := { a = a; b = b; };
  storage.pairs[Evm.sender()][k + 1].b := b;
}

function reprice(const id : uint; const p : uint) is {
  storage.orders[id].amount := storage.orders[id].amount + p % 1000;
  storage.orders[id].status := uint8(p % 200);
  storage.orders[id].inner := { flag = p % 2 = 0; delta = int16(-5); };
  storage.orders[id + 1] := storage.orders[id];
  storage.orders[id + 1].last := uint64(p % 99);
  storage.tail := storage.orders[id].status;
}

external function priced(const o : Oracle; const id : uint) is {
  reprice(id, query o.price(id));
}

external function setPrice(const id : uint; const p : uint) is {
  reprice(id, p);
}

external view function probe(const o : Oracle; const id : uint) : uint is query o.price(id)

external view function orderOf(const id : uint) : Order is storage.orders[id]

external view function statusOf(const id : uint) : uint8 is storage.orders[id].status

external view function deltaOf(const id : uint) : int16 is storage.orders[id].inner.delta

external view function pairOf(const who : address; const k : uint) : Pair is storage.pairs[who][k]
