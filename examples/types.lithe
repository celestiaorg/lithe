(* Widths, nominal wrappers, value units, and time. *)

import "std/evm";

type BasisPoints is uint16;
type DiscountRate is uint16;

interface Fees is {
  view function feeOf(amount : uint) : BasisPoints;
}

storage is record {
  paid : wei;
  updated : timestamp;
  fee : BasisPoints;
}

external function quote(const fee : BasisPoints) is {
  const discount : DiscountRate := DiscountRate(uint16(fee));
  const _kept : DiscountRate := discount;
  storage.fee := fee;
  storage.paid := 1eth;
  storage.updated := Evm.blockTimestamp() + 1days;
}

(* An answer too wide for its nominal type reverts, as for the type it wraps. *)
external view function feeFrom(const fees : Fees; const amount : uint) : BasisPoints is
  query fees.feeOf(amount)

external view function hasFee(const fees : Fees; const amount : uint) : bool is
  case query fees.feeOf(amount) of {
    | Ok(_) -> true
    | Error(_) -> false
  }
