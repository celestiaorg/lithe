(* Widths, nominal wrappers, value units, and time. *)

type basis_points is uint16;
type discount_rate is uint16;

interface Fees is {
  view function fee_of(amount : nat) : basis_points;
}

storage is record {
  paid : wei;
  updated : timestamp;
  fee : basis_points;
}

external function quote(const fee : basis_points) is {
  const discount : discount_rate := discount_rate(uint16(fee));
  const _kept : discount_rate := discount;
  storage.fee := fee;
  storage.paid := 1eth;
  storage.updated := Evm.block_timestamp() + 1days;
}

(* An answer too wide for its nominal type reverts, as for the type it wraps. *)
external view function fee_from(const fees : Fees; const amount : nat) : basis_points is
  query fees.fee_of(amount)

external view function has_fee(const fees : Fees; const amount : nat) : bool is
  case query fees.fee_of(amount) of {
    | Ok(_) -> true
    | Error(_) -> false
  }
