module Ledger is {
  external function transfer(const amount : uint) is {
    skip
  }
}

module Other is {
  external function transfer(const amount : uint) is {
    skip
  }
}

contract Token is {
  storage is record {
    n : uint;
  }

  use Ledger exposing {
    function transfer(amount : uint);
  }

  use Other exposing {
    function transfer(amount : uint);
  }
}
