module Ledger is {
  external function transfer(const amount : nat) is {
    skip
  }
}

module Other is {
  external function transfer(const amount : nat) is {
    skip
  }
}

contract Token is {
  storage is record {
    n : nat;
  }

  use Ledger exposing {
    function transfer(amount : nat);
  }

  use Other exposing {
    function transfer(amount : nat);
  }
}
