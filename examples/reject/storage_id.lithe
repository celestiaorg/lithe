module Alpha is {
  storage foo at "lithe.std.foo" is record {
    n : nat;
  }

  external function go() is {
    foo.n := 1n;
  }
}

module Beta is {
  storage bar at "lithe.std.foo" is record {
    n : address;
  }

  function go() is {
    skip
  }
}

contract Token is {
  use Alpha exposing {
    function go();
  }

  use Beta;
}
