module Alpha is {
  storage foo at "lithe.std.foo" is record {
    n : uint;
  }

  external function go() is {
    storage.foo.n := 1;
  }
}

module Beta is {
  storage bar at "lithe.std.foo" is record {
    n : address;
  }

  function go() is {
    skip
  }
}

contract Token is {
  use Beta;

  use Alpha exposing {
    function go();
  }
}
