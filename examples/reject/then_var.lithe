(* A `var` belongs to the phase that made it. It does not cross an external call. *)

interface Exchange is {
  function swap(amount : nat) : nat;
}

storage is record {
  left : nat;
}

external nonreentrant function execute(const ex : Exchange; const amount : nat) is {
  var remaining : nat := amount;
  defer ex.swap(amount)
    then (out : nat) {
      storage.left := remaining + out;
    };
}
