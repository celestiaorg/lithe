module Pausable is {
  storage pausable at "lithe.pausable" is record {
    paused : bool;
  }

  error Paused;

  view function requireUnpaused() raises Paused is {
    assert(not pausable.paused, Paused);
  }
}

module Guarded is {
  external function go() is {
    Pausable.requireUnpaused();
  }
}

contract Token is {
  use Pausable;

  use Guarded exposing {
    function go();
  }

  storage is record {
    n : uint;
  }
}
