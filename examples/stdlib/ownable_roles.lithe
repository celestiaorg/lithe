(* Roles as bits of one mask per account, granted by the owner. A minter mints, and the
   owner or a pauser pauses. *)

import "std/access/ownable_roles";
import "std/evm";
import "std/access/ownable";

contract Minter is {
  use Ownable exposing IOwnable;
  use OwnableRoles exposing IOwnableRoles;

  storage is record {
    minted : map(address, uint);
    paused : bool;
  }

  pure function minter() : Roles is OwnableRoles.role(0)
  pure function pauser() : Roles is OwnableRoles.role(255)

  deploy()
    raises OwnableInvalidOwner
  is {
    Ownable.init(Evm.sender());
  }

  external function mint(const to : address; const amount : uint)
    raises Unauthorized
  is {
    OwnableRoles.checkRoles(minter());
    storage.minted[to] += amount;
  }

  external view function minted(const who : address) : uint is
    storage.minted[who]

  external function pause()
    raises Unauthorized
  is {
    OwnableRoles.checkOwnerOrRoles(pauser());
    storage.paused := true;
  }

  external function unpause()
    raises Unauthorized
  is {
    OwnableRoles.checkRolesOrOwner(pauser() | minter());
    storage.paused := false;
  }

  external view function paused() : bool is
    storage.paused

  (* Replaces an account's roles outright, as the contract's own rule. *)
  external function resetRoles(const who : address)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.checkOwner();
    OwnableRoles.setRoles(who, 0);
  }
}
