(* A governance token from the standard library: minting and pausing by role, a supply cap,
   burning, ERC-2612 permits, ERC-5805 votes with delegation by signature, and ERC-3156
   flash loans. `ERC20` calls the contract's hooks around every balance change: before, the
   pause; after, the cap on a mint, then the votes, in OpenZeppelin's order. So each
   transfer, mint, burn, and flash loan moves votes, and none of them runs while the token
   is paused. *)

import "std/crypto";
import "std/address";
import "std/evm";
import "std/token/erc20_votes";
import "std/token/erc20_permit";
import "std/token/erc20_capped";
import "std/token/erc20_flash_mint";
import "std/token/erc20_burnable";
import "std/access/access_control";
import "std/security/pausable";
import "std/token/erc20";
import "std/crypto/eip712";
import "std/interfaces/erc20";
import "std/utils/checkpoint";
import "std/interfaces/erc3156";
import "std/interfaces/erc5805";
import "std/crypto/ecdsa";
import "std/utils/nonce";
import "std/math/math";

contract GovernanceToken is {
  use ECDSA;
  use Nonces;
  use Math;
  use Checkpoints;

  use EIP712;

  use ERC20 exposing IERC20Metadata, IERC20Views, IERC20Approvals, {
    function transfer(to : address; value : uint) : bool
      raises ERC20InvalidSender | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap
        | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion;
    function transferFrom(from : address; to : address; value : uint) : bool
      raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
        | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
        | CheckpointUnorderedInsertion;
  }
  use ERC20Burnable exposing {
    function burn(value : uint)
      raises ERC20InvalidSender | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
        | CheckpointUnorderedInsertion;
    function burnFrom(account : address; value : uint)
      raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
        | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
        | CheckpointUnorderedInsertion;
  }
  use ERC20Permit exposing IERC20Permit;
  use ERC20Votes exposing IERC6372, IVotes, IVotesCheckpoints;
  use ERC20Capped exposing IERC20Capped;
  use ERC20FlashMint exposing IERC3156FlashLenderViews, {
    function flashLoan(receiver : IERC3156FlashBorrower; token : address; amount : uint; data : bytes) : bool
      raises ERC3156ExceededMaxLoan | ERC3156UnsupportedToken | ERC3156InvalidReceiver | ERC20InsufficientAllowance
        | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidReceiver | ERC20InvalidSender | EnforcedPause
        | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
        | forwarded;
  }
  use AccessControl exposing IAccessControl;
  use Pausable exposing IPausable;

  supports IERC20, IERC20Metadata, IERC20Permit, IERC6372, IVotes, IERC3156FlashLender,
    IAccessControl;

  pure function minter() : Role is
    Role(Crypto.keccak256("MINTER_ROLE"))

  pure function pauser() : Role is
    Role(Crypto.keccak256("PAUSER_ROLE"))

  (* The deployer administers the roles, and holds both to begin with. *)
  deploy()
    raises ERC20InvalidCap
  is {
    ERC20.init("Lithe Governance", "LGOV");
    EIP712.init("Lithe Governance", "1");
    ERC20Capped.init(10_000_000 * 10 ** 18);
    AccessControl.grant(AccessControl.defaultAdminRole(), Evm.sender());
    AccessControl.grant(minter(), Evm.sender());
    AccessControl.grant(pauser(), Evm.sender());
  }

  hook ERC20.beforeTransfer is Pausable.requireNotPaused;

  hook ERC20.afterTransfer(const from : address; const to : address; const value : uint)
    raises ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    ERC20Capped.afterTransfer(from, to, value);
    ERC20Votes.transferVotingUnits(from, to, value);
  }

  external function mint(const to : address; const value : uint)
    raises AccessControlUnauthorizedAccount | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance
      | ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    AccessControl.checkRole(minter());
    ERC20.mint(to, value);
  }

  external function pause()
    raises AccessControlUnauthorizedAccount | EnforcedPause
  is {
    AccessControl.checkRole(pauser());
    Pausable.pause();
  }

  external function unpause()
    raises AccessControlUnauthorizedAccount | ExpectedPause
  is {
    AccessControl.checkRole(pauser());
    Pausable.unpause();
  }
}
