(* An ERC-721 collection from the standard library. Anyone can mint the next token id;
   holders can burn theirs. *)

import "std/token/erc721.lithe";

contract Collection is {
  external use ERC721 is IERC721, IERC721Metadata;

  storage is record {
    next_id : nat;
  }

  deploy() is {
    ERC721.init("Lithe Collection", "LCOL");
  }

  external function mint() : nat
    raises ERC721InvalidReceiver | ERC721InvalidSender | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const id : nat := storage.next_id;
    storage.next_id := id + 1n;
    ERC721.safe_mint(Evm.sender(), id, "");
  } with id

  external function burn(const tokenId : nat)
    raises ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const previous : address := ERC721.update(Address.zero, tokenId, Evm.sender());
  }
}
