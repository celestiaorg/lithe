(* An ERC-721 collection from the standard library. Anyone can mint the next token id;
   holders can burn theirs. *)

import "std/address";
import "std/evm";
import "std/token/erc721";
import "std/interfaces/erc721";

contract Collection is {
  use ERC721 exposing IERC721, IERC721Metadata;
  supports IERC721, IERC721Metadata;

  storage is record {
    next_id : uint;
  }

  deploy() is {
    ERC721.init("Lithe Collection", "LCOL");
  }

  external function mint() : uint
    raises ERC721InvalidReceiver | ERC721InvalidSender | ERC721NonexistentToken | ERC721InsufficientApproval | forwarded
  is {
    const id : uint := storage.next_id;
    storage.next_id := id + 1;
    ERC721.safe_mint(Evm.sender(), id, "");
  } with id

  external function burn(const tokenId : uint)
    raises ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const _ : address := ERC721.update(Address.zero, tokenId, Evm.sender());
  }
}
