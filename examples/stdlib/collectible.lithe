(* A collectible series from the standard library: enumerable, with its own URI for each
   token under a shared base, ERC-2981 royalties, and an owner who mints, pauses, and sets
   royalties. Holders burn their own tokens. `ERC721` calls the contract's hooks around
   every transfer, mint, and burn: before, the pause; after, the enumerations, so they
   always match the owners.

   It answers ERC-165 for ERC-721 and its metadata and enumeration extensions, and for
   ERC-2981, which it lists in `supports`, and for ERC-4906, which `ERC721URIStorage`
   adds. *)

import "std/abi";
import "std/address";
import "std/evm";
import "std/token/erc721_enumerable";
import "std/token/erc721_uri_storage";
import "std/token/erc2981";
import "std/access/ownable";
import "std/security/pausable";
import "std/interfaces/erc2981";
import "std/token/erc721";
import "std/interfaces/erc721";

contract Collectible is {
  use ERC721URIStorage;

  use ERC721 exposing IERC721Name, IERC721Views, IERC721Approvals, {
    function transferFrom(from : address; to : address; tokenId : uint)
      raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
        | ERC721InsufficientApproval;
    function safeTransferFrom(from : address; to : address; tokenId : uint)
      raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
        | ERC721InsufficientApproval | forwarded;
    function safeTransferFrom(from : address; to : address; tokenId : uint; data : bytes)
      raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
        | ERC721InsufficientApproval | forwarded;
  }
  use ERC721Enumerable exposing IERC721Enumerable;
  use ERC2981 exposing IERC2981;
  use Ownable exposing IOwnable;
  use Pausable exposing IPausable;

  supports IERC721, IERC721Metadata, IERC721Enumerable, IERC2981;

  storage is record {
    nextId : uint;
  }

  hook ERC721.beforeTransfer is Pausable.requireNotPaused;
  hook ERC721.afterTransfer is ERC721Enumerable.afterTransfer;

  (* The creator owns the series and takes a 5% royalty until they set another. *)
  deploy()
    raises OwnableInvalidOwner | ERC2981InvalidDefaultRoyalty | ERC2981InvalidDefaultRoyaltyReceiver
  is {
    ERC721.init("Lithe Collectibles", "LCOL");
    Ownable.init(Evm.sender());
    ERC2981.setDefaultRoyalty(Evm.sender(), 500);
  }

  external pure function supportsInterface(const interfaceId : bytes4) : bool is
    ERC721URIStorage.supportsInterface(interfaceId) or Abi.supportsInterface(interfaceId)

  external view function tokenURI(const tokenId : uint) : string
    raises ERC721NonexistentToken
  is
    ERC721URIStorage.tokenURI(tokenId, "ipfs://lithe-collectibles/")

  (* The holder, or anyone they approved, burns a token. *)
  external function burn(const tokenId : uint)
    raises EnforcedPause | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const _ : address := ERC721.update(Address.zero, tokenId, Evm.sender());
  }

  (* Mints the next id, with its own URI under the base. *)
  external function safeMint(const to : address; const uri : string) : uint
    raises OwnableUnauthorizedAccount | EnforcedPause | ERC721InvalidReceiver | ERC721InvalidSender
      | ERC721NonexistentToken | ERC721InsufficientApproval | forwarded
  is {
    Ownable.checkOwner();
    const tokenId : uint := storage.nextId;
    storage.nextId := tokenId + 1;
    ERC721.safeMint(to, tokenId, "");
    ERC721URIStorage.setTokenURI(tokenId, uri);
  } with tokenId

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.checkOwner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.checkOwner();
    Pausable.unpause();
  }

  external function setDefaultRoyalty(const receiver : address; const fee : uint96)
    raises OwnableUnauthorizedAccount | ERC2981InvalidDefaultRoyalty | ERC2981InvalidDefaultRoyaltyReceiver
  is {
    Ownable.checkOwner();
    ERC2981.setDefaultRoyalty(receiver, fee);
  }

  external function setTokenRoyalty(const tokenId : uint; const receiver : address; const fee : uint96)
    raises OwnableUnauthorizedAccount | ERC2981InvalidTokenRoyalty | ERC2981InvalidTokenRoyaltyReceiver
  is {
    Ownable.checkOwner();
    ERC2981.setTokenRoyalty(tokenId, receiver, fee);
  }

  external function resetTokenRoyalty(const tokenId : uint)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.checkOwner();
    ERC2981.resetTokenRoyalty(tokenId);
  }
}
