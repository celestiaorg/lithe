(* An ERC-20 token from the standard library: burnable, with ERC-2612 permits, and an
   owner who may mint and pause. `ERC20` checks the pause before every balance change,
   through its `before_transfer` hook, so a pause stops transfers, mints, and burns, as
   OpenZeppelin's `ERC20Pausable` does. *)

import "std/evm";
import "std/token/erc20_permit";
import "std/token/erc20_burnable";
import "std/access/ownable";
import "std/security/pausable";
import "std/token/erc20";
import "std/crypto/eip712";
import "std/interfaces/erc20";
import "std/crypto/ecdsa";
import "std/utils/nonce";

contract Token is {
  use EIP712;
  use ECDSA;
  use Nonces;

  use ERC20 exposing IERC20Metadata, IERC20Views, IERC20Approvals, {
    function transfer(to : address; value : uint) : bool
      raises ERC20InvalidSender | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance;
    function transferFrom(from : address; to : address; value : uint) : bool
      raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
        | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance;
  }
  use ERC20Burnable exposing {
    function burn(value : uint)
      raises ERC20InvalidSender | EnforcedPause | ERC20InsufficientBalance;
    function burnFrom(account : address; value : uint)
      raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
        | EnforcedPause | ERC20InsufficientBalance;
  }
  use ERC20Permit exposing IERC20Permit;
  use Ownable exposing IOwnable;
  use Pausable exposing IPausable;

  supports IERC20, IERC20Metadata, IERC20Permit;

  storage is record {
    cap : uint;
  }

  error ERC20ExceededCap of record {
    increasedSupply : uint;
    cap : uint;
  }

  hook ERC20.before_transfer is Pausable.require_not_paused;
  hook ERC20.after_transfer is skip;

  deploy()
    raises OwnableInvalidOwner
  is {
    ERC20.init("Lithe Token", "LTK");
    EIP712.init("Lithe Token", "1");
    Ownable.init(Evm.sender());
    storage.cap := 1_000_000 * 10 ** 18;
  }

  external function mint(const to : address; const value : uint)
    raises OwnableUnauthorizedAccount | ERC20ExceededCap | ERC20InvalidReceiver | EnforcedPause
      | ERC20InsufficientBalance
  is {
    Ownable.check_owner();
    const supply : uint := ERC20.total_supply() + value;
    assert(supply <= storage.cap, ERC20ExceededCap { increasedSupply = supply; cap = storage.cap; });
    ERC20.mint(to, value);
  }

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.check_owner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.check_owner();
    Pausable.unpause();
  }
}
