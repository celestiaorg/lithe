(* An ERC-20 token from the standard library: burnable, with ERC-2612 permits, and an
   owner who may mint and pause. Transfers check the pause in the contract's own
   `transfer` and `transferFrom`, so the base module's behavior never changes silently. *)

import "std/token/erc20_permit.lithe";
import "std/token/erc20_burnable.lithe";
import "std/access/ownable.lithe";
import "std/security/pausable.lithe";

contract Token is {
  use EIP712;
  use ECDSA;
  use Nonces;

  external use ERC20 is IERC20Metadata, {
    view function totalSupply() : nat;
    view function balanceOf(account : address) : nat;
    view function allowance(owner : address; spender : address) : nat;
    function approve(spender : address; value : nat) : bool
      raises ERC20InvalidApprover | ERC20InvalidSpender;
  }

  external use ERC20Burnable is {
    function burn(value : nat)
      raises ERC20InvalidSender | ERC20InsufficientBalance;
    function burnFrom(account : address; value : nat)
      raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
        | ERC20InvalidSender | ERC20InsufficientBalance;
  }

  external use ERC20Permit is IERC20Permit;

  external use Ownable is {
    view function owner() : address;
    function transferOwnership(newOwner : address)
      raises OwnableUnauthorizedAccount | OwnableInvalidOwner;
    function renounceOwnership()
      raises OwnableUnauthorizedAccount;
  }

  external use Pausable is {
    view function paused() : bool;
  }

  storage is record {
    cap : nat;
  }

  error ERC20ExceededCap of record {
    increasedSupply : nat;
    cap : nat;
  }

  deploy()
    raises OwnableInvalidOwner
  is {
    ERC20.init("Lithe Token", "LTK");
    EIP712.init("Lithe Token", "1");
    Ownable.init(Evm.sender());
    storage.cap := 1_000_000n * 1_000_000_000_000_000_000n;
  }

  external function transfer(const to : address; const value : nat) : bool
    raises EnforcedPause | ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    Pausable.require_not_paused();
    ERC20.move(Evm.sender(), to, value);
  } with true

  external function transferFrom(const from : address; const to : address; const value : nat) : bool
    raises EnforcedPause | ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
      | ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    Pausable.require_not_paused();
    ERC20.spend_allowance(from, Evm.sender(), value);
    ERC20.move(from, to, value);
  } with true

  external function mint(const to : address; const value : nat)
    raises OwnableUnauthorizedAccount | ERC20ExceededCap | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    Ownable.check_owner();
    const supply : nat := ERC20.total_supply() + value;
    assert(supply <= storage.cap, ERC20ExceededCap { increasedSupply = supply; cap = storage.cap; });
    ERC20.mint(to, value);
  }

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.check_owner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.check_owner();
    Pausable.unpause();
  }
}
