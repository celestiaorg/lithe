(* An ERC-1155 collection of game items from the standard library, with supply tracking.
   The owner mints and sets the URI; holders, and operators they approve, burn. The
   supplies follow every mint and burn through `ERC1155`'s `after_transfer` hook. *)

import "std/evm";
import "std/token/erc1155_supply";
import "std/access/ownable";
import "std/token/erc1155";
import "std/interfaces/erc1155";

contract Items is {
  use ERC1155 exposing IERC1155, IERC1155MetadataURI;
  use ERC1155Supply exposing IERC1155Supply;
  use Ownable exposing IOwnable;

  supports IERC1155, IERC1155MetadataURI;

  hook ERC1155.before_transfer is skip;
  hook ERC1155.after_transfer is ERC1155Supply.after_transfer;

  deploy()
    raises OwnableInvalidOwner
  is {
    ERC1155.set_uri("https://items.example/api/item/{id}.json");
    Ownable.init(Evm.sender());
  }

  external function mint(const to : address; const id : uint; const value : uint; const data : bytes)
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
      | forwarded
  is {
    Ownable.check_owner();
    ERC1155.mint(to, id, value, data);
  }

  external function mintBatch(const to : address; const ids : list(uint); const values : list(uint); const data : bytes)
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
      | forwarded
  is {
    Ownable.check_owner();
    ERC1155.mint_batch(to, ids, values, data);
  }

  external function burn(const account : address; const id : uint; const value : uint)
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    ERC1155.check_authorized(Evm.sender(), account);
    ERC1155.burn(account, id, value);
  }

  external function burnBatch(const account : address; const ids : list(uint); const values : list(uint))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    ERC1155.check_authorized(Evm.sender(), account);
    ERC1155.burn_batch(account, ids, values);
  }

  external function setURI(const uri : string)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.check_owner();
    ERC1155.set_uri(uri);
  }
}
