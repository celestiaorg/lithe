(* The standard library's math, crypto, and utility modules and its collections, each
   behind an entrypoint. *)

import "std/evm";
import "std/math/math";
import "std/math/safe_cast";
import "std/math/fixed_point";
import "std/crypto/ecdsa";
import "std/crypto/eip712";
import "std/crypto/merkle";
import "std/utils/create2";
import "std/utils/nonce";
import "std/utils/checkpoint";
import "std/collections/bitmap";
import "std/collections/queue";
import "std/collections/set";
import "std/collections/set_enumerable";

contract Utils is {
  use Math;
  use SafeCast;
  use FixedPoint;
  use ECDSA;
  use EIP712;
  use Merkle;
  use Create2;
  use Nonces;
  use Checkpoints;
  use Bitmap;

  storage is record {
    claimed : bitmap;
    history : trace;
    pending : Queue(address);
    members : Set(address);
    listed : SetEnumerable(address);
  }

  deploy() is {
    EIP712.init("Utils", "1");
  }

  external pure function sqrt(const a : uint) : uint is Math.sqrt(a)
  external pure function log2(const a : uint) : uint is Math.log2(a)
  external pure function log10(const a : uint) : uint is Math.log10(a)
  external pure function abs(const x : int) : uint is Math.abs(x)
  external pure function average(const a : uint; const b : uint) : uint is Math.average(a, b)
  external pure function average_int(const a : int; const b : int) : int is Math.average(a, b)
  external pure function min_int(const a : int; const b : int) : int is Math.min(a, b)
  external pure function max_int(const a : int; const b : int) : int is Math.max(a, b)
  external pure function ceil_div(const a : uint; const b : uint) : uint is Math.ceil_div(a, b)
  external pure function mul_div_up(const a : uint; const b : uint; const d : uint) : uint is Math.mul_div_up(a, b, d)
  external pure function clamp(const x : uint; const lo : uint; const hi : uint) : uint
    raises MathInvalidRange
  is Math.clamp(x, lo, hi)
  external pure function clamp_int(const x : int; const lo : int; const hi : int) : int
    raises MathInvalidSignedRange
  is Math.clamp(x, lo, hi)
  external pure function to_uint(const x : int) : uint
    raises SafeCastOverflowedIntToUint
  is SafeCast.to_uint(x)
  external pure function wad_mul(const a : uint; const b : uint) : uint is uint(FixedPoint.wad_mul(wad(a), wad(b)))
  external pure function recover(const hash : bytes32; const signature : bytes) : address
    raises ECDSAInvalidSignature | ECDSAInvalidSignatureLength | ECDSAInvalidSignatureS
  is ECDSA.recover_signature(hash, signature)
  external view function domain() : bytes32 is EIP712.domain_separator()
  external pure function root(const proof : bytes; const leaf : bytes32) : bytes32
    raises MerkleProofInvalidLength
  is Merkle.process_proof(proof, leaf)
  external view function predict(const salt : bytes32; const code_hash : bytes32) : address is
    Create2.compute_address_here(salt, code_hash)
  external function use_nonce(const owner : address) : uint is Nonces.use_nonce(owner)
  external function claim(const index : uint) is { Bitmap.set(storage.claimed, index); }
  external view function is_claimed(const index : uint) : bool is Bitmap.get(storage.claimed, index)
  external function checkpoint_value(const value : uint)
    raises CheckpointUnorderedInsertion
  is {
    Checkpoints.push(storage.history, uint48(Evm.block_number()), uint208(value));
  }
  external view function value_at(const key : uint) : uint is
    uint(Checkpoints.upper_lookup(storage.history, uint48(key)))
  external function enqueue() is { Queue.push(storage.pending, Evm.sender()); }
  external view function queued() : uint is Queue.length(storage.pending)
  external function join() is {
    Set.add(storage.members, Evm.sender());
    SetEnumerable.add(storage.listed, Evm.sender());
  }
  external view function member(const who : address) : bool is Set.contains(storage.members, who)
  external view function listed_count() : uint is SetEnumerable.length(storage.listed)
  external view function verify(const proof : bytes; const root_hash : bytes32; const leaf : bytes32) : bool
    raises MerkleProofInvalidLength
  is Merkle.verify(proof, root_hash, leaf)
  external pure function create2_address(
    const salt : bytes32;
    const code_hash : bytes32;
    const deployer : address
  ) : address is Create2.compute_address(salt, code_hash, deployer)
  external pure function eth_message(const hash : bytes32) : bytes32 is ECDSA.to_eth_signed_message_hash(hash)
  external pure function recover_vrs(
    const hash : bytes32;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  ) : address
    raises ECDSAInvalidSignature | ECDSAInvalidSignatureS
  is ECDSA.recover(hash, v, r, s)
  external pure function to_int(const x : uint) : int
    raises SafeCastOverflowedUintToInt
  is SafeCast.to_int(x)
  external pure function apply_bps(const amount : uint; const bps : uint) : uint is FixedPoint.apply_bps(amount, bps)
  external pure function wad_div(const a : uint; const b : uint) : uint is uint(FixedPoint.wad_div(wad(a), wad(b)))
  external view function checkpoints() : uint is Checkpoints.length(storage.history)
  external view function latest() : uint is uint(Checkpoints.latest(storage.history))
  external function unclaim(const index : uint) is { Bitmap.unset(storage.claimed, index); }
  external function dequeue() : address
    raises QueueEmpty
  is Queue.pop(storage.pending)
}
