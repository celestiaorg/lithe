(* The standard library's math, crypto, and utility modules and its collections, each
   behind an entrypoint. *)

import "std/evm";
import "std/math/math";
import "std/math/safe_cast";
import "std/math/fixed_point";
import "std/crypto/ecdsa";
import "std/crypto/eip712";
import "std/crypto/merkle";
import "std/crypto/signature_checker";
import "std/utils/create2";
import "std/utils/nonce";
import "std/utils/checkpoint";
import "std/collections/bitmap";
import "std/collections/queue";
import "std/collections/set";
import "std/collections/set_enumerable";
import "std/collections/map_enumerable";
import "std/address";
import "std/interfaces/erc5267";

contract Utils is {
  use Math;
  use SafeCast;
  use FixedPoint;
  use ECDSA;
  use EIP712 exposing IERC5267;
  use Merkle;
  use SignatureChecker;
  use Create2;
  use Nonces;
  use Checkpoints;
  use Bitmap;

  storage is record {
    claimed : Bitmap;
    history : Trace;
    pending : Queue(address);
    members : Set(address);
    listed : SetEnumerable(address);
    balances : MapEnumerable(address, uint);
    tags : MapEnumerable(bytes4, address);
    flags : Bitmap;
  }

  deploy() is {
    EIP712.init("Utils", "1");
  }

  external pure function sqrt(const a : uint) : uint is Math.sqrt(a)
  external pure function log2(const a : uint) : uint is Math.log2(a)
  external pure function log10(const a : uint) : uint is Math.log10(a)
  external pure function log256(const a : uint) : uint is Math.log256(a)
  external pure function log2Up(const a : uint) : uint is Math.log2Up(a)
  external pure function log10Up(const a : uint) : uint is Math.log10Up(a)
  external pure function log256Up(const a : uint) : uint is Math.log256Up(a)
  external pure function abs(const x : int) : uint is Math.abs(x)
  external pure function average(const a : uint; const b : uint) : uint is Math.average(a, b)
  external pure function averageInt(const a : int; const b : int) : int is Math.average(a, b)
  external pure function minInt(const a : int; const b : int) : int is Math.min(a, b)
  external pure function maxInt(const a : int; const b : int) : int is Math.max(a, b)
  external pure function ceilDiv(const a : uint; const b : uint) : uint is Math.ceilDiv(a, b)
  external pure function mulDivUp(const a : uint; const b : uint; const d : uint) : uint is Math.mulDivUp(a, b, d)
  external pure function clamp(const x : uint; const lo : uint; const hi : uint) : uint
    raises MathInvalidRange
  is Math.clamp(x, lo, hi)
  external pure function clampInt(const x : int; const lo : int; const hi : int) : int
    raises MathInvalidSignedRange
  is Math.clamp(x, lo, hi)
  external pure function toUint(const x : int) : uint
    raises SafeCastOverflowedIntToUint
  is SafeCast.toUint(x)
  external pure function wadMul(const a : uint; const b : uint) : uint is uint(FixedPoint.wadMul(Wad(a), Wad(b)))
  external pure function recover(const hash : bytes32; const signature : bytes) : address
    raises ECDSAInvalidSignature | ECDSAInvalidSignatureLength | ECDSAInvalidSignatureS
  is ECDSA.recoverSignature(hash, signature)
  external view function domain() : bytes32 is EIP712.domainSeparator()
  external pure function root(const proof : list(bytes32); const leaf : bytes32) : bytes32 is
    Merkle.processProof(proof, leaf)
  external view function predict(const salt : bytes32; const codeHash : bytes32) : address is
    Create2.computeAddressHere(salt, codeHash)
  external function useNonce(const owner : address) : uint is Nonces.useNonce(owner)
  external function claim(const index : uint) is { Bitmap.set(storage.claimed, index); }
  external view function isClaimed(const index : uint) : bool is Bitmap.get(storage.claimed, index)
  external function checkpointValue(const value : uint)
    raises CheckpointUnorderedInsertion
  is {
    Checkpoints.push(storage.history, uint48(Evm.blockNumber()), uint208(value));
  }
  external view function valueAt(const key : uint) : uint is
    uint(Checkpoints.upperLookup(storage.history, uint48(key)))
  external function enqueue() is { Queue.push(storage.pending, Evm.sender()); }
  external view function queued() : uint is Queue.length(storage.pending)
  external function join() is {
    Set.add(storage.members, Evm.sender());
    const _ : bool := SetEnumerable.add(storage.listed, Evm.sender());
  }
  external view function member(const who : address) : bool is Set.contains(storage.members, who)
  external view function listedCount() : uint is SetEnumerable.length(storage.listed)
  external view function verify(const proof : list(bytes32); const rootHash : bytes32; const leaf : bytes32) : bool is
    Merkle.verify(proof, rootHash, leaf)
  external pure function verifyMulti(
    const proof : list(bytes32);
    const flags : list(bool);
    const rootHash : bytes32;
    const leaves : list(bytes32)
  ) : bool
    raises MerkleProofInvalidMultiproof
  is Merkle.verifyMulti(proof, flags, rootHash, leaves)
  external pure function multiRoot(
    const proof : list(bytes32);
    const flags : list(bool);
    const leaves : list(bytes32)
  ) : bytes32
    raises MerkleProofInvalidMultiproof
  is Merkle.processMultiProof(proof, flags, leaves)
  external pure function create2Address(
    const salt : bytes32;
    const codeHash : bytes32;
    const deployer : address
  ) : address is Create2.computeAddress(salt, codeHash, deployer)
  external pure function ethMessage(const hash : bytes32) : bytes32 is ECDSA.toEthSignedMessageHash(hash)
  external pure function recoverVrs(
    const hash : bytes32;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  ) : address
    raises ECDSAInvalidSignature | ECDSAInvalidSignatureS
  is ECDSA.recover(hash, v, r, s)
  external pure function tryRecover(const hash : bytes32; const signature : bytes) : address is
    case ECDSA.tryRecoverSignature(hash, signature) of { Some(signer) -> signer | None -> Address.zero }
  external pure function tryRecoverVrs(
    const hash : bytes32;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  ) : address is
    case ECDSA.tryRecover(hash, v, r, s) of { Some(signer) -> signer | None -> Address.zero }
  external pure function tryRecoverCompact(const hash : bytes32; const r : bytes32; const vs : bytes32) : address is
    case ECDSA.tryRecoverCompact(hash, r, vs) of { Some(signer) -> signer | None -> Address.zero }
  external pure function recoverCompact(const hash : bytes32; const r : bytes32; const vs : bytes32) : address
    raises ECDSAInvalidSignature | ECDSAInvalidSignatureS
  is ECDSA.recoverCompact(hash, r, vs)
  external view function isValidSignatureNow(
    const signer : address;
    const hash : bytes32;
    const signature : bytes
  ) : bool is
    SignatureChecker.isValidSignatureNow(signer, hash, signature)
  external view function isValidERC1271SignatureNow(
    const signer : address;
    const hash : bytes32;
    const signature : bytes
  ) : bool is
    SignatureChecker.isValidERC1271SignatureNow(signer, hash, signature)
  external pure function toInt(const x : uint) : int
    raises SafeCastOverflowedUintToInt
  is SafeCast.toInt(x)
  external pure function applyBps(const amount : uint; const bps : uint) : uint is FixedPoint.applyBps(amount, bps)
  external pure function wadDiv(const a : uint; const b : uint) : uint is uint(FixedPoint.wadDiv(Wad(a), Wad(b)))
  external view function checkpoints() : uint is Checkpoints.length(storage.history)
  external view function latest() : uint is uint(Checkpoints.latest(storage.history))
  external function unclaim(const index : uint) is { Bitmap.unset(storage.claimed, index); }
  external function dequeue() : address
    raises QueueEmpty
  is Queue.pop(storage.pending)
  external function flag(const start : uint; const amount : uint) is { Bitmap.setBatch(storage.flags, start, amount); }
  external function unflag(const start : uint; const amount : uint) is {
    Bitmap.unsetBatch(storage.flags, start, amount);
  }
  external view function flagged(const start : uint; const amount : uint) : uint is
    Bitmap.popCount(storage.flags, start, amount)
  external view function isFlagged(const index : uint) : bool is Bitmap.get(storage.flags, index)
  external function mapSet(const key : address; const value : uint) is {
    const _ : bool := MapEnumerable.set(storage.balances, key, value);
  }
  external function mapRemove(const key : address) is {
    const _ : bool := MapEnumerable.remove(storage.balances, key);
  }
  external view function mapGet(const key : address) : uint
    raises EnumerableMapNonexistentKey
  is MapEnumerable.get(storage.balances, key)
  external view function mapTryGet(const key : address) : (bool, uint) is
    case MapEnumerable.tryGet(storage.balances, key) of {
      | Some(value) -> (true, value)
      | None -> (false, 0)
    }
  external view function mapContains(const key : address) : bool is MapEnumerable.contains(storage.balances, key)
  external view function mapLength() : uint is MapEnumerable.length(storage.balances)
  external view function mapAt(const index : uint) : (address, uint)
    raises OutOfBounds
  is MapEnumerable.at(storage.balances, index)
  external function tag(const key : bytes4; const value : address) is {
    const _ : bool := MapEnumerable.set(storage.tags, key, value);
  }
  external view function tagged(const key : bytes4) : address
    raises EnumerableMapNonexistentKey
  is MapEnumerable.get(storage.tags, key)
}
