(* Access control from the standard library: roles for minting and pausing, and an owner
   handed over in two steps. A role is a `role`, so a stray `bytes32` can't be passed
   where a role is meant. *)

import "std/crypto";
import "std/evm";
import "std/access/ownable_two_step";
import "std/access/access_control";
import "std/security/pausable";
import "std/access/ownable";

contract Registry is {
  use Ownable;

  use Ownable2Step exposing IOwnable2Step;
  use AccessControl exposing IAccessControl;
  use Pausable exposing IPausable;

  supports IAccessControl;

  storage is record {
    entries : map(address, uint);
  }

  pure function minter() : role is
    role(Crypto.keccak256("MINTER_ROLE"))

  pure function pauser() : role is
    role(Crypto.keccak256("PAUSER_ROLE"))

  deploy()
    raises OwnableInvalidOwner
  is {
    Ownable.init(Evm.sender());
    AccessControl.grant(AccessControl.default_admin_role(), Evm.sender());
    AccessControl.grant(minter(), Evm.sender());
  }

  external function record_entry(const account : address; const amount : uint)
    raises AccessControlUnauthorizedAccount | EnforcedPause
  is {
    AccessControl.check_role(minter());
    Pausable.require_not_paused();
    storage.entries[account] := storage.entries[account] + amount;
  }

  external view function entry(const account : address) : uint is
    storage.entries[account]

  (* The owner decides who may pause. *)
  external function set_pauser(const account : address; const allowed : bool)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.check_owner();
    if allowed then {
      AccessControl.grant(pauser(), account);
    } else {
      AccessControl.revoke(pauser(), account);
    }
  }

  external function pause()
    raises AccessControlUnauthorizedAccount | EnforcedPause
  is {
    AccessControl.check_role(pauser());
    Pausable.pause();
  }

  external function unpause()
    raises AccessControlUnauthorizedAccount | ExpectedPause
  is {
    AccessControl.check_role(pauser());
    Pausable.unpause();
  }
}
