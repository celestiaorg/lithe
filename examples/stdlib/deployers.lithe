(* Contracts from creation code the factory builds: ERC-1167 clones of an
   implementation, data kept as code with SSTORE2, and CREATE3 deployments whose
   address depends only on a salt. *)

import "std/evm";
import "std/utils/create2";
import "std/utils/clones";
import "std/utils/sstore2";
import "std/utils/create3";

contract Deployers is {
  use Create2;
  use Clones;
  use SSTORE2;
  use Create3;

  storage is record {
    last : address;
    pointer : address;
  }

  external function clone(const implementation : address) is {
    defer create(Clones.code(implementation)) then (instance : address) {
      storage.last := instance;
    };
  }

  external function cloneWithArgs(const implementation : address; const args : bytes)
    raises CloneArgumentsTooLong
  is {
    defer create(Clones.codeWithArgs(implementation, args)) then (instance : address) {
      storage.last := instance;
    };
  }

  external function cloneDeterministic(const implementation : address; const salt : bytes32) : address
    raises FailedDeployment
  is {
    storage.last := Clones.cloneDeterministic(implementation, salt);
  } with storage.last

  external view function predictClone(const implementation : address; const salt : bytes32) : address is
    Clones.predictHere(implementation, salt)

  external view function argsOf(const instance : address) : bytes is
    Clones.argsOf(instance)

  external function write(const data : bytes) is {
    defer create(SSTORE2.code(data)) then (pointer : address) {
      storage.pointer := pointer;
    };
  }

  external function writeCounterfactual(const data : bytes; const salt : bytes32) : address
    raises FailedDeployment
  is {
    storage.pointer := SSTORE2.writeCounterfactual(data, salt);
  } with storage.pointer

  external view function read() : bytes is
    SSTORE2.read(storage.pointer)

  external payable function deploy3(const code : bytes; const salt : bytes32) : address
    raises FailedDeployment
  is {
    storage.last := Create3.deployDeterministic(code, salt, uint(Evm.value()));
  } with storage.last

  external view function predict3(const salt : bytes32) : address is
    Create3.predictHere(salt)

  external view function last() : address is
    storage.last
}
