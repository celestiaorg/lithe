(* One function form. Decorators classify visibility and effects. *)

import "std/evm";

storage is record {
  count : uint;
  paid : wei;
}

view function doubled(const n : uint) : uint is
  n + n

function stamp(const n : uint) : uint is {
  storage.count := n;
} with storage.count

function bump(const n : uint) is {
  storage.count := storage.count + doubled(n);
}

external view function count() : uint is
  storage.count

external function set(const n : uint) is {
  const _ : uint := stamp(n);
  skip
}

external function add(const n : uint) is {
  bump(n);
}

external payable function deposit() is {
  storage.paid := storage.paid + Evm.value();
}
