(* What capped_token.lithe guarantees. The standard library's own spec file proves that
   the ERC-20 balances add up to the supply. *)

spec is {
  invariant capped is ERC20.erc20.totalSupply <= storage.cap;
}

spec for mint is partial {
  raises NotOwner when Evm.sender() <> old.storage.owner;
  raises OverCap when old.ERC20.erc20.totalSupply + value > old.storage.cap;
  ensures new.ERC20.erc20.totalSupply = old.ERC20.erc20.totalSupply + value;
  ensures new.ERC20.erc20.balances[to] = old.ERC20.erc20.balances[to] + value;
}
