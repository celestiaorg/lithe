(* A token whose owner mints, up to a cap. Its specs, in capped_token.spec.lithe, state
   that the supply never passes the cap, that the balances add up to the supply, and when
   minting fails. *)

import "std/token/erc20.lithe";

contract CappedToken is {
  use ERC20 exposing IERC20;

  error Not_owner;
  error Over_cap of nat;

  storage is record {
    owner : address;
    cap : nat;
  }

  deploy() is {
    storage.owner := Evm.sender();
    storage.cap := 1_000_000n;
    ERC20.init("Capped", "CAP");
  }

  external function mint(const to : address; const value : nat)
    raises Not_owner | Over_cap | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    assert(Evm.sender() = storage.owner, Not_owner);
    const supply : nat := ERC20.erc20.total_supply;
    assert(value <= storage.cap - supply, Over_cap(storage.cap - supply));
    ERC20.mint(to, value);
  }
}
