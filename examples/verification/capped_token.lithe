(* A token whose owner mints, up to a cap. Its specs, in cappedToken.spec.lithe, state
   that the supply never passes the cap, that the balances add up to the supply, and when
   minting fails. *)

import "std/evm";
import "std/token/erc20";
import "std/interfaces/erc20";

contract CappedToken is {
  use ERC20 exposing IERC20;

  hook ERC20.beforeTransfer is skip;
  hook ERC20.afterTransfer is skip;

  error NotOwner;
  error OverCap of uint;

  storage is record {
    owner : address;
    cap : uint;
  }

  deploy() is {
    storage.owner := Evm.sender();
    storage.cap := 1_000_000;
    ERC20.init("Capped", "CAP");
  }

  external function mint(const to : address; const value : uint)
    raises NotOwner | OverCap | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    assert(Evm.sender() = storage.owner, NotOwner);
    const supply : uint := ERC20.erc20.totalSupply;
    assert(value <= storage.cap - supply, OverCap(storage.cap - supply));
    ERC20.mint(to, value);
  }
}
