(* Bitwise operators, truncating division, and positional tuples. *)

storage is record {
  q : uint;
  r : uint;
  sq : int;
  sr : int;
  rem_nat : uint;
  div_int : int;
  rem_int : int;
  masked : uint;
  flags : uint;
  toggled : uint;
  inverted : uint;
  shifted : uint;
  back : uint;
  uq : uint32;
  ur : uint32;
  narrow_shift : uint8;
  narrow_not : uint8;
  sar : int;
  half : uint;
  rest : uint;
  pair_amount : uint;
  nested_flag : bool;
  payment : (address, uint);
}

view function split(const amount : uint) : (uint, uint) is
  (amount / 2, amount % 2)

external function run(const amount : uint) is {
  const (q, r) : (uint, uint) := Uint.div_rem(7, 3);
  storage.q := q;
  storage.r := r;
  const (sq, sr) : (int, int) := Int.div_rem(-7, 3);
  storage.sq := sq;
  storage.sr := sr;
  storage.rem_nat := 7 % 3;
  storage.div_int := -7 / 3;
  storage.rem_int := -7 % 3;
  const masked : uint := 0xff & 0x0f;
  storage.masked := masked;
  const flags : uint := 1 | 2;
  storage.flags := flags;
  const toggled : uint := flags ^ 0xff;
  storage.toggled := toggled;
  const inverted : uint := ~0;
  storage.inverted := inverted;
  const shifted : uint := 1 << 8;
  storage.shifted := shifted;
  const back : uint := 256 >> 8;
  storage.back := back;
  const a : uint32 := 10;
  const b : uint32 := 3;
  const (uq, ur) : (uint32, uint32) := Uint.div_rem(a, b);
  storage.uq := uq;
  storage.ur := ur;
  const narrow_shift : uint8 := 1 << 8;
  storage.narrow_shift := narrow_shift;
  const narrow_not : uint8 := ~0;
  storage.narrow_not := narrow_not;
  const neg : int := -8;
  storage.sar := neg >> 1;
  const (half, rest) : (uint, uint) := split(amount);
  storage.half := half;
  storage.rest := rest;
  const pair : (address, uint) := (Evm.sender(), amount);
  const (who, pair_amount) : (address, uint) := pair;
  storage.pair_amount := pair_amount;
  const nested : (uint, (address, bool)) := (1, (Evm.sender(), true));
  const (_, inner) : (uint, (address, bool)) := nested;
  const (_acct, flag) : (address, bool) := inner;
  storage.nested_flag := flag;
  storage.payment := (who, amount);
}

external function mod_zero(const d : uint) is {
  const _ : uint := 1 % d;
  skip
}

external function min_div(const min : int) is {
  const _ : int := min / -1;
  skip
}

external function min_mod(const min : int) is {
  const _ : int := min % -1;
  skip
}

external view function quote() : (uint, uint) is
  (2, 1)

external view function payee() : (uint, address) is
  (7, Evm.sender())

external view function nested_quote() : (uint, (address, bool)) is
  (1, (Evm.self(), true))

external view function sum_some() : uint is {
  const wrapped : option((uint, uint)) := Some((4, 5));
} with case wrapped of
{
| Some((q, r)) -> q + r
| None -> 0
}

external view function mask_some() : uint is {
  const wrapped : option(uint) := Some(0xff);
} with case wrapped of
{
| Some(n) -> n & 0x0f
| None -> 0
}
