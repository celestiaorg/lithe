(* Bitwise operators, truncating division, and positional tuples. *)

import "std/evm";
import "std/int";
import "std/uint";

storage is record {
  q : uint;
  r : uint;
  sq : int;
  sr : int;
  remNat : uint;
  divInt : int;
  remInt : int;
  masked : uint;
  flags : uint;
  toggled : uint;
  inverted : uint;
  shifted : uint;
  back : uint;
  uq : uint32;
  ur : uint32;
  narrowShift : uint8;
  narrowNot : uint8;
  sar : int;
  half : uint;
  rest : uint;
  pairAmount : uint;
  nestedFlag : bool;
  payment : (address, uint);
}

view function split(const amount : uint) : (uint, uint) is
  (amount / 2, amount % 2)

external function run(const amount : uint) is {
  const (q, r) : (uint, uint) := Uint.divRem(7, 3);
  storage.q := q;
  storage.r := r;
  const (sq, sr) : (int, int) := Int.divRem(-7, 3);
  storage.sq := sq;
  storage.sr := sr;
  storage.remNat := 7 % 3;
  storage.divInt := -7 / 3;
  storage.remInt := -7 % 3;
  const masked : uint := 0xff & 0x0f;
  storage.masked := masked;
  const flags : uint := 1 | 2;
  storage.flags := flags;
  const toggled : uint := flags ^ 0xff;
  storage.toggled := toggled;
  const inverted : uint := ~0;
  storage.inverted := inverted;
  const shifted : uint := 1 << 8;
  storage.shifted := shifted;
  const back : uint := 256 >> 8;
  storage.back := back;
  const a : uint32 := 10;
  const b : uint32 := 3;
  const (uq, ur) : (uint32, uint32) := Uint.divRem(a, b);
  storage.uq := uq;
  storage.ur := ur;
  const narrowShift : uint8 := 1 << 8;
  storage.narrowShift := narrowShift;
  const narrowNot : uint8 := ~0;
  storage.narrowNot := narrowNot;
  const neg : int := -8;
  storage.sar := neg >> 1;
  const (half, rest) : (uint, uint) := split(amount);
  storage.half := half;
  storage.rest := rest;
  const pair : (address, uint) := (Evm.sender(), amount);
  const (who, pairAmount) : (address, uint) := pair;
  storage.pairAmount := pairAmount;
  const nested : (uint, (address, bool)) := (1, (Evm.sender(), true));
  const (_, inner) : (uint, (address, bool)) := nested;
  const (_acct, flag) : (address, bool) := inner;
  storage.nestedFlag := flag;
  storage.payment := (who, amount);
}

external function modZero(const d : uint) is {
  const _ : uint := 1 % d;
  skip
}

external function minDiv(const min : int) is {
  const _ : int := min / -1;
  skip
}

external function minMod(const min : int) is {
  const _ : int := min % -1;
  skip
}

external view function quote() : (uint, uint) is
  (2, 1)

external view function payee() : (uint, address) is
  (7, Evm.sender())

external view function nestedQuote() : (uint, (address, bool)) is
  (1, (Evm.self(), true))

external view function sumSome() : uint is {
  const wrapped : option((uint, uint)) := Some((4, 5));
} with case wrapped of
{
| Some((q, r)) -> q + r
| None -> 0
}

external view function maskSome() : uint is {
  const wrapped : option(uint) := Some(0xff);
} with case wrapped of
{
| Some(n) -> n & 0x0f
| None -> 0
}
