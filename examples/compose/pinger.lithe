(* Calls a ledger through its interface: `ping` is deferred, and `pinged` is read with
   `query`. Any contract that has `ILedger`, such as `Token`, can be passed in. *)

import "./iledger";

contract Pinger is {
  storage is record {
    relayed : uint;
  }

  external function relay(const ledger : ILedger; const n : uint) is {
    storage.relayed := storage.relayed + 1;
    defer ledger.ping(n);
  }

  external view function last(const ledger : ILedger) : uint is
    query ledger.pinged()
}
