(* Parentheses group and call. Brackets list and index. Braces group records, blocks, and case arms. *)

import "std/evm";

error TooSmall of record {
  amount : uint;
}

event Paid of record {
  amount : uint;
}

type Payment is record {
  recipient : address;
  amount : uint;
  expiresAt : timestamp;
}

storage is record {
  paid : uint;
}

type Action is
  | Pay external pay of (n : uint)
  | Stop external stop

external view function firstAdmin() : address is {
  const alice : address := 0x0000000000000000000000000000000000000001;
  const bob : address := 0x0000000000000000000000000000000000000002;
  const carol : address := 0x0000000000000000000000000000000000000003;
  const admins : list(address) := [
    alice,
    bob,
    carol
  ];
  const first : address := admins[0];
} with first

external view function adminCount() : uint is {
  const alice : address := 0x0000000000000000000000000000000000000001;
  const bob : address := 0x0000000000000000000000000000000000000002;
  const admins : list(address) := [alice, bob];
} with admins.length

external view function second() : uint is {
  const nums : list(uint, 3) := [1, 2, 4];
  const n : uint := nums[1];
} with n

external view function owed() : uint is {
  const account : address := Evm.sender();
  const payment : Payment := {
    amount = 9;
    expiresAt = Evm.blockTimestamp();
    recipient = account;
  };
} with payment.amount

external function main(const action : Action)
  raises TooSmall
is
  case action of {
    | Pay(n) -> {
        assert(n > 0, TooSmall { amount = n });
        storage.paid := storage.paid + n;
        emit Paid { amount = n };
      }
    | Stop -> { skip }
  }
