(* Execution context is Evm.*, hashes are Crypto.*, encoding is Abi.*. *)

import "std/abi";
import "std/crypto";
import "std/evm";

interface Target is {
  function foo(amount : uint);
}

storage is record {
  caller : address;
  paid : wei;
  time : timestamp;
  number : uint;
  chain : uint;
  mine : address;
  bal : wei;
  sel : bytes4;
  origin : address;
  price : wei;
  coin : address;
  fee : wei;
  rand : bytes32;
  limit : uint;
  codesz : uint;
  codehash : bytes32;
  bhash : bytes32;
  blob : bytes32;
  gas : uint;
  digest : bytes32;
  sha : bytes32;
  ripe : bytes20;
  round : uint;
  packed : bytes;
  blobFee : wei;
}

external payable function take() is {
  storage.caller := Evm.sender();
  storage.paid := Evm.value();
  storage.time := Evm.blockTimestamp();
  storage.number := Evm.blockNumber();
  storage.chain := Evm.chainId();
  storage.mine := Evm.self();
  storage.bal := Evm.balance(Evm.self());
  storage.sel := Evm.selector();
  storage.origin := Evm.txOrigin();
  storage.price := Evm.txGasPrice();
  storage.coin := Evm.blockCoinbase();
  storage.fee := Evm.blockBaseFee();
  storage.rand := Evm.blockPrevrandao();
  storage.limit := Evm.blockGasLimit();
  storage.codesz := Evm.codeSize(Evm.self());
  storage.codehash := Evm.codeHash(Evm.self());
  storage.bhash := Evm.blockHash(1);
  storage.blob := Evm.blobHash(0);
  storage.blobFee := Evm.blobBaseFee();
  storage.gas := Evm.gasLeft();
  const raw : bytes := 0x616263;
  storage.digest := Crypto.keccak256(raw);
  storage.sha := Crypto.sha256(raw);
  storage.ripe := Crypto.ripemd160(raw);
  const encoded : bytes := Abi.encode(7);
  storage.round := Abi.decode(encoded, uint);
  storage.packed := Abi.encodePacked(Evm.sender());
}

external view function payload() : bytes is
  Evm.calldata()

external view function framed() : bytes is
  Abi.encodeWithSelector(0xaabbccdd, 7)

external view function signed() : bytes is
  Abi.encodeWithSignature("foo(uint256)", 7)

external view function called() : bytes is
  Abi.encodeCall(Target.foo, 7)

external view function recovered() : address is
  Crypto.ecrecover(0x00, 0, 0x00, 0x00)
