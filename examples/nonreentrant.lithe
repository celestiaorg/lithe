(* One lock covers every `nonreentrant` function until deferred calls finish. *)

interface Hook is {
  function cancel();
  function ping();
}

storage is record {
  status : nat;
  pinged : nat;
}

external nonreentrant function settle(const hook : Hook) is {
  storage.status := 1n;
  defer hook.cancel();
}

external nonreentrant function notify(const hook : Hook) is {
  storage.status := 1n;
  defer hook.ping();
}

external nonreentrant function cancel() is {
  storage.pinged := 2n;
}

external function ping() is {
  storage.pinged := 3n;
}
