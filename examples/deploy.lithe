(* `deploy` runs once, in the creation code, on the ABI-encoded arguments appended to it,
   like a Solidity constructor. It can write storage and emit events, but cannot call
   other contracts: the contract has no code until it returns. *)

error Fee_too_high of uint;

storage is record {
  owner : address;
  fee_bps : uint;
  name : string;
}

event Configured of record {
  indexed owner : address;
  fee_bps : uint;
}

deploy(const owner : address; const fee_bps : uint; const name : string)
  raises Fee_too_high
is {
  assert(fee_bps <= 1000, Fee_too_high(fee_bps));
  storage.owner := owner;
  storage.fee_bps := fee_bps;
  storage.name := name;
  emit Configured {
    owner = owner;
    fee_bps = fee_bps;
  };
}

external view function owner() : address is
  storage.owner

external view function fee_bps() : uint is
  storage.fee_bps

external view function name() : string is
  storage.name
