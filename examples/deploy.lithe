(* `deploy` runs once, in the creation code, on the ABI-encoded arguments appended to it,
   like a Solidity constructor. It can write storage and emit events, but cannot call
   other contracts: the contract has no code until it returns. *)

error FeeTooHigh of uint;

storage is record {
  owner : address;
  feeBps : uint;
  name : string;
}

event Configured of record {
  indexed owner : address;
  feeBps : uint;
}

deploy(const owner : address; const feeBps : uint; const name : string)
  raises FeeTooHigh
is {
  assert(feeBps <= 1000, FeeTooHigh(feeBps));
  storage.owner := owner;
  storage.feeBps := feeBps;
  storage.name := name;
  emit Configured {
    owner = owner;
    feeBps = feeBps;
  };
}

external view function owner() : address is
  storage.owner

external view function feeBps() : uint is
  storage.feeBps

external view function name() : string is
  storage.name
