import "std/evm";

error NotOwner;

storage is record {
  count : uint;
  owner : address;
}

type OwnerAction is
  | Reset external reset

type PublicAction is
  | Increment external increment of (n : uint)

type Action is
  | OwnerAction of OwnerAction
  | PublicAction of PublicAction

function ownerMain(const action : OwnerAction)
  raises NotOwner
is {
  assert(Evm.sender() = storage.owner, NotOwner);
}
with case action of
{
| Reset -> {
    storage.count := 0
  }
}

function publicMain(const action : PublicAction) is
  case action of
  {
  | Increment(n) -> {
      storage.count := storage.count + n
    }
  }

external function main(const action : Action)
  raises NotOwner
is
  case action of
  {
  | OwnerAction(a) -> ownerMain(a)
  | PublicAction(a) -> publicMain(a)
  }

external view function getCount() : uint is
  storage.count
