(* Indexed fields are topics. A string or a fixed list is stored as a hash. *)

event Transfer of record {
  indexed from : address;
  indexed to : address;
  amount : uint;
}

event Note of record {
  indexed memo : string;
  amount : uint;
}

event Tagged of record {
  indexed flag : bool;
  indexed ids : list(uint, 2);
  amount : uint;
}

storage is record {
  paid : uint;
}

external function pay(const to : address; const amount : uint) is {
  emit Transfer {
    from = Evm.sender();
    to = to;
    amount = amount;
  };
  emit Note {
    memo = "hi";
    amount = amount;
  };
  emit Tagged {
    flag = true;
    ids = [7, 8];
    amount = amount;
  };
  storage.paid := amount;
}
