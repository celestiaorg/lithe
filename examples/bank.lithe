import "std/evm";

error NotOwner;
error Paused;

error InsufficientBalance of record {
  available : uint;
  required : uint;
}

error InvalidAmount of uint;

errors withdrawalErrors is
  | Paused
  | InvalidAmount
  | InsufficientBalance

storage is record {
  owner : address;
  paused : bool;
  balance : uint;
}

event Withdrawal of record {
  account : address;
  amount : uint;
}

view function requireOwner()
  raises NotOwner
is {
  assert(Evm.sender() = storage.owner, NotOwner);
}

view function requireAmount(const amount : uint) : uint
  raises InvalidAmount
is {
  assert(amount <> 0, InvalidAmount(amount));
} with amount

external function withdraw(const amount : uint)
  raises withdrawalErrors
is {
  assert(not storage.paused, Paused);

  const taken : uint := requireAmount(amount);

  assert(
    storage.balance >= taken,
    InsufficientBalance {
      available = storage.balance;
      required = taken;
    }
  );

  storage.balance := storage.balance - taken;

  emit Withdrawal {
    account = Evm.sender();
    amount = taken;
  };
}

external function setPause(const value : bool)
  raises NotOwner
is {
  requireOwner();
  storage.paused := value;
}
