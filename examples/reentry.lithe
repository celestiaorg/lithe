(* A deferred call can re-enter before later effects run. This program warns. *)

interface Hook is {
  function cancel();
}

storage is record {
  status : uint;
  extra : uint;
}

external function settle(const hook : Hook) is {
  storage.status := 1;
  defer hook.cancel();
}

external function cancel() is {
  storage.extra := 2;
}
