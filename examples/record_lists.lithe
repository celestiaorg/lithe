(* Lists of records through the ABI: Solidity's arrays of structs, as arguments and
   results, in `Abi.encode` and `Abi.decode`, in events and errors, and in calls to other
   contracts. Each element's fields are checked as Solidity's decoder checks them. *)

import "std/abi";
import "std/evm";

type Point is record {
  key : uint48;
  value : uint208;
}

type Tagged is record {
  tag : bytes4;
  ok : bool;
  n : int16;
}

type Points is list(Point);

interface IPoints is {
  view function all() : list(Point);
  function take(xs : list(Point)) : uint;
}

event Pushed of record {
  indexed who : address;
  points : list(Point);
}

error Rejected of list(Point);

storage is record {
  points : list(Point);
  tagged : list(Tagged);
  taken : uint;
}

external function setAll(const xs : list(Point)) is {
  storage.points := xs;
  emit Pushed { who = Evm.sender(); points = xs; };
}

external view function all() : list(Point) is
  storage.points

external function setTags(const xs : list(Tagged)) is {
  storage.tagged := xs;
}

external view function tags() : list(Tagged) is
  storage.tagged

external view function tagAt(const i : uint) : bytes4 is
  storage.tagged[i].tag

external view function encoded() : bytes is
  Abi.encode(storage.points)

external pure function decoded(const data : bytes) : uint is {
  const xs : Points := Abi.decode(data, Points);
} with xs.length * 1000 + uint(xs[0].value)

external view function asked(const other : IPoints) : uint is {
  const xs : list(Point) := query other.all();
} with xs.length

external function take(const xs : list(Point)) : uint is {
  storage.taken := xs.length;
} with xs.length

external function handOver(const other : IPoints) is {
  defer other.take(storage.points);
}

external view function refuse() : uint
  raises Rejected
is {
  fail Rejected(storage.points);
} with 0
