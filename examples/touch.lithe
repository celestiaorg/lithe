(* Record the current time. Only the guard may change storage. *)

import "std/evm";

error NotGuard;

storage is record {
  updated : timestamp;
  guard : address;
}

external function touch()
  raises NotGuard
is {
  assert(Evm.sender() = storage.guard, NotGuard);
  storage.updated := Evm.blockTimestamp();
}

external function setGuard(const who : address)
  raises NotGuard
is {
  assert(Evm.sender() = storage.guard, NotGuard);
  storage.guard := who;
}

external view function updated() : timestamp is
  storage.updated
