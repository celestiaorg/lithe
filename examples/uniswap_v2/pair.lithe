(* Uniswap v2's pair: a constant-product market between two tokens, whose liquidity is
   the standard library's ERC-20 with ERC-2612 permits. The reserves share one slot with
   the time they were last updated, and the price accumulators wrap, as Uniswap's do.
   factory.lithe creates one pair per two tokens.

   Tokens go out before the pair checks what came in, so a swap can lend first: the
   check runs in the continuation of the last call. Each entry point holds the lock until
   its calls and their continuations finish. *)

import "std/address";
import "std/evm";
import "std/uint";
import "std/token/erc20_permit";
import "std/math/math";
import "./interfaces";
import "std/token/erc20";
import "std/crypto/eip712";
import "std/interfaces/erc20";
import "std/crypto/ecdsa";
import "std/utils/nonce";

contract UniswapV2Pair is {
  use EIP712;
  use ECDSA;
  use Nonces;
  use Math;

  use ERC20 exposing IERC20, IERC20Metadata;
  use ERC20Permit exposing IERC20Permit;
  supports IERC20, IERC20Metadata, IERC20Permit;

  hook ERC20.beforeTransfer is skip;
  hook ERC20.afterTransfer is skip;

  (* One slot, written at once. *)
  type Reserves is record {
    reserve0 : uint112;
    reserve1 : uint112;
    blockTimestampLast : uint32;
  }

  storage is record {
    factory : IUniswapV2Factory;
    token0 : Token;
    token1 : Token;
    reserves : Reserves;
    price0CumulativeLast : uint;
    price1CumulativeLast : uint;
    kLast : uint;
  }

  error Forbidden;
  error Overflow;
  error InsufficientLiquidityMinted;
  error InsufficientLiquidityBurned;
  error InsufficientOutputAmount;
  error InsufficientLiquidity;
  error InvalidTo;
  error InsufficientInputAmount;
  error K;
  error TransferFailed;

  event Mint of record {
    indexed sender : address;
    amount0 : uint;
    amount1 : uint;
  }

  event Burn of record {
    indexed sender : address;
    amount0 : uint;
    amount1 : uint;
    indexed to : address;
  }

  event Swap of record {
    indexed sender : address;
    amount0In : uint;
    amount1In : uint;
    amount0Out : uint;
    amount1Out : uint;
    indexed to : address;
  }

  event Sync of record {
    reserve0 : uint112;
    reserve1 : uint112;
  }

  deploy() is {
    ERC20.init("Uniswap V2", "UNI-V2");
    EIP712.init("Uniswap V2", "1");
    storage.factory := IUniswapV2Factory(Evm.sender());
  }

  (* Liquidity locked by the first deposit, so the pool never empties. It goes to an
     address no one holds: the ERC-20 module keeps the zero address for mints and burns. *)
  pure function minimumLiquidity() : uint is
    1000

  pure function locked() : address is
    0x000000000000000000000000000000000000dEaD

  external pure function MINIMUM_LIQUIDITY() : uint is
    minimumLiquidity()

  external view function factory() : IUniswapV2Factory is
    storage.factory

  external view function token0() : Token is
    storage.token0

  external view function token1() : Token is
    storage.token1

  external view function getReserves() : (uint112, uint112, uint32) is
    (storage.reserves.reserve0, storage.reserves.reserve1, storage.reserves.blockTimestampLast)

  external view function price0CumulativeLast() : uint is
    storage.price0CumulativeLast

  external view function price1CumulativeLast() : uint is
    storage.price1CumulativeLast

  external view function kLast() : uint is
    storage.kLast

  external function initialize(const token0 : Token; const token1 : Token)
    raises Forbidden
  is {
    assert(Evm.sender() = address(storage.factory), Forbidden);
    storage.token0 := token0;
    storage.token1 := token1;
  }

  function safeTransfer(const token : Token; const to : address; const value : uint) is {
    defer token.transfer(to, value) then {
      | Ok(ok : option(bool)) -> {
          assert(ok <> Some(false), TransferFailed);
        }
      | Error(_) -> {
          fail TransferFailed;
        }
    };
  }

  (* The reserves become the balances. On the first update in a block, each price, a
     UQ112x112 fixed-point ratio of the reserves, accrues for the time since the last. *)
  function update(const balance0 : uint; const balance1 : uint; const reserve0 : uint112; const reserve1 : uint112)
    raises Overflow
  is {
    const most : uint112 := Uint.max;
    assert(balance0 <= uint(most) and balance1 <= uint(most), Overflow);
    const blockTimestamp : uint32 := uint32(uint(Evm.blockTimestamp()) % 4294967296);
    const timeElapsed : uint32 := Uint.wrappingSub(blockTimestamp, storage.reserves.blockTimestampLast);
    if timeElapsed > 0 and reserve0 <> 0 and reserve1 <> 0 then {
      storage.price0CumulativeLast := Uint.wrappingAdd(
        storage.price0CumulativeLast,
        (uint(reserve1) << 112) / uint(reserve0) * uint(timeElapsed)
      );
      storage.price1CumulativeLast := Uint.wrappingAdd(
        storage.price1CumulativeLast,
        (uint(reserve0) << 112) / uint(reserve1) * uint(timeElapsed)
      );
    }
    storage.reserves := {
      reserve0 = uint112(balance0);
      reserve1 = uint112(balance1);
      blockTimestampLast = blockTimestamp;
    };
    emit Sync { reserve0 = storage.reserves.reserve0; reserve1 = storage.reserves.reserve1; };
  }

  (* With a fee recipient, mints it a sixth of the growth in sqrt(k) since the last
     deposit or withdrawal. Without one, forgets k. *)
  function mintFee(const feeTo : address; const reserve0 : uint112; const reserve1 : uint112) : bool is {
    const feeOn : bool := feeTo <> Address.zero;
    const kLast : uint := storage.kLast;
    if feeOn then {
      if kLast <> 0 then {
        const rootK : uint := Math.sqrt(uint(reserve0) * uint(reserve1));
        const rootKLast : uint := Math.sqrt(kLast);
        if rootK > rootKLast then {
          const liquidity : uint := ERC20.erc20.totalSupply * (rootK - rootKLast)
            / (rootK * 5 + rootKLast);
          if liquidity > 0 then {
            ERC20.mint(feeTo, liquidity);
          }
        }
      }
    } else if kLast <> 0 then {
      storage.kLast := 0;
    }
  } with feeOn

  (* Mints liquidity for what was sent in since the last update. *)
  external nonreentrant function mint(const to : address) : uint
    raises InsufficientLiquidityMinted | Overflow | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    const reserve0 : uint112 := storage.reserves.reserve0;
    const reserve1 : uint112 := storage.reserves.reserve1;
    const balance0 : uint := query storage.token0.balanceOf(Evm.self());
    const balance1 : uint := query storage.token1.balanceOf(Evm.self());
    const amount0 : uint := balance0 - uint(reserve0);
    const amount1 : uint := balance1 - uint(reserve1);
    const feeOn : bool := mintFee(query storage.factory.feeTo(), reserve0, reserve1);
    const totalSupply : uint := ERC20.erc20.totalSupply;
    var liquidity : uint := 0;
    if totalSupply = 0 then {
      liquidity := Math.sqrt(amount0 * amount1) - minimumLiquidity();
      ERC20.mint(locked(), minimumLiquidity());
    } else {
      liquidity := Math.min(amount0 * totalSupply / uint(reserve0), amount1 * totalSupply / uint(reserve1));
    }
    assert(liquidity > 0, InsufficientLiquidityMinted);
    ERC20.mint(to, liquidity);
    update(balance0, balance1, reserve0, reserve1);
    if feeOn then {
      storage.kLast := uint(storage.reserves.reserve0) * uint(storage.reserves.reserve1);
    }
    emit Mint { sender = Evm.sender(); amount0 = amount0; amount1 = amount1; };
  } with liquidity

  (* Burns the liquidity sent in, and sends out its share of each token. *)
  external nonreentrant function burn(const to : address) : (uint, uint)
    raises InsufficientLiquidityBurned | TransferFailed | Overflow | ERC20InvalidSender | ERC20InvalidReceiver
      | ERC20InsufficientBalance
  is {
    const reserve0 : uint112 := storage.reserves.reserve0;
    const reserve1 : uint112 := storage.reserves.reserve1;
    const token0 : Token := storage.token0;
    const token1 : Token := storage.token1;
    const balance0 : uint := query token0.balanceOf(Evm.self());
    const balance1 : uint := query token1.balanceOf(Evm.self());
    const liquidity : uint := ERC20.erc20.balances[Evm.self()];
    const feeOn : bool := mintFee(query storage.factory.feeTo(), reserve0, reserve1);
    const totalSupply : uint := ERC20.erc20.totalSupply;
    const amount0 : uint := liquidity * balance0 / totalSupply;
    const amount1 : uint := liquidity * balance1 / totalSupply;
    assert(amount0 > 0 and amount1 > 0, InsufficientLiquidityBurned);
    ERC20.burn(Evm.self(), liquidity);
    safeTransfer(token0, to, amount0);
    defer token1.transfer(to, amount1) then {
      | Ok(ok : option(bool)) -> {
          assert(ok <> Some(false), TransferFailed);
          update(query token0.balanceOf(Evm.self()), query token1.balanceOf(Evm.self()), reserve0, reserve1);
          if feeOn then {
            storage.kLast := uint(storage.reserves.reserve0) * uint(storage.reserves.reserve1);
          }
          emit Burn { sender = Evm.sender(); amount0 = amount0; amount1 = amount1; to = to; };
        }
      | Error(_) -> {
          fail TransferFailed;
        }
    };
  } with (amount0, amount1)

  (* What came in is what the balances hold beyond the reserves left after the outputs.
     Less a 0.3% fee on it, the balances must keep k. *)
  function settleSwap(
    const balance0 : uint;
    const balance1 : uint;
    const amount0Out : uint;
    const amount1Out : uint;
    const to : address;
    const reserve0 : uint112;
    const reserve1 : uint112
  )
    raises InsufficientInputAmount | K | Overflow
  is {
    const left0 : uint := uint(reserve0) - amount0Out;
    const left1 : uint := uint(reserve1) - amount1Out;
    var amount0In : uint := 0;
    if balance0 > left0 then {
      amount0In := balance0 - left0;
    }
    var amount1In : uint := 0;
    if balance1 > left1 then {
      amount1In := balance1 - left1;
    }
    assert(amount0In > 0 or amount1In > 0, InsufficientInputAmount);
    const adjusted0 : uint := balance0 * 1000 - amount0In * 3;
    const adjusted1 : uint := balance1 * 1000 - amount1In * 3;
    assert(adjusted0 * adjusted1 >= uint(reserve0) * uint(reserve1) * 1000000, K);
    update(balance0, balance1, reserve0, reserve1);
    emit Swap {
      sender = Evm.sender();
      amount0In = amount0In;
      amount1In = amount1In;
      amount0Out = amount0Out;
      amount1Out = amount1Out;
      to = to;
    };
  }

  (* Sends the outputs, then, with data, calls `to` back, which may pay for them there.
     The last of those calls settles. *)
  external nonreentrant function swap(
    const amount0Out : uint;
    const amount1Out : uint;
    const to : address;
    const data : bytes
  )
    raises InsufficientOutputAmount | InsufficientLiquidity | InvalidTo | InsufficientInputAmount | K | TransferFailed
      | Overflow
  is {
    assert(amount0Out > 0 or amount1Out > 0, InsufficientOutputAmount);
    const reserve0 : uint112 := storage.reserves.reserve0;
    const reserve1 : uint112 := storage.reserves.reserve1;
    assert(amount0Out < uint(reserve0) and amount1Out < uint(reserve1), InsufficientLiquidity);
    const token0 : Token := storage.token0;
    const token1 : Token := storage.token1;
    assert(to <> address(token0) and to <> address(token1), InvalidTo);
    if amount0Out > 0 and (amount1Out > 0 or data.length > 0) then {
      safeTransfer(token0, to, amount0Out);
    }
    if data.length > 0 then {
      if amount1Out > 0 then {
        safeTransfer(token1, to, amount1Out);
      }
      defer IUniswapV2Callee(to).uniswapV2Call(Evm.sender(), amount0Out, amount1Out, data) then {
        settleSwap(
          query token0.balanceOf(Evm.self()),
          query token1.balanceOf(Evm.self()),
          amount0Out,
          amount1Out,
          to,
          reserve0,
          reserve1
        );
      };
    } else {
      var last : Token := token0;
      var amount : uint := amount0Out;
      if amount1Out > 0 then {
        last := token1;
        amount := amount1Out;
      }
      defer last.transfer(to, amount) then {
        | Ok(ok : option(bool)) -> {
            assert(ok <> Some(false), TransferFailed);
            settleSwap(
              query token0.balanceOf(Evm.self()),
              query token1.balanceOf(Evm.self()),
              amount0Out,
              amount1Out,
              to,
              reserve0,
              reserve1
            );
          }
        | Error(_) -> {
            fail TransferFailed;
          }
      };
    }
  }

  (* Sends `to` whatever the balances hold beyond the reserves. *)
  external nonreentrant function skim(const to : address)
    raises TransferFailed
  is {
    const token0 : Token := storage.token0;
    const token1 : Token := storage.token1;
    safeTransfer(token0, to, query token0.balanceOf(Evm.self()) - uint(storage.reserves.reserve0));
    safeTransfer(token1, to, query token1.balanceOf(Evm.self()) - uint(storage.reserves.reserve1));
  }

  (* Makes the reserves what the balances hold. *)
  external nonreentrant function sync()
    raises Overflow
  is {
    update(
      query storage.token0.balanceOf(Evm.self()),
      query storage.token1.balanceOf(Evm.self()),
      storage.reserves.reserve0,
      storage.reserves.reserve1
    );
  }
}
