(* Uniswap v2's factory: one pair per two tokens, created with CREATE2 from pair.lithe.
   The salt is the sorted tokens, so anyone can compute a pair's address from its tokens
   and the hash of the pair's creation code, before or after it exists. *)

import "std/abi";
import "std/address";
import "std/crypto";
import "std/evm";
import "std/list";
import "./pair";
import "./interfaces";
import "std/utils/create2";

contract UniswapV2Factory is {
  use Create2;

  storage is record {
    feeTo : address;
    feeToSetter : address;
    pairs : map(address, map(address, address));
    allPairs : list(address);
  }

  error IdenticalAddresses;
  error ZeroAddress;
  error PairExists;
  error Forbidden;

  event PairCreated of record {
    indexed token0 : address;
    indexed token1 : address;
    pair : address;
    length : uint;
  }

  deploy(const feeToSetter : address) is {
    storage.feeToSetter := feeToSetter;
  }

  pure function sorted(const tokenA : address; const tokenB : address) : (address, address)
    raises IdenticalAddresses | ZeroAddress
  is {
    assert(tokenA <> tokenB, IdenticalAddresses);
    var token0 : address := tokenB;
    var token1 : address := tokenA;
    if tokenA < tokenB then {
      token0 := tokenA;
      token1 := tokenB;
    }
    assert(token0 <> Address.zero, ZeroAddress);
  } with (token0, token1)

  pure function salt(const token0 : address; const token1 : address) : bytes32 is
    Crypto.keccak256(Abi.encodePacked(token0, token1))

  (* Where the pair of two sorted tokens is, or will be. *)
  view function sortedPairFor(const token0 : address; const token1 : address) : address is
    Create2.computeAddressHere(salt(token0, token1), Crypto.keccak256(Evm.creationCode(UniswapV2Pair)))

  external view function feeTo() : address is
    storage.feeTo

  external view function feeToSetter() : address is
    storage.feeToSetter

  external view function getPair(const tokenA : address; const tokenB : address) : address is
    storage.pairs[tokenA][tokenB]

  external view function allPairs(const index : uint) : address is
    storage.allPairs[index]

  external view function allPairsLength() : uint is
    storage.allPairs.length

  (* UniswapV2Library's `pairFor`, without the storage read. *)
  external view function pairFor(const tokenA : address; const tokenB : address) : address
    raises IdenticalAddresses | ZeroAddress
  is {
    const (token0, token1) : (address, address) := sorted(tokenA, tokenB);
  } with sortedPairFor(token0, token1)

  external function createPair(const tokenA : address; const tokenB : address) : address
    raises IdenticalAddresses | ZeroAddress | PairExists
  is {
    const (token0, token1) : (address, address) := sorted(tokenA, tokenB);
    assert(storage.pairs[token0][token1] = Address.zero, PairExists);
    const pair : address := sortedPairFor(token0, token1);
    defer create UniswapV2Pair() with salt = salt(token0, token1);
    defer IUniswapV2Pair(pair).initialize(Token(token0), Token(token1));
    storage.pairs[token0][token1] := pair;
    storage.pairs[token1][token0] := pair;
    List.push(storage.allPairs, pair);
    emit PairCreated {
      token0 = token0;
      token1 = token1;
      pair = pair;
      length = storage.allPairs.length;
    };
  } with pair

  external function setFeeTo(const feeTo : address)
    raises Forbidden
  is {
    assert(Evm.sender() = storage.feeToSetter, Forbidden);
    storage.feeTo := feeTo;
  }

  external function setFeeToSetter(const feeToSetter : address)
    raises Forbidden
  is {
    assert(Evm.sender() = storage.feeToSetter, Forbidden);
    storage.feeToSetter := feeToSetter;
  }
}
