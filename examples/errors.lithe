(* Error payloads can hold strings, bytes, and lists. They revert ABI-encoded, as
   Solidity's custom errors do: AttributeNotFound(uint256,string,uint256[]). *)

type trait is string;

error Unknown_trait of trait;
error Attribute_not_found of record {
  tokenId : nat;
  traitType : string;
  known : list(nat);
}

storage is record {
  minted : nat;
}

external view function attribute(const token_id : nat; const trait_type : trait) : nat
  raises Unknown_trait | Attribute_not_found
is {
  if token_id = 0n then {
    fail Unknown_trait(trait_type);
  }
  if token_id > storage.minted then {
    fail Attribute_not_found { tokenId = token_id; traitType = "Background"; known = [7n]; };
  }
} with token_id
