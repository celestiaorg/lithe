(* Error payloads can hold strings, bytes, and lists. They revert ABI-encoded, as
   Solidity's custom errors do: AttributeNotFound(uint256,string,uint256[]). *)

type Trait is string;

error UnknownTrait of Trait;
error AttributeNotFound of record {
  tokenId : uint;
  traitType : string;
  known : list(uint);
}

storage is record {
  minted : uint;
}

external view function attribute(const tokenId : uint; const traitType : Trait) : uint
  raises UnknownTrait | AttributeNotFound
is {
  if tokenId = 0 then {
    fail UnknownTrait(traitType);
  }
  if tokenId > storage.minted then {
    fail AttributeNotFound { tokenId = tokenId; traitType = "Background"; known = [7]; };
  }
} with tokenId
