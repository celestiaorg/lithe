(* UUPS upgrade. The migration runs once, inside upgradeToAndCall. *)

import "std/evm";

upgradeable

error NotOwner;

storage is record {
  owner : address;
}

upgrade guard is {
  assert(Evm.sender() = storage.owner, NotOwner);
}

storage settings at "vault.settings" is record {
  fee : uint;
  paused : bool;
}

migrate init(const fee : uint) is {
  settings.fee := fee;
}

migrate setPaused(const paused : bool) is {
  settings.paused := paused;
}

external function claim() is {
  storage.owner := Evm.sender();
}
