(* UUPS upgrade. The migration runs once, inside upgradeToAndCall. *)

upgradeable

error Not_owner;

storage is record {
  owner : address;
}

upgrade guard is {
  assert(Evm.sender() = storage.owner, Not_owner);
}

storage settings at "vault.settings" is record {
  fee : nat;
  paused : bool;
}

migrate init(const fee : nat) is {
  settings.fee := fee;
}

migrate set_paused(const paused : bool) is {
  settings.paused := paused;
}

external function claim() is {
  storage.owner := Evm.sender();
}
