(* `Abi.encode` and `Abi.decode` on their own. Encoding takes any ABI values, each one
   argument; decoding takes a type's name for one value, or a tuple of names for several,
   as Solidity's `abi.decode(data, (A, B))` does. Malformed data reverts. *)

import "std/abi";
import "std/crypto";

type Order is record {
  id : uint;
  note : string;
  legs : list(uint);
}

type Orders is list(Order);
type Grid is list(list(uint));

type Transfer is record {
  to : address;
  amount : uint;
  memo : string;
}

storage is record {
  n : uint;
}

(* Several values, and back. *)
external pure function packTransfer(const to : address; const amount : uint; const memo : string) : bytes is
  Abi.encode(to, amount, memo)

external pure function unpackTransfer(const data : bytes) : Transfer is {
  const (to, amount, memo) : (address, uint, string) := Abi.decode(data, (address, uint, string));
} with { to = to; amount = amount; memo = memo; }

(* A record is one tuple, as a Solidity struct is. *)
external pure function packOrder(const id : uint; const note : string) : bytes is {
  const o : Order := { id = id; note = note; legs = [id, id * 2]; };
} with Abi.encode(o)

(* Nested values, and back. *)
external pure function roundOrders(const os : list(Order)) : list(Order) is
  Abi.decode(Abi.encode(os), Orders)

external pure function roundGrid(const g : list(list(uint))) : list(list(uint)) is
  Abi.decode(Abi.encode(g), Grid)

(* A decoded value works as any other: here, the second leg of the first order. *)
external pure function firstSecondLeg(const data : bytes) : uint is {
  const os : list(Order) := Abi.decode(data, Orders);
} with os[0].legs[1]

(* Packed, as `abi.encodePacked`: each value in its own width, no offsets or lengths. *)
external pure function key(const who : address; const nonce : uint96) : bytes32 is
  Crypto.keccak256(Abi.encodePacked(who, nonce))
