(* `Abi.encode` and `Abi.decode` on their own. Encoding takes any ABI values, each one
   argument; decoding takes a type's name for one value, or a tuple of names for several,
   as Solidity's `abi.decode(data, (A, B))` does. Malformed data reverts. *)

type order is record {
  id : nat;
  note : string;
  legs : list(nat);
}

type orders is list(order);
type grid is list(list(nat));

type transfer is record {
  to : address;
  amount : nat;
  memo : string;
}

storage is record {
  n : nat;
}

(* Several values, and back. *)
external pure function pack_transfer(const to : address; const amount : nat; const memo : string) : bytes is
  Abi.encode(to, amount, memo)

external pure function unpack_transfer(const data : bytes) : transfer is {
  const (to, amount, memo) : (address, nat, string) := Abi.decode(data, (address, nat, string));
} with { to = to; amount = amount; memo = memo; }

(* A record is one tuple, as a Solidity struct is. *)
external pure function pack_order(const id : nat; const note : string) : bytes is {
  const o : order := { id = id; note = note; legs = [id, id * 2n]; };
} with Abi.encode(o)

(* Nested values, and back. *)
external pure function round_orders(const os : list(order)) : list(order) is
  Abi.decode(Abi.encode(os), orders)

external pure function round_grid(const g : list(list(nat))) : list(list(nat)) is
  Abi.decode(Abi.encode(g), grid)

(* A decoded value works as any other: here, the second leg of the first order. *)
external pure function first_second_leg(const data : bytes) : nat is {
  const os : list(order) := Abi.decode(data, orders);
} with os[0].legs[1]

(* Packed, as `abi.encodePacked`: each value in its own width, no offsets or lengths. *)
external pure function key(const who : address; const nonce : uint96) : bytes32 is
  Crypto.keccak256(Abi.encode_packed(who, nonce))
