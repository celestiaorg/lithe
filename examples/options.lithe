(* Options in every position: locals, vars, tuples, records, payloads, results, and comparisons. *)

import "std/evm";

type Point is record {
  x : uint;
  y : uint;
}

type Slot is record {
  held : option(uint);
  small : option(uint8);
  n : uint;
}

storage is record {
  pos : option(Point);
  deep : option(option(uint));
  deep8 : option(option(uint8));
  pair : (option(uint), option(address));
  last : option(uint);
  flag : bool;
}

pure function bump(const o : option(uint)) : option(uint) is
  case o of { Some(v) -> Some(v + 1) | None -> None }

pure function orZero(const o : option(uint)) : uint is
  case o of { Some(v) -> v | None -> 0 }

pure function firstSome(const a : option(uint); const b : option(uint)) : option(uint) is
  case a of { Some(v) -> Some(v) | None -> b }

pure function split(const k : uint) : (option(uint), uint) is
  (Some(k * 2), k)

external function pick(const k : uint) is {
  var o : option(uint) := None;
  var s : option(uint8) := None;
  if k > 1 then {
    o := Some(k);
    s := Some(uint8(7));
  } else {
    skip
  }
  storage.last := bump(o);
  storage.flag := case s of { Some(_) -> true | None -> false };
}

external view function lastOr() : uint is orZero(storage.last)

external view function viaCase(const k : uint) : uint is
  case bump(Some(k)) of { Some(v) -> v | None -> 0 }

external view function directArgs(const k : uint) : uint is
  orZero(firstSome(None, Some(k))) + orZero(firstSome(Some(1), None))

external view function eqs(const k : uint) : uint is {
  const a : option(uint) := Some(k);
  const b : option(uint) := None;
  var score : uint := 0;
  if a = Some(5) then { score := score + 1; } else { skip }
  if b = None then { score := score + 10; } else { skip }
  if a <> None then { score := score + 100; } else { skip }
  if bump(a) = bump(Some(k)) then { score := score + 1000; } else { skip }
  if bump(Some(1)) = bump(Some(2)) then { score := score + 10000; } else { skip }
  if Some(uint8(3)) = Some(uint8(3)) then { score := score + 100000; } else { skip }
} with score

external view function inferred(const k : uint) : uint is
  case Some(k) of { Some(v) -> v + 1 | None -> 0 }

external view function tuples(const k : uint) : uint is {
  const (o, n) : (option(uint), uint) := split(k);
  const t : (option(uint8), option(uint), uint) := (Some(uint8(2)), None, 3);
  const (p, q, r) : (option(uint8), option(uint), uint) := t;
} with orZero(o) + n + (case p of { Some(v) -> uint(v) | None -> 0 }) + orZero(q) + r

external view function records(const k : uint) : uint is {
  const s : Slot := { held = Some(k); small = None; n = 4; };
} with (case s.held of { Some(v) -> v | None -> 0 }) + (case s.small of { Some(_) -> 1000 | None -> 0 }) + s.n

external function setPos(const x : uint; const y : uint) is {
  storage.pos := Some({ x = x; y = y; });
}
external view function posSum() : uint is
  case storage.pos of { Some(p) -> p.x + p.y | None -> 0 }

external function setDeep(const k : uint) is {
  storage.deep := Some(Some(k));
  storage.deep8 := Some(None);
}
external view function deepOr() : uint is
  case storage.deep of { Some(inner) -> (case inner of { Some(v) -> v | None -> 1 }) | None -> 2 }
external view function deep8Or() : uint is
  case storage.deep8 of { Some(inner) -> (case inner of { Some(v) -> uint(v) | None -> 1 }) | None -> 2 }

external function setPair(const k : uint) is {
  storage.pair := (Some(k), Some(Evm.sender()));
}
external view function pairOr() : uint is {
  const (a, b) : (option(uint), option(address)) := storage.pair;
} with orZero(a) + (case b of { Some(_) -> 1000 | None -> 0 })
