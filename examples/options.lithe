(* Options in every position: locals, vars, tuples, records, payloads, results, and comparisons. *)

type point is record {
  x : nat;
  y : nat;
}

type slot is record {
  held : option(nat);
  small : option(uint8);
  n : nat;
}

storage is record {
  pos : option(point);
  deep : option(option(nat));
  deep8 : option(option(uint8));
  pair : (option(nat), option(address));
  last : option(nat);
  flag : bool;
}

pure function bump(const o : option(nat)) : option(nat) is
  case o of { Some(v) -> Some(v + 1) | None -> None }

pure function or_zero(const o : option(nat)) : nat is
  case o of { Some(v) -> v | None -> 0 }

pure function first_some(const a : option(nat); const b : option(nat)) : option(nat) is
  case a of { Some(v) -> Some(v) | None -> b }

pure function split(const k : nat) : (option(nat), nat) is
  (Some(k * 2), k)

external function pick(const k : nat) is {
  var o : option(nat) := None;
  var s : option(uint8) := None;
  if k > 1 then {
    o := Some(k);
    s := Some(uint8(7));
  } else {
    skip
  }
  storage.last := bump(o);
  storage.flag := case s of { Some(_) -> true | None -> false };
}

external view function last_or() : nat is or_zero(storage.last)

external view function via_case(const k : nat) : nat is
  case bump(Some(k)) of { Some(v) -> v | None -> 0 }

external view function direct_args(const k : nat) : nat is
  or_zero(first_some(None, Some(k))) + or_zero(first_some(Some(1n), None))

external view function eqs(const k : nat) : nat is {
  const a : option(nat) := Some(k);
  const b : option(nat) := None;
  var score : nat := 0;
  if a = Some(5n) then { score := score + 1; } else { skip }
  if b = None then { score := score + 10; } else { skip }
  if a <> None then { score := score + 100; } else { skip }
  if bump(a) = bump(Some(k)) then { score := score + 1000; } else { skip }
  if bump(Some(1n)) = bump(Some(2n)) then { score := score + 10000; } else { skip }
  if Some(uint8(3)) = Some(uint8(3)) then { score := score + 100000; } else { skip }
} with score

external view function inferred(const k : nat) : nat is
  case Some(k) of { Some(v) -> v + 1 | None -> 0 }

external view function tuples(const k : nat) : nat is {
  const (o, n) : (option(nat), nat) := split(k);
  const t : (option(uint8), option(nat), nat) := (Some(uint8(2)), None, 3n);
  const (p, q, r) : (option(uint8), option(nat), nat) := t;
} with or_zero(o) + n + (case p of { Some(v) -> nat(v) | None -> 0 }) + or_zero(q) + r

external view function records(const k : nat) : nat is {
  const s : slot := { held = Some(k); small = None; n = 4n; };
} with (case s.held of { Some(v) -> v | None -> 0 }) + (case s.small of { Some(_) -> 1000 | None -> 0 }) + s.n

external function set_pos(const x : nat; const y : nat) is {
  storage.pos := Some({ x = x; y = y; });
}
external view function pos_sum() : nat is
  case storage.pos of { Some(p) -> p.x + p.y | None -> 0 }

external function set_deep(const k : nat) is {
  storage.deep := Some(Some(k));
  storage.deep8 := Some(None);
}
external view function deep_or() : nat is
  case storage.deep of { Some(inner) -> (case inner of { Some(v) -> v | None -> 1 }) | None -> 2 }
external view function deep8_or() : nat is
  case storage.deep8 of { Some(inner) -> (case inner of { Some(v) -> nat(v) | None -> 1 }) | None -> 2 }

external function set_pair(const k : nat) is {
  storage.pair := (Some(k), Some(Evm.sender()));
}
external view function pair_or() : nat is {
  const (a, b) : (option(nat), option(address)) := storage.pair;
} with or_zero(a) + (case b of { Some(_) -> 1000 | None -> 0 })
