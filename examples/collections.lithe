(* Maps, dynamic lists, fixed lists, and options in storage. *)

storage is record {
  balances : map(address, uint);
  echo : uint;
  ids : list(address);
  slots : list(uint, 4);
  admin : option(address);
}

external function deposit(const amount : uint) is {
  const prev : uint := storage.balances[Evm.sender()];
  storage.balances[Evm.sender()] := prev + amount;
  const stored : uint := storage.balances[Evm.sender()];
  storage.echo := stored;
}

external function note() is {
  List.push(storage.ids, Evm.sender());
}

external view function first() : address is
  storage.ids[0]

external function fill() is {
  storage.slots[1] := 7;
}

external view function slot1() : uint is
  storage.slots[1]

external function appoint() is {
  storage.admin := Some(Evm.sender());
}

external view function admin_or_sender() : address is
  case storage.admin of
  {
  | Some(who) -> who
  | None -> Evm.sender()
  }

external function miss() is {
  storage.slots[4] := 1;
}

external view function context() : uint is
  Evm.block_number() + Evm.chain_id()
