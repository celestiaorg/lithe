(* Maps, dynamic lists, fixed lists, and options in storage. *)

storage is record {
  balances : map(address, nat);
  echo : nat;
  ids : list(address);
  slots : list(nat, 4);
  admin : option(address);
}

external function deposit(const amount : nat) is {
  const prev : nat := storage.balances[Evm.sender()];
  storage.balances[Evm.sender()] := prev + amount;
  const stored : nat := storage.balances[Evm.sender()];
  storage.echo := stored;
}

external function note() is {
  storage.ids[0n] := Evm.sender();
}

external view function first() : address is
  storage.ids[0n]

external function fill() is {
  storage.slots[1n] := 7n;
}

external view function slot1() : nat is
  storage.slots[1n]

external function appoint() is {
  storage.admin := Some(Evm.sender());
}

external view function admin_or_sender() : address is
  case storage.admin of
  {
  | Some(who) -> who
  | None -> Evm.sender()
  }

external function miss() is {
  storage.slots[4n] := 1n;
}

external view function context() : nat is
  Evm.block_number() + Evm.chain_id()
