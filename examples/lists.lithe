storage is record {
  saved : list(nat);
  tags : list(bytes4);
}

event Batch of record {
  indexed who : address;
  ids : list(nat);
}

external function save(const xs : list(nat)) is {
  storage.saved := xs;
}

external view function saved() : list(nat) is
  storage.saved

external pure function first(const xs : list(nat)) : nat is
  xs[0]

external pure function count(const xs : list(address)) : nat is
  xs.length

external pure function echo(const xs : list(bytes4)) : list(bytes4) is
  xs

external pure function build(const a : nat; const b : nat) : list(nat) is {
  var out : list(nat) := [a];
  out[1n] := b;
  out[0n] := a + b;
} with out

external function log_batch(const ids : list(nat)) is {
  emit Batch { who = Evm.sender(); ids = ids; };
}

external pure function same(const a : list(nat); const b : list(nat)) : bool is
  a = b

external pure function enc(const xs : list(nat)) : bytes is
  Abi.encode(xs)

pure function add_first_two(const xs : list(nat)) : nat is
  xs[0] + xs[1]

external pure function sum2(const xs : list(nat)) : nat is
  add_first_two(xs)
