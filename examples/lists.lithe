import "std/abi";
import "std/evm";
import "std/list";

storage is record {
  saved : list(uint);
  tags : list(bytes4);
}

event Batch of record {
  indexed who : address;
  ids : list(uint);
}

external function save(const xs : list(uint)) is {
  storage.saved := xs;
}

external view function saved() : list(uint) is
  storage.saved

external pure function first(const xs : list(uint)) : uint is
  xs[0]

external pure function count(const xs : list(address)) : uint is
  xs.length

external pure function echo(const xs : list(bytes4)) : list(bytes4) is
  xs

external pure function build(const a : uint; const b : uint) : list(uint) is {
  var out : list(uint) := [a];
  List.push(out, b);
  out[0] := a + b;
} with out

external function logBatch(const ids : list(uint)) is {
  emit Batch { who = Evm.sender(); ids = ids; };
}

external pure function same(const a : list(uint); const b : list(uint)) : bool is
  a = b

external pure function enc(const xs : list(uint)) : bytes is
  Abi.encode(xs)

pure function addFirstTwo(const xs : list(uint)) : uint is
  xs[0] + xs[1]

external pure function sum2(const xs : list(uint)) : uint is
  addFirstTwo(xs)
