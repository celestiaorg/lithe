(* View helpers that only change their own locals stay views. *)

interface Oracle is {
  view function price(asset : address) : nat;
}

storage is record {
  xs : map(nat, address);
  n : nat;
  oracle : Oracle;
}

view function all() : list(address) is {
  var out : list(address) := [];
  for i : nat in 0n .. storage.n bound 16 do {
    out[i] := storage.xs[i];
  }
} with out

view function price(const asset : address) : nat is {
  var p : nat := 0n;
  case query storage.oracle.price(asset) of {
  | Ok(v) -> { p := v; }
  | Error(reason) -> { fail reason; }
  };
} with p

external view function listed() : list(address) is all()

external view function price_of(const asset : address) : nat is price(asset)
