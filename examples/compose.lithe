(* Modules compose by name. Each module owns the storage it declares, and declares the
   external functions a contract may expose. *)

module Ledger is {
  storage ledger at "lithe.ledger" is record {
    balances : map(address, uint);
  }

  error Insufficient_balance of record {
    available : uint;
    required : uint;
  }

  event Transfer of record {
    indexed from : address;
    indexed to : address;
    amount : uint;
  }

  external view function balance_of(const account : address) : uint is
    ledger.balances[account]

  external function mint(const account : address; const amount : uint) is {
    ledger.balances[account] := ledger.balances[account] + amount;
  }

  function transfer(const to : address; const amount : uint)
    raises Insufficient_balance
  is {
    const sender : address := Evm.sender();
    const balance : uint := ledger.balances[sender];
    assert(
      balance >= amount,
      Insufficient_balance {
        available = balance;
        required = amount;
      }
    );
    ledger.balances[sender] := balance - amount;
    ledger.balances[to] := ledger.balances[to] + amount;
    emit Transfer {
      from = sender;
      to = to;
      amount = amount;
    };
  }

  external function transfer(const to : address; const amount : uint)
    raises Insufficient_balance
  is
    transfer(to, amount)
}

module Pausable is {
  storage settings at "lithe.settings" is record {
    paused : bool;
  }

  error Paused;

  external view function is_paused() : bool is
    settings.paused

  external function pause() is {
    settings.paused := true;
  }

  function require_unpaused()
    raises Paused
  is {
    assert(not settings.paused, Paused);
  }
}

module Guarded is {
  requires Ledger;
  requires Pausable;

  function transfer(const to : address; const amount : uint)
    raises Paused | Insufficient_balance
  is {
    Pausable.require_unpaused();
    Ledger.transfer(to, amount);
  }
}

contract Token is {
  use Guarded;

  use Ledger exposing {
    view function balance_of(account : address) : uint;
    function mint(account : address; amount : uint);
    function transfer(to : address; amount : uint)
      raises Insufficient_balance;
  }

  use Pausable exposing {
    view function is_paused() : bool;
    function pause();
  }

  external view function flag() : bool is
    Pausable.settings.paused

  external function guarded_transfer(const to : address; const amount : uint)
    raises Paused | Insufficient_balance
  is {
    Pausable.require_unpaused();
    Ledger.transfer(to, amount);
  }

  external function safe_transfer(const to : address; const amount : uint)
    raises Paused | Insufficient_balance
  is {
    Guarded.transfer(to, amount);
  }
}
