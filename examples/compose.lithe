(* Modules compose by name. Each module owns the storage it declares, and declares the
   external functions a contract may expose. *)

import "std/evm";

module Ledger is {
  storage ledger at "lithe.ledger" is record {
    balances : map(address, uint);
  }

  error InsufficientBalance of record {
    available : uint;
    required : uint;
  }

  event Transfer of record {
    indexed from : address;
    indexed to : address;
    amount : uint;
  }

  external view function balanceOf(const account : address) : uint is
    storage.ledger.balances[account]

  external function mint(const account : address; const amount : uint) is {
    storage.ledger.balances[account] += amount;
  }

  (* Moves the caller's tokens, for the contract's own entrypoints. *)
  function send(const to : address; const amount : uint)
    raises InsufficientBalance
  is {
    const sender : address := Evm.sender();
    const balance : uint := storage.ledger.balances[sender];
    assert(
      balance >= amount,
      InsufficientBalance {
        available = balance;
        required = amount;
      }
    );
    storage.ledger.balances[sender] := balance - amount;
    storage.ledger.balances[to] += amount;
    emit Transfer {
      from = sender;
      to = to;
      amount = amount;
    };
  }

  external function transfer(const to : address; const amount : uint)
    raises InsufficientBalance
  is
    send(to, amount)
}

module Pausable is {
  storage settings at "lithe.settings" is record {
    paused : bool;
  }

  error Paused;

  external view function isPaused() : bool is
    storage.settings.paused

  external function pause() is {
    storage.settings.paused := true;
  }

  function requireUnpaused()
    raises Paused
  is {
    assert(not storage.settings.paused, Paused);
  }
}

module Guarded is {
  requires Ledger, Pausable;

  function transfer(const to : address; const amount : uint)
    raises Paused | InsufficientBalance
  is {
    Pausable.requireUnpaused();
    Ledger.send(to, amount);
  }
}

contract Token is {
  use Ledger exposing {
    view function balanceOf(account : address) : uint;
    function mint(account : address; amount : uint);
    function transfer(to : address; amount : uint)
      raises InsufficientBalance;
  }

  use Pausable exposing {
    view function isPaused() : bool;
    function pause();
  }

  external view function flag() : bool is
    Pausable.storage.settings.paused

  external function guardedTransfer(const to : address; const amount : uint)
    raises Paused | InsufficientBalance
  is {
    Pausable.requireUnpaused();
    Ledger.send(to, amount);
  }

  external function safeTransfer(const to : address; const amount : uint)
    raises Paused | InsufficientBalance
  is {
    Guarded.transfer(to, amount);
  }
}
