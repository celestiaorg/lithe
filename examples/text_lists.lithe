(* Lists of strings and bytes, laid out as Solidity's `string[]` and `bytes[]`: in
   arguments and results, in storage, in maps, in events, and encoded. *)

type notes is list(string);

storage is record {
  notes : list(string);
  by_id : map(nat, string);
}

event Noted of record {
  indexed who : address;
  notes : list(string);
}

external function set_notes(const xs : list(string)) is {
  storage.notes := xs;
  emit Noted { who = Evm.sender(); notes = xs; };
}

external function add_note(const x : string) is {
  storage.notes[storage.notes.length] := x;
}

external view function notes() : list(string) is
  storage.notes

external view function note_at(const i : nat) : string is
  storage.notes[i]

external function name(const id : nat; const v : string) is {
  storage.by_id[id] := v;
}

external view function name_of(const id : nat) : string is
  storage.by_id[id]

external pure function joined(const xs : list(bytes)) : bytes is {
  var out : bytes := "";
  for x : bytes in xs do {
    out := Bytes.concat(out, x);
  }
} with out

external pure function pair(const a : string; const b : string) : list(string) is
  [a, b]

external pure function same(const a : list(bytes); const b : list(bytes)) : bool is
  a = b

external pure function round_trip(const xs : list(string)) : list(string) is
  Abi.decode(Abi.encode(xs), notes)
