(* Lists of strings and bytes, laid out as Solidity's `string[]` and `bytes[]`: in
   arguments and results, in storage, in maps, in events, and encoded. *)

import "std/abi";
import "std/bytes";
import "std/evm";
import "std/list";

type Notes is list(string);

storage is record {
  notes : list(string);
  byId : map(uint, string);
}

event Noted of record {
  indexed who : address;
  notes : list(string);
}

external function setNotes(const xs : list(string)) is {
  storage.notes := xs;
  emit Noted { who = Evm.sender(); notes = xs; };
}

external function addNote(const x : string) is {
  List.push(storage.notes, x);
}

external view function notes() : list(string) is
  storage.notes

external view function noteAt(const i : uint) : string is
  storage.notes[i]

external function name(const id : uint; const v : string) is {
  storage.byId[id] := v;
}

external view function nameOf(const id : uint) : string is
  storage.byId[id]

external pure function joined(const xs : list(bytes)) : bytes is {
  var out : bytes := "";
  for x : bytes in xs do {
    out := Bytes.concat(out, x);
  }
} with out

external pure function pair(const a : string; const b : string) : list(string) is
  [a, b]

external pure function same(const a : list(bytes); const b : list(bytes)) : bool is
  a = b

external pure function roundTrip(const xs : list(string)) : list(string) is
  Abi.decode(Abi.encode(xs), Notes)
