(* Lists and strings through other contracts: as query arguments and answers, as deferred
   call arguments and results, and decoded from bytes. *)

import "std/abi";
import "std/list";

interface Echo is {
  view function same(xs : list(uint)) : list(uint);
  view function named(s : string) : string;
  function keep(xs : list(address)) : list(address);
}

type nums is list(uint);

storage is record {
  got : list(uint);
  kept : list(address);
  label : string;
  total : uint;
}

external function ask(const e : Echo; const xs : list(uint)) is {
  const back : list(uint) := query e.same(xs);
  storage.got := back;
}

external function ask_name(const e : Echo; const s : string) is {
  storage.label := query e.named(s);
}

external function send(const e : Echo; const xs : list(address)) is {
  defer e.keep(xs) then (back : list(address)) {
    storage.kept := back;
  };
}

external function ask_case(const e : Echo; const xs : list(uint)) is {
  case query e.same(xs) of {
    | Ok(back) -> {
        storage.total := back.length;
      }
    | Error(_) -> {
        storage.total := 99;
      }
  }
}

external pure function decoded_length(const data : bytes) : uint is {
  const xs : nums := Abi.decode(data, nums);
} with xs.length

external function counted(const n : uint) : list(uint) is {
  var out : list(uint) := [];
  List.push(out, n);
  List.push(out, n + 1);
} with out

external view function got() : list(uint) is
  storage.got

external view function kept() : list(address) is
  storage.kept

external view function label() : string is
  storage.label

external view function total() : uint is
  storage.total
