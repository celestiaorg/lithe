(* In an upgradeable contract, `deploy` is the proxy's initializer. The proxy's constructor
   calls it, as OpenZeppelin's `ERC1967Proxy(implementation, data)` does with `data`, so it
   runs against the proxy's storage. It runs only while the proxy has no code yet: once
   the proxy is deployed, or on the implementation itself, it reverts. *)

upgradeable

error Not_owner;

storage is record {
  owner : address;
  cap : uint;
}

upgrade guard is {
  assert(Evm.sender() = storage.owner, Not_owner);
}

deploy(const owner : address; const cap : uint) is {
  storage.owner := owner;
  storage.cap := cap;
}

external view function owner() : address is
  storage.owner

external view function cap() : uint is
  storage.cap
