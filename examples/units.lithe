(* Value and time units. A duration added to Evm.blockTimestamp() is a timestamp. *)

import "std/evm";

storage is record {
  price : wei;
  wait : uint;
  unlockAt : timestamp;
  elapsed : uint;
}

external function set() is {
  storage.price := 20gwei + 1wei;
  storage.wait := 1hours + 30minutes + 15seconds;
  storage.unlockAt := Evm.blockTimestamp() + 2days;
  storage.elapsed := storage.unlockAt - Evm.blockTimestamp();
}
