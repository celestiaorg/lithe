(* Counter. Owner and public actions share one dispatcher and become separate ABI entrypoints. *)

import "std/evm";

error Invalid_owner_access;

storage is record {
  count : uint;
  owner : address;
}

event Count_changed of record {
  old_count : uint;
  new_count : uint;
}

type owner_action is
  | Reset

type public_action is
  | Increment of (n : uint)

type action is
  | Owner_action of owner_action
  | Public_action of public_action

function add(const n : uint) is {
  if n > 0 then {
    const old_count : uint := storage.count;

    storage.count := storage.count + n;

    emit Count_changed {
      old_count = old_count;
      new_count = storage.count;
    };
  }
}

function owner_main(const action : owner_action)
  raises Invalid_owner_access
is {
  assert(Evm.sender() = storage.owner, Invalid_owner_access);
}
with case action of
{
| Reset -> {
    const old_count : uint := storage.count;

    storage.count := 0;

    emit Count_changed {
      old_count = old_count;
      new_count = 0;
    };
  }
}

function public_main(const action : public_action) is
  case action of
  {
  | Increment(n) -> add(n)
  }

external function main(const action : action)
  raises Invalid_owner_access
is
  case action of
  {
  | Owner_action(a) -> owner_main(a)
  | Public_action(a) -> public_main(a)
  }

external view function get_count() : uint is
  storage.count
