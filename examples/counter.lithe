(* Counter. Owner and public actions share one dispatcher and become separate ABI entrypoints. *)

import "std/evm";

error InvalidOwnerAccess;

storage is record {
  count : uint;
  owner : address;
}

event CountChanged of record {
  oldCount : uint;
  newCount : uint;
}

type OwnerAction is
  | Reset external reset

type PublicAction is
  | Increment external increment of (n : uint)

type Action is
  | OwnerAction of OwnerAction
  | PublicAction of PublicAction

function add(const n : uint) is {
  if n > 0 then {
    const oldCount : uint := storage.count;

    storage.count += n;

    emit CountChanged {
      oldCount = oldCount;
      newCount = storage.count;
    };
  }
}

function ownerMain(const action : OwnerAction)
  raises InvalidOwnerAccess
is {
  assert(Evm.sender() = storage.owner, InvalidOwnerAccess);
}
with case action of
{
| Reset -> {
    const oldCount : uint := storage.count;

    storage.count := 0;

    emit CountChanged {
      oldCount = oldCount;
      newCount = 0;
    };
  }
}

function publicMain(const action : PublicAction) is
  case action of
  {
  | Increment(n) -> add(n)
  }

external function main(const action : Action)
  raises InvalidOwnerAccess
is
  case action of
  {
  | OwnerAction(a) -> ownerMain(a)
  | PublicAction(a) -> publicMain(a)
  }

external view function getCount() : uint is
  storage.count
