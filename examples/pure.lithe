(* A pure function depends only on its arguments. *)

storage is record {
  rate : uint;
}

pure function calculateFee(const amount : uint; const feeBps : uint) : uint is
  amount * feeBps / 10_000

pure function feeOf(const amount : uint) : uint is
  calculateFee(amount, 25)

external view function preview(const amount : uint) : uint is
  feeOf(amount)

external function quote(const amount : uint) is {
  storage.rate := feeOf(amount);
}
