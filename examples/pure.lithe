(* A pure function depends only on its arguments. *)

storage is record {
  rate : uint;
}

pure function calculate_fee(const amount : uint; const fee_bps : uint) : uint is
  amount * fee_bps / 10_000

pure function fee_of(const amount : uint) : uint is
  calculate_fee(amount, 25)

external view function preview(const amount : uint) : uint is
  fee_of(amount)

external function quote(const amount : uint) is {
  storage.rate := fee_of(amount);
}
