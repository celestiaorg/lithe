(* `Abi.decode` reads one value back out of ABI-encoded bytes, with Solidity's checks:
   data too short for the value, or a word too wide for its type, reverts. *)

storage is record {
  decoded : uint;
}

external pure function round_bytes(const value : bytes) : bytes is
  Abi.decode(Abi.encode(value), bytes)

external pure function round_string(const value : string) : string is
  Abi.decode(Abi.encode(value), string)

external pure function to_bytes(const data : bytes) : bytes is
  Abi.decode(data, bytes)

external pure function to_small(const data : bytes) : uint8 is
  Abi.decode(data, uint8)
