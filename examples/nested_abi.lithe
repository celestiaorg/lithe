(* Any ABI value, nested any way: a batch of orders, each with a string and a list of its
   own, taken, returned, logged, and sent to another contract as Solidity would. *)

import "std/abi";
import "std/list";

type Order is record {
  id : uint;
  note : string;
  legs : list(uint);
}

type Reserves is record {
  reserve0 : uint112;
  reserve1 : uint112;
  last : uint32;
}

interface Pair is {
  view function getReserves() : Reserves;
}

interface Book is {
  function place(orders : list(Order)) : list(uint);
}

event Placed of record {
  indexed batch : list(Order);
  orders : list(Order);
}

error EmptyLeg of record {
  order : uint;
  legs : list(list(uint));
}

storage is record {
  placed : uint;
}

(* The legs of every order, as a list of lists. *)
external pure function legs(const orders : list(Order)) : list(list(uint)) is {
  var out : list(list(uint)) := [];
  for o : Order in orders do {
    List.push(out, o.legs);
  }
} with out

external pure function leg(const orders : list(Order); const i : uint; const j : uint) : uint is
  orders[i].legs[j]

external nonreentrant function place(const book : Book; const orders : list(Order))
  raises EmptyLeg
is {
  for o : Order in orders do {
    if o.legs.length = 0 then {
      fail EmptyLeg { order = o.id; legs = [o.legs]; };
    }
  }
  storage.placed += orders.length;
  emit Placed { batch = orders; orders = orders; };
  defer book.place(orders);
}

(* Several results in one record: Uniswap's `getReserves`. *)
external view function reservesOf(const pair : Pair) : Reserves is
  query pair.getReserves()

(* Several values from `bytes`, as `abi.decode(data, (address, uint256))`. *)
external pure function unpack(const data : bytes) : (address, uint) is
  Abi.decode(data, (address, uint))
