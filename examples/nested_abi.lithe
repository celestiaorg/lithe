(* Any ABI value, nested any way: a batch of orders, each with a string and a list of its
   own, taken, returned, logged, and sent to another contract as Solidity would. *)

type order is record {
  id : nat;
  note : string;
  legs : list(nat);
}

type reserves is record {
  reserve0 : uint112;
  reserve1 : uint112;
  last : uint32;
}

interface Pair is {
  view function getReserves() : reserves;
}

interface Book is {
  function place(orders : list(order)) : list(nat);
}

event Placed of record {
  indexed batch : list(order);
  orders : list(order);
}

error Empty_leg of record {
  order : nat;
  legs : list(list(nat));
}

storage is record {
  placed : nat;
}

(* The legs of every order, as a list of lists. *)
external pure function legs(const orders : list(order)) : list(list(nat)) is {
  var out : list(list(nat)) := [];
  for o : order in orders do {
    out[out.length] := o.legs;
  }
} with out

external pure function leg(const orders : list(order); const i : nat; const j : nat) : nat is
  orders[i].legs[j]

external nonreentrant function place(const book : Book; const orders : list(order))
  raises Empty_leg
is {
  for o : order in orders do {
    if o.legs.length = 0n then {
      fail Empty_leg { order = o.id; legs = [o.legs]; };
    }
  }
  storage.placed := storage.placed + orders.length;
  emit Placed { batch = orders; orders = orders; };
  defer book.place(orders);
}

(* Several results in one record: Uniswap's `getReserves`. *)
external view function reserves_of(const pair : Pair) : reserves is
  query pair.getReserves()

(* Several values from `bytes`, as `abi.decode(data, (address, uint256))`. *)
external pure function unpack(const data : bytes) : (address, nat) is
  Abi.decode(data, (address, nat))
