(* Deferred calls with continuations. A continuation is a new transition phase: the
   call runs after the earlier phase's effects are applied, and its result is decoded
   and checked before the continuation reads storage again. Continuations run
   depth-first, right after the call they follow. *)

type SwapResult is record {
  amountOut : uint;
  fee : uint;
}

interface Exchange is {
  function swap(amountIn : uint) : SwapResult;
}

interface Vault is {
  function deposit(amount : uint) : uint;
  function withdraw(shares : uint) : (uint, uint);
}

interface Token is {
  function transfer(to : address; amount : uint);
}

type OrderStatus is
  | New
  | Pending
  | Complete
  | Redeemed

type Order is record {
  status : OrderStatus;
  amountOut : uint;
  shares : uint;
}

error AlreadyPlaced of uint;

event Executed of record {
  indexed id : uint;
  amountOut : uint;
  fee : uint;
}

storage is record {
  exchange : Exchange;
  vault : Vault;
  orders : map(uint, Order);
  principal : uint;
  earned : uint;
  paidOut : bool;
}

external function init(const exchange : Exchange; const vault : Vault) is {
  storage.exchange := exchange;
  storage.vault := vault;
}

(* The exchange sees the order as pending. The continuation binds the swap's result,
   marks the order complete, and deposits the proceeds, whose shares arrive in a
   nested continuation. *)
external nonreentrant function execute(const id : uint; const amountIn : uint)
  raises AlreadyPlaced
is {
  assert(storage.orders[id].status = New, AlreadyPlaced(id));
  storage.orders[id].status := Pending;
  defer storage.exchange.swap(amountIn)
    then (result : SwapResult) {
      storage.orders[id].status := Complete;
      storage.orders[id].amountOut := result.amountOut;
      emit Executed { id = id; amountOut = result.amountOut; fee = result.fee; };
      defer storage.vault.deposit(result.amountOut)
        then (shares : uint) {
          storage.orders[id].shares := shares;
        };
    };
}

(* A tuple result destructures in the binding. *)
external nonreentrant function redeem(const id : uint) is {
  defer storage.vault.withdraw(storage.orders[id].shares)
    then ((principal, earned) : (uint, uint)) {
      storage.orders[id].status := Redeemed;
      storage.principal += principal;
      storage.earned += earned;
    };
}

(* A call that returns nothing can still be followed, to sequence effects after it. *)
external nonreentrant function pay(const token : Token; const to : address; const amount : uint) is {
  storage.paidOut := false;
  defer token.transfer(to, amount)
    then {
      storage.paidOut := true;
    };
}

external view function orderOf(const id : uint) : Order is storage.orders[id]
