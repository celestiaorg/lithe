(* Records as values: returned by functions, read field by field, and stored whole. *)

type range is record {
  low : uint;
  high : uint;
}

type quote is record {
  filled : bool;
  price : uint;
  band : range;
}

storage is record {
  last : quote;
  quotes : map(uint, quote);
}

pure function span(const mid : uint) : range is { low = mid; high = mid * 2; }

pure function quote_at(const price : uint) : quote is {
  filled = true;
  price = price;
  band = { low = price + 1; high = price + 2; };
}

external view function spread(const price : uint) : uint is {
  const a : quote := quote_at(price);
  const b : quote := quote_at(price + 100);
} with a.price + a.band.high + b.price

(* A field of a call's result, without naming the record first. *)
external view function low_plus(const price : uint) : uint is
  quote_at(price).band.low + quote_at(price + 10).price

external view function span_high(const mid : uint) : uint is span(mid).high

external view function quote_of(const price : uint) : quote is quote_at(price)

external function save(const price : uint) is {
  storage.last := quote_at(price);
  storage.quotes[price] := quote_at(price);
}

(* Every field on the right reads `storage.last` as it was before the write. *)
external function flip() is {
  storage.last := {
    filled = storage.last.filled;
    price = storage.last.band.low;
    band = { low = storage.last.price; high = storage.last.band.high; };
  };
}

external view function last() : uint is storage.last.price * 1000 + storage.last.band.low

external view function high_of(const price : uint) : uint is storage.quotes[price].band.high
