(* Withdraw the contract balance only while the gate is open and the caller is the owner. *)

import "std/evm";

error NotOwner;
error Closed;

storage is record {
  open : bool;
  owner : address;
}

external function setOpen(const flag : bool)
  raises NotOwner
is {
  assert(Evm.sender() = storage.owner, NotOwner);
  storage.open := flag;
}

external function withdraw(const to : address)
  raises Closed
is {
  assert(storage.open and Evm.sender() = storage.owner, Closed);
  defer Evm.transfer(to, Evm.balance(Evm.self()));
}
