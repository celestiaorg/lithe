(* Raw calls with calldata built by hand and answers decoded by hand: the patterns for
   calling a contract you have no interface for, or one chosen at runtime. The calldata
   comes from `Abi.encodeCall`, `Abi.encodeWithSelector`, or `Abi.encodeWithSignature`;
   the return data from `Abi.decode`; a custom error's payload from the revert data. *)

import "std/abi";
import "std/bytes";
import "std/evm";

interface Token is {
  view function balanceOf(owner : address) : uint;
  function transfer(to : address; amount : uint) : bool;
}

interface Pair is {
  view function getReserves() : (uint112, uint112, uint32);
}

type Reserves is record {
  reserve0 : uint112;
  reserve1 : uint112;
  last : uint32;
}

error TransferRefused;

storage is record {
  sent : uint;
  refusals : uint;
  lastError : bytes4;
}

(* A read: `STATICCALL` with typed calldata, and one word decoded. *)
external view function balance(const token : address; const owner : address) : uint is
  Abi.decode(query Evm.staticCall(token, Abi.encodeCall(Token.balanceOf, owner)), uint)

(* Several results decoded at once, from calldata built from a signature. *)
external view function reservesOf(const pair : address) : Reserves is {
  const answer : bytes := query Evm.staticCall(pair, Abi.encodeWithSignature("getReserves()"));
  const (r0, r1, last) : (uint112, uint112, uint32) := Abi.decode(answer, (uint112, uint112, uint32));
} with { reserve0 = r0; reserve1 = r1; last = last; }

(* A write: a token that answers nothing, `true`, or `false` from `transfer`, as tokens
   do. No answer is success; an answer must decode as `true`. *)
external nonreentrant function send(const token : address; const to : address; const amount : uint)
  raises TransferRefused
is {
  defer Evm.call(token, Abi.encodeWithSelector(0xa9059cbb, to, amount)) then {
    | Ok(answer : bytes) -> {
        if answer.length > 0 then {
          assert(Abi.decode(answer, bool), TransferRefused);
        }
        storage.sent += amount;
      }
    | Error(reason : bytes) -> {
        (* The first four bytes of a custom error are its selector. `Bytes.word` reads a
           whole word, so the reason is padded first: an error with no payload is 4 bytes. *)
        const pad : bytes32 := 0x00;
        if reason.length >= 4 then {
          storage.lastError := bytes4(uint32(uint(Bytes.word(Bytes.concat(reason, pad), 0)) >> 224));
        }
        storage.refusals += 1;
      }
  };
}
