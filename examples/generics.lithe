(* Generic sets specialize at compile time. Set(OrderId) is not Set(bytes32). *)

import "std/collections/set";
import "std/collections/set_enumerable";

type OrderId is bytes32;
type AddressSet is Set(address);
type Cursor is SetEnumerable(address).Iterator;

storage is record {
  admins : AddressSet;
  validators : SetEnumerable(address);
  orders : Set(OrderId);
}

pure function identity(T)(const value : T) : T is
  value

external view function isAdmin(const account : address) : bool is
  Set.contains(storage.admins, account)

external function grant(const account : address) is {
  Set.add(storage.admins, identity(account));
}

external function revoke(const account : address) is {
  Set.remove(storage.admins, account);
}

external view function validatorCount() : uint is
  SetEnumerable.length(storage.validators)

external view function validatorAt(const index : uint) : address
  raises OutOfBounds
is
  SetEnumerable.at(storage.validators, index)

external function addValidator(const account : address) is {
  const _ : bool := SetEnumerable.add(storage.validators, account);
}

external function dropValidator(const account : address) is {
  const _ : bool := SetEnumerable.remove(storage.validators, account);
}

external function track(const id : bytes32) is {
  const order : OrderId := OrderId(id);
  Set.add(storage.orders, order);
}

(* A module passes its own storage to a generic module the same way. *)
module Watchlist is {
  storage watchlist at "lithe.watchlist" is record {
    watched : SetEnumerable(address);
  }

  external function watch(const account : address) is {
    const _ : bool := SetEnumerable.add(watchlist.watched, account);
  }

  external function unwatch(const account : address) is {
    const _ : bool := SetEnumerable.remove(watchlist.watched, account);
  }

  external view function isWatched(const account : address) : bool is
    SetEnumerable.contains(watchlist.watched, account)

  external view function watchedCount() : uint is
    SetEnumerable.length(watchlist.watched)
}

use Watchlist exposing {
  function watch(account : address);
  function unwatch(account : address);
  view function isWatched(account : address) : bool;
  view function watchedCount() : uint;
}
