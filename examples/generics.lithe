(* Generic sets specialize at compile time. Set(order_id) is not Set(bytes32). *)

import "std/collections/set.lithe";
import "std/collections/set_enumerable.lithe";

type order_id is bytes32;
type address_set is Set(address);
type cursor is SetEnumerable(address).iterator;

storage is record {
  admins : address_set;
  validators : SetEnumerable(address);
  orders : Set(order_id);
}

pure function identity(T)(const value : T) : T is
  value

external view function is_admin(const account : address) : bool is
  Set.contains(storage.admins, account)

external function grant(const account : address) is {
  Set.add(storage.admins, identity(account));
}

external function revoke(const account : address) is {
  Set.remove(storage.admins, account);
}

external view function validator_count() : uint is
  SetEnumerable.length(storage.validators)

external view function validator_at(const index : uint) : address
  raises Out_of_bounds
is
  SetEnumerable.at(storage.validators, index)

external function add_validator(const account : address) is {
  SetEnumerable.add(storage.validators, account);
}

external function drop_validator(const account : address) is {
  SetEnumerable.remove(storage.validators, account);
}

external function track(const id : bytes32) is {
  const order : order_id := order_id(id);
  Set.add(storage.orders, order);
}

(* A module passes its own storage to a generic module the same way. *)
module Watchlist is {
  storage watchlist at "lithe.watchlist" is record {
    watched : SetEnumerable(address);
  }

  external function watch(const account : address) is {
    SetEnumerable.add(watchlist.watched, account);
  }

  external function unwatch(const account : address) is {
    SetEnumerable.remove(watchlist.watched, account);
  }

  external view function is_watched(const account : address) : bool is
    SetEnumerable.contains(watchlist.watched, account)

  external view function watched_count() : uint is
    SetEnumerable.length(watchlist.watched)
}

use Watchlist exposing {
  function watch(account : address);
  function unwatch(account : address);
  view function is_watched(account : address) : bool;
  view function watched_count() : uint;
}
