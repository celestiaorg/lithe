(* Options as map values, in records held by maps, and in transient storage. *)

type entry is record {
  amount : nat;
  expiry : option(uint64);
  note : option(nat);
}

storage is record {
  small : map(address, option(uint64));
  wide : map(nat, option(nat));
  nested : map(address, map(nat, option(nat)));
  entries : map(nat, entry);
  pts : map(nat, option((nat, nat)));
  seen : nat;
}

transient storage is record {
  t1 : option(address);
  t2 : option(nat);
  tm : map(nat, option(nat));
  tm8 : map(nat, option(uint8));
}

pure function or_zero(const o : option(nat)) : nat is
  case o of { | Some(v) -> v | None -> 0 }

external function set_small(const v : uint64) is { storage.small[Evm.sender()] := Some(v); }
external function clear_small() is { storage.small[Evm.sender()] := None; }
external view function small_or(const who : address) : nat is
  case storage.small[who] of { | Some(v) -> nat(v) | None -> 1000 }

external function set_wide(const k : nat; const v : nat) is { storage.wide[k] := Some(v); }
external function clear_wide(const k : nat) is { storage.wide[k] := None; }
external view function wide_or(const k : nat) : nat is
  case storage.wide[k] of { | Some(v) -> v | None -> 1000 }
external view function wide_passed(const k : nat) : nat is or_zero(storage.wide[k])
external view function wide_is_none(const k : nat) : bool is storage.wide[k] = None
external view function wide_is(const k : nat; const v : nat) : bool is storage.wide[k] = Some(v)
external function copy_wide(const from : nat; const to : nat) is {
  var o : option(nat) := storage.wide[from];
  storage.wide[to] := o;
}

external function set_nested(const k : nat; const v : nat) is { storage.nested[Evm.sender()][k] := Some(v); }
external view function nested_or(const who : address; const k : nat) : nat is
  case storage.nested[who][k] of { | Some(v) -> v | None -> 1000 }

external function set_entry(const k : nat; const a : nat) is {
  storage.entries[k] := { amount = a; expiry = Some(uint64(5)); note = None; };
}
external function set_note(const k : nat; const v : nat) is { storage.entries[k].note := Some(v); }
external function clear_expiry(const k : nat) is { storage.entries[k].expiry := None; }
external view function entry_sum(const k : nat) : nat is
  storage.entries[k].amount
    + (case storage.entries[k].expiry of { | Some(e) -> nat(e) * 10 | None -> 0 })
    + (case storage.entries[k].note of { | Some(v) -> v * 100 | None -> 0 })

external function set_pt(const k : nat; const x : nat; const y : nat) is { storage.pts[k] := Some((x, y)); }
external view function pt_sum(const k : nat) : nat is
  case storage.pts[k] of { | Some((x, y)) -> x + y * 10 | None -> 1000 }

view function read_t() : nat is
  (case transient.t1 of { | Some(w) -> 1 | None -> 0 })
    + (case transient.t2 of { | Some(v) -> v * 10 | None -> 0 })
    + (case transient.tm[1n] of { | Some(v) -> v * 100 | None -> 0 })
    + (case transient.tm8[2n] of { | Some(v) -> nat(v) * 1000 | None -> 0 })

external function use_transient(const v : nat) is {
  const before : nat := read_t();
  transient.t1 := Some(Evm.sender());
  transient.t2 := Some(v);
  transient.tm[1n] := Some(v);
  transient.tm8[2n] := Some(uint8(3));
  storage.seen := before * 100000 + read_t();
}
external view function fresh_t() : nat is read_t()
