import "./math" as Math;
import "./fee";
import "./ratios" as Ratios;

storage is record {
  n : uint;
}

external function go(const amount : uint) is {
  const fee : Ratios.BasisPoints := 500;
  const raw : uint16 := uint16(fee);
  const _back : Ratios.BasisPoints := Ratios.BasisPoints(raw);
  const taken : uint := calculateFee(amount);
  storage.n := Math.addOne(taken);
}
