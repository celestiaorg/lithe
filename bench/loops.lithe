(* Benchmark: loops over calldata, storage, and ranges, with effects inside them.
   Mirrors loops.sol. `markAll` carries a bound; the scenario stays under it. *)

import "std/abi";
import "std/crypto";
import "std/evm";
import "std/list";

error Nobody;

event Sent of record {
  indexed to : address;
  amount : uint;
}

storage is record {
  balances : map(address, uint);
  owners : list(address);
  isOwner : map(address, bool);
}

external pure function sum(const xs : list(uint)) : uint is {
  var acc : uint := 0;
  for x : uint in xs do {
    acc := acc + x;
  }
} with acc

external function airdrop(const tos : list(address); const amount : uint) is {
  for to : address in tos do {
    storage.balances[to] := storage.balances[to] + amount;
    emit Sent { to = to; amount = amount; };
  }
}

external function join(const who : address) is {
  List.push(storage.owners, who);
}

external function markAll() is {
  for who : address in storage.owners bound 8 do {
    storage.isOwner[who] := true;
  }
}

external view function find(const target : address) : uint is {
  var hit : uint := 0;
  for (i, who) : (uint, address) in storage.owners until hit <> 0 bound 8 do {
    if who = target then {
      hit := i + 1;
    }
  }
} with hit

external pure function gcd(const a : uint; const b : uint) : uint is {
  var x : uint := a;
  var y : uint := b;
  for _ : uint in 0 .. 256 until y = 0 do {
    (x, y) := (y, x % y);
  }
} with x

external pure function hashChain(const seed : bytes32; const n : uint) : bytes32 is {
  var h : bytes32 := seed;
  for _ : uint in 0 .. n do {
    h := Crypto.keccak256(Abi.encode(h));
  }
} with h

external payable function payout(const tos : list(address))
  raises Nobody
is {
  assert(tos.length > 0, Nobody);
  const each : wei := wei(uint(Evm.value()) / tos.length);
  for to : address in tos do {
    defer Evm.transfer(to, each);
  }
}

external view function balanceOf(const who : address) : uint is
  storage.balances[who]

external view function isOwner(const who : address) : bool is
  storage.isOwner[who]
