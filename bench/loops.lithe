(* Benchmark: loops over calldata, storage, and ranges, with effects inside them.
   Mirrors loops.sol. `mark_all` carries a bound; the scenario stays under it. *)

error Nobody;

event Sent of record {
  indexed to : address;
  amount : nat;
}

storage is record {
  balances : map(address, nat);
  owners : list(address);
  is_owner : map(address, bool);
}

external pure function sum(const xs : list(nat)) : nat is {
  var acc : nat := 0n;
  for x : nat in xs do {
    acc := acc + x;
  }
} with acc

external function airdrop(const tos : list(address); const amount : nat) is {
  for to : address in tos do {
    storage.balances[to] := storage.balances[to] + amount;
    emit Sent { to = to; amount = amount; };
  }
}

external function join(const who : address) is {
  storage.owners[storage.owners.length] := who;
}

external function mark_all() is {
  for who : address in storage.owners bound 8 do {
    storage.is_owner[who] := true;
  }
}

external view function find(const target : address) : nat is {
  var hit : nat := 0n;
  for (i, who) : (nat, address) in storage.owners until hit <> 0n bound 8 do {
    if who = target then {
      hit := i + 1n;
    }
  }
} with hit

external pure function gcd(const a : nat; const b : nat) : nat is {
  var x : nat := a;
  var y : nat := b;
  for _ : nat in 0n .. 256n until y = 0n do {
    (x, y) := (y, x % y);
  }
} with x

external pure function hash_chain(const seed : bytes32; const n : nat) : bytes32 is {
  var h : bytes32 := seed;
  for _ : nat in 0n .. n do {
    h := Crypto.keccak256(Abi.encode(h));
  }
} with h

external payable function payout(const tos : list(address))
  raises Nobody
is {
  assert(tos.length > 0n, Nobody);
  const each : wei := wei(nat(Evm.value()) / tos.length);
  for to : address in tos do {
    defer Evm.transfer(to, each);
  }
}

external view function balance_of(const who : address) : nat is
  storage.balances[who]

external view function is_owner(const who : address) : bool is
  storage.is_owner[who]
