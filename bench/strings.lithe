(* Benchmark: strings short and long, from calldata and storage: stored, returned, joined,
   compared, logged, and carried by errors. Mirrors strings.sol. *)

import "std/evm";
import "std/string";

error NameTaken of record {
  name : string;
  owner : address;
}
error TooLong of record {
  name : string;
  limit : uint;
}
error NotOwner of record {
  caller : address;
  name : string;
}

event Renamed of record {
  indexed who : address;
  oldName : string;
  newName : string;
}

immutable is record {
  owner : address;
}

storage is record {
  name : string;
  description : string;
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function rename(const name : string)
  raises NotOwner | NameTaken | TooLong
is {
  assert(Evm.sender() = immutable.owner, NotOwner { caller = Evm.sender(); name = storage.name; });
  assert(name =/= storage.name, NameTaken { name = name; owner = immutable.owner; });
  assert(name.length <= 100, TooLong { name = name; limit = 100; });
  emit Renamed { who = Evm.sender(); oldName = storage.name; newName = name; };
  storage.name := name;
}

external function describe(const text : string)
  raises NotOwner | TooLong
is {
  assert(Evm.sender() = immutable.owner, NotOwner { caller = Evm.sender(); name = storage.name; });
  assert(text.length <= 200, TooLong { name = text; limit = 200; });
  storage.description := String.concat(storage.name, ": ", text);
}

external view function name() : string is
  storage.name

external view function description() : string is
  storage.description

external view function title(const prefix : string) : string is
  String.concat(prefix, " ", storage.name)

external view function requireName(const name : string) : bool
  raises NotOwner
is {
  assert(name = storage.name, NotOwner { caller = Evm.sender(); name = storage.name; });
} with true
