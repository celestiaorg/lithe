(* Benchmark: many short literal reasons, as `require(cond, "reason")` carries them.
   Mirrors reasons.sol. *)

import "std/address";
import "std/evm";

error Failed of string;
error Denied of record {
  who : address;
  reason : string;
}

immutable is record {
  owner : address;
}

storage is record {
  paused : bool;
  limit : uint;
  balances : map(address, uint);
}

deploy() is {
  immutable.owner := Evm.sender();
  storage.limit := 1000;
}

external function deposit(const amount : uint)
  raises Failed
is {
  assert(not storage.paused, Failed("paused"));
  assert(amount > 0, Failed("zero amount"));
  assert(amount <= storage.limit, Failed("over the limit"));
  storage.balances[Evm.sender()] += amount;
}

external function withdraw(const amount : uint)
  raises Failed
is {
  assert(not storage.paused, Failed("paused"));
  assert(amount > 0, Failed("zero amount"));
  const have : uint := storage.balances[Evm.sender()];
  assert(have >= amount, Failed("insufficient balance to proceed"));
  storage.balances[Evm.sender()] := have - amount;
}

external function transfer(const to : address; const amount : uint)
  raises Failed | Denied
is {
  assert(not storage.paused, Failed("paused"));
  assert(to =/= Address.zero, Failed("zero address"));
  assert(to =/= Evm.sender(), Denied { who = to; reason = "self transfer"; });
  const have : uint := storage.balances[Evm.sender()];
  assert(have >= amount, Failed("insufficient balance to proceed"));
  storage.balances[Evm.sender()] := have - amount;
  storage.balances[to] += amount;
}

external function setLimit(const limit : uint)
  raises Denied | Failed
is {
  assert(Evm.sender() = immutable.owner, Denied { who = Evm.sender(); reason = "not the owner"; });
  assert(limit > 0, Failed("zero limit"));
  assert(limit <= 1_000_000, Failed("limit too high"));
  storage.limit := limit;
}

external function pause(const on : bool)
  raises Denied | Failed
is {
  assert(Evm.sender() = immutable.owner, Denied { who = Evm.sender(); reason = "not the owner"; });
  assert(storage.paused =/= on, Failed("already set"));
  storage.paused := on;
}

external view function balanceOf(const who : address) : uint
  raises Failed
is {
  assert(who =/= Address.zero, Failed("zero address"));
} with storage.balances[who]
