(* Benchmark: many short literal reasons, as `require(cond, "reason")` carries them.
   Mirrors reasons.sol. *)

error Failed of string;
error Denied of record {
  who : address;
  reason : string;
}

storage is record {
  owner : address;
  paused : bool;
  limit : nat;
  balances : map(address, nat);
}

deploy() is {
  storage.owner := Evm.sender();
  storage.limit := 1000n;
}

external function deposit(const amount : nat)
  raises Failed
is {
  assert(not storage.paused, Failed("paused"));
  assert(amount > 0n, Failed("zero amount"));
  assert(amount <= storage.limit, Failed("over the limit"));
  storage.balances[Evm.sender()] := storage.balances[Evm.sender()] + amount;
}

external function withdraw(const amount : nat)
  raises Failed
is {
  assert(not storage.paused, Failed("paused"));
  assert(amount > 0n, Failed("zero amount"));
  const have : nat := storage.balances[Evm.sender()];
  assert(have >= amount, Failed("insufficient balance to proceed"));
  storage.balances[Evm.sender()] := have - amount;
}

external function transfer(const to : address; const amount : nat)
  raises Failed | Denied
is {
  assert(not storage.paused, Failed("paused"));
  assert(to =/= Address.zero, Failed("zero address"));
  assert(to =/= Evm.sender(), Denied { who = to; reason = "self transfer"; });
  const have : nat := storage.balances[Evm.sender()];
  assert(have >= amount, Failed("insufficient balance to proceed"));
  storage.balances[Evm.sender()] := have - amount;
  storage.balances[to] := storage.balances[to] + amount;
}

external function set_limit(const limit : nat)
  raises Denied | Failed
is {
  assert(Evm.sender() = storage.owner, Denied { who = Evm.sender(); reason = "not the owner"; });
  assert(limit > 0n, Failed("zero limit"));
  assert(limit <= 1_000_000n, Failed("limit too high"));
  storage.limit := limit;
}

external function pause(const on : bool)
  raises Denied | Failed
is {
  assert(Evm.sender() = storage.owner, Denied { who = Evm.sender(); reason = "not the owner"; });
  assert(storage.paused =/= on, Failed("already set"));
  storage.paused := on;
}

external view function balance_of(const who : address) : nat
  raises Failed
is {
  assert(who =/= Address.zero, Failed("zero address"));
} with storage.balances[who]
