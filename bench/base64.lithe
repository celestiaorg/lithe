(* Benchmark: base64 with the `Base64` built-ins. Mirrors base64.sol. *)

import "std/base64";

contract Base64Bench is {
  external pure function encode(const data : bytes) : string is
    Base64.encode(data)

  external pure function encodeWith(const data : bytes; const fileSafe : bool; const noPadding : bool) : string is
    Base64.encodeWith(data, fileSafe, noPadding)

  external pure function decode(const data : string) : bytes is
    Base64.decode(data)
}
