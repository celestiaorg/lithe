(* Benchmark: OpenZeppelin's wizard NFT, upgradeable, burnable, pausable, and ownable,
   built from modules. Mirrors erc721.sol, which imports OpenZeppelin. *)

import "./lib/initializable.lithe";
import "./lib/ownable.lithe";
import "./lib/pausable.lithe";
import "./lib/erc721.lithe";

contract BenchNFT is {
  use Initializable;

  external use ERC721 is {
    pure function supportsInterface(interfaceId : bytes4) : bool;
    view function balanceOf(owner : address) : nat
      raises ERC721InvalidOwner;
    view function ownerOf(tokenId : nat) : address
      raises ERC721NonexistentToken;
    view function name() : string;
    view function symbol() : string;
    view function tokenURI(tokenId : nat) : string
      raises ERC721NonexistentToken;
    view function getApproved(tokenId : nat) : address
      raises ERC721NonexistentToken;
    view function isApprovedForAll(owner : address; operator : address) : bool;
  }

  external use Ownable is {
    view function owner() : address;
    function transferOwnership(newOwner : address)
      raises OwnableUnauthorizedAccount | OwnableInvalidOwner;
    function renounceOwnership()
      raises OwnableUnauthorizedAccount;
  }

  external use Pausable is {
    view function paused() : bool;
  }

  (* Initializable's bookkeeping matches the `initializer` modifier on Solidity's
     constructor, so storage and events stay the same. *)
  deploy(const initialOwner : address)
    raises InvalidInitialization | OwnableInvalidOwner
  is {
    Initializable.begin();
    ERC721.init("Bench NFT", "BNFT");
    Ownable.init(initialOwner);
    Initializable.finish();
  }

  (* `ERC721Pausable` checks the pause inside every ownership update. *)
  function update(const to : address; const tokenId : nat; const auth : address) : address
    raises EnforcedPause | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    Pausable.require_not_paused();
  } with ERC721.update(to, tokenId, auth)

  function transfer_from(const from : address; const to : address; const tokenId : nat)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause
      | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    assert(to <> Address.zero, ERC721InvalidReceiver(Address.zero));
    const previous : address := update(to, tokenId, Evm.sender());
    assert(
      previous = from,
      ERC721IncorrectOwner { sender = from; tokenId = tokenId; owner = previous; }
    );
  }

  external function approve(const to : address; const tokenId : nat)
    raises ERC721NonexistentToken | ERC721InvalidApprover
  is {
    ERC721.approve_as(to, tokenId, Evm.sender());
  }

  external function setApprovalForAll(const operator : address; const approved : bool)
    raises ERC721InvalidApprover | ERC721InvalidOperator
  is {
    ERC721.set_approval_for_all(Evm.sender(), operator, approved);
  }

  external function transferFrom(const from : address; const to : address; const tokenId : nat)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause
      | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    transfer_from(from, to, tokenId);
  }

  external function safeTransferFrom(const from : address; const to : address; const tokenId : nat)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause
      | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    transfer_from(from, to, tokenId);
    ERC721.check_received(Evm.sender(), from, to, tokenId, "");
  }

  external function safeTransferFrom(
    const from : address;
    const to : address;
    const tokenId : nat;
    const data : bytes
  )
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause
      | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    transfer_from(from, to, tokenId);
    ERC721.check_received(Evm.sender(), from, to, tokenId, data);
  }

  external function burn(const tokenId : nat)
    raises EnforcedPause | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const previous : address := update(Address.zero, tokenId, Evm.sender());
  }

  external function safeMint(const to : address; const tokenId : nat)
    raises OwnableUnauthorizedAccount | ERC721InvalidReceiver | ERC721InvalidSender
      | EnforcedPause | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    Ownable.check_owner();
    assert(to <> Address.zero, ERC721InvalidReceiver(Address.zero));
    const previous : address := update(to, tokenId, Address.zero);
    assert(previous = Address.zero, ERC721InvalidSender(Address.zero));
    ERC721.check_received(Evm.sender(), Address.zero, to, tokenId, "");
  }

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.check_owner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.check_owner();
    Pausable.unpause();
  }
}
