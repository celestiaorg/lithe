(* Benchmark: OpenZeppelin's wizard NFT, upgradeable, burnable, pausable, and ownable,
   built from modules. Mirrors erc721.sol, which imports OpenZeppelin. *)

import "std/address";
import "std/evm";
import "./lib/initializable";
import "./lib/ownable";
import "./lib/pausable";
import "./lib/erc721";

contract BenchNFT is {
  use Initializable;

  use ERC721 exposing IERC721Views, IERC721Metadata;
  use Ownable exposing IOwnable;
  use Pausable exposing IPausable;

  supports IERC721, IERC721Metadata;

  (* Initializable's bookkeeping matches the `initializer` modifier on Solidity's
     constructor, so storage and events stay the same. *)
  deploy(const initialOwner : address)
    raises InvalidInitialization | OwnableInvalidOwner
  is {
    Initializable.begin();
    ERC721.init("Bench NFT", "BNFT");
    Ownable.init(initialOwner);
    Initializable.finish();
  }

  (* `ERC721Pausable` checks the pause inside every ownership update. *)
  hook ERC721.beforeTransfer is Pausable.requireNotPaused;
  hook ERC721.afterTransfer is skip;

  function move(const from : address; const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
      | ERC721InsufficientApproval
  is {
    assert(to <> Address.zero, ERC721InvalidReceiver(Address.zero));
    const previous : address := ERC721.update(to, tokenId, Evm.sender());
    assert(
      previous = from,
      ERC721IncorrectOwner { sender = from; tokenId = tokenId; owner = previous; }
    );
  }

  external function approve(const to : address; const tokenId : uint)
    raises ERC721NonexistentToken | ERC721InvalidApprover
  is {
    ERC721.approveAs(to, tokenId, Evm.sender());
  }

  external function setApprovalForAll(const operator : address; const approved : bool)
    raises ERC721InvalidApprover | ERC721InvalidOperator
  is {
    ERC721.setApprovalForAll(Evm.sender(), operator, approved);
  }

  external function transferFrom(const from : address; const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
      | ERC721InsufficientApproval
  is {
    move(from, to, tokenId);
  }

  external function safeTransferFrom(const from : address; const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
      | ERC721InsufficientApproval | forwarded
  is {
    move(from, to, tokenId);
    ERC721.checkReceived(Evm.sender(), from, to, tokenId, "");
  }

  external function safeTransferFrom(
    const from : address;
    const to : address;
    const tokenId : uint;
    const data : bytes
  )
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | EnforcedPause | ERC721NonexistentToken
      | ERC721InsufficientApproval | forwarded
  is {
    move(from, to, tokenId);
    ERC721.checkReceived(Evm.sender(), from, to, tokenId, data);
  }

  external function burn(const tokenId : uint)
    raises EnforcedPause | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const _ : address := ERC721.update(Address.zero, tokenId, Evm.sender());
  }

  external function safeMint(const to : address; const tokenId : uint)
    raises OwnableUnauthorizedAccount | ERC721InvalidReceiver | ERC721InvalidSender | EnforcedPause
      | ERC721NonexistentToken | ERC721InsufficientApproval | forwarded
  is {
    Ownable.checkOwner();
    assert(to <> Address.zero, ERC721InvalidReceiver(Address.zero));
    const previous : address := ERC721.update(to, tokenId, Address.zero);
    assert(previous = Address.zero, ERC721InvalidSender(Address.zero));
    ERC721.checkReceived(Evm.sender(), Address.zero, to, tokenId, "");
  }

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.checkOwner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.checkOwner();
    Pausable.unpause();
  }
}
