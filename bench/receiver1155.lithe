(* Benchmark: an ERC-1155 receiver that records each delivery. Mirrors receiver1155.sol.
   In mode 1 it answers with the wrong selector; in mode 2 it refuses with a reason; in
   mode 3 it reverts without one. *)

import "std/abi";
import "std/interfaces/erc1155";

error Refused of uint;

storage is record {
  lastOperator : address;
  lastFrom : address;
  lastIds : list(uint);
  lastValues : list(uint);
  lastData : bytes;
  calls : uint;
  mode : uint;
}

external function setMode(const m : uint) is {
  storage.mode := m;
}

function keep(
  const operator : address;
  const from : address;
  const ids : list(uint);
  const values : list(uint);
  const data : bytes
)
  raises Refused | forwarded
is {
  assert(storage.mode <> 2, Refused(ids.length));
  if storage.mode = 3 then {
    const nothing : bytes := "";
    forward nothing;
  }
  storage.lastOperator := operator;
  storage.lastFrom := from;
  storage.lastIds := ids;
  storage.lastValues := values;
  storage.lastData := data;
  storage.calls += 1;
}

external function onERC1155Received(
  const operator : address;
  const from : address;
  const id : uint;
  const value : uint;
  const data : bytes
) : bytes4
  raises Refused | forwarded
is {
  keep(operator, from, [id], [value], data);
  var answer : bytes4 := Abi.selector(IERC1155Receiver.onERC1155Received);
  if storage.mode = 1 then {
    answer := 0xdeadbeef;
  }
} with answer

external function onERC1155BatchReceived(
  const operator : address;
  const from : address;
  const ids : list(uint);
  const values : list(uint);
  const data : bytes
) : bytes4
  raises Refused | forwarded
is {
  keep(operator, from, ids, values, data);
  var answer : bytes4 := Abi.selector(IERC1155Receiver.onERC1155BatchReceived);
  if storage.mode = 1 then {
    answer := 0xdeadbeef;
  }
} with answer
