(* Benchmark: Synthetix's StakingRewards, on the same Ownable and Initializable
   modules as the token. Mirrors staking.sol, which imports OpenZeppelin.
   Token transfers are deferred, so they run after the staking contract's own effects. *)

import "std/address";
import "std/evm";
import "./lib/initializable";
import "./lib/ownable";

contract StakingRewards is {
  use Initializable;

  use Ownable exposing IOwnable;

  interface IERC20 is {
    function transfer(to : address; value : uint) : bool;
    function transferFrom(from : address; to : address; value : uint) : bool;
    view function balanceOf(account : address) : uint;
  }

  storage is record {
    rewardsToken : IERC20;
    stakingToken : IERC20;
    periodFinish : timestamp;
    rewardRate : uint;
    rewardsDuration : uint;
    lastUpdateTime : timestamp;
    rewardPerTokenStored : uint;
    userRewardPerTokenPaid : map(address, uint);
    rewards : map(address, uint);
    totalSupply : uint;
    balances : map(address, uint);
  }

  error CannotStakeZero;
  error CannotWithdrawZero;
  error RewardTooHigh;
  error RewardPeriodActive;

  event RewardAdded of record {
    reward : uint;
  }

  event Staked of record {
    indexed user : address;
    amount : uint;
  }

  event Withdrawn of record {
    indexed user : address;
    amount : uint;
  }

  event RewardPaid of record {
    indexed user : address;
    reward : uint;
  }

  event RewardsDurationUpdated of record {
    newDuration : uint;
  }

  (* Initializable's bookkeeping matches the `initializer` modifier on Solidity's
     constructor, so storage and events stay the same. *)
  deploy(const owner_ : address; const rewardsToken_ : IERC20; const stakingToken_ : IERC20)
    raises InvalidInitialization | OwnableInvalidOwner
  is {
    Initializable.begin();
    Ownable.init(owner_);
    storage.rewardsToken := rewardsToken_;
    storage.stakingToken := stakingToken_;
    storage.rewardsDuration := 604800;
    Initializable.finish();
  }

  view function last_time_reward_applicable() : timestamp is {
    var applicable : timestamp := Evm.block_timestamp();
    if storage.periodFinish < applicable then {
      applicable := storage.periodFinish;
    }
  } with applicable

  view function reward_per_token() : uint is {
    var per : uint := storage.rewardPerTokenStored;
    if storage.totalSupply <> 0 then {
      per := storage.rewardPerTokenStored
        + (last_time_reward_applicable() - storage.lastUpdateTime)
          * storage.rewardRate * 10 ** 18 / storage.totalSupply;
    }
  } with per

  view function earned_by(const account : address) : uint is
    storage.balances[account] * (reward_per_token() - storage.userRewardPerTokenPaid[account])
      / 10 ** 18 + storage.rewards[account]

  function update_reward(const account : address) is {
    storage.rewardPerTokenStored := reward_per_token();
    storage.lastUpdateTime := last_time_reward_applicable();
    if account <> Address.zero then {
      storage.rewards[account] := earned_by(account);
      storage.userRewardPerTokenPaid[account] := storage.rewardPerTokenStored;
    }
  }

  function withdraw_as_sender(const amount : uint)
    raises CannotWithdrawZero
  is {
    update_reward(Evm.sender());
    assert(amount <> 0, CannotWithdrawZero);
    storage.totalSupply := storage.totalSupply - amount;
    storage.balances[Evm.sender()] := storage.balances[Evm.sender()] - amount;
    emit Withdrawn {
      user = Evm.sender();
      amount = amount;
    };
    defer storage.stakingToken.transfer(Evm.sender(), amount);
  }

  function reward_sender() is {
    update_reward(Evm.sender());
    const reward : uint := storage.rewards[Evm.sender()];
    if reward > 0 then {
      storage.rewards[Evm.sender()] := 0;
      emit RewardPaid {
        user = Evm.sender();
        reward = reward;
      };
      defer storage.rewardsToken.transfer(Evm.sender(), reward);
    }
  }

  external nonreentrant function stake(const amount : uint)
    raises CannotStakeZero
  is {
    update_reward(Evm.sender());
    assert(amount <> 0, CannotStakeZero);
    storage.totalSupply := storage.totalSupply + amount;
    storage.balances[Evm.sender()] := storage.balances[Evm.sender()] + amount;
    emit Staked {
      user = Evm.sender();
      amount = amount;
    };
    defer storage.stakingToken.transferFrom(Evm.sender(), Evm.self(), amount);
  }

  external nonreentrant function withdraw(const amount : uint)
    raises CannotWithdrawZero
  is {
    withdraw_as_sender(amount);
  }

  external nonreentrant function getReward() is {
    reward_sender();
  }

  external nonreentrant function exit()
    raises CannotWithdrawZero
  is {
    withdraw_as_sender(storage.balances[Evm.sender()]);
    reward_sender();
  }

  external function notifyRewardAmount(const reward : uint)
    raises OwnableUnauthorizedAccount | RewardTooHigh
  is {
    Ownable.check_owner();
    update_reward(Address.zero);
    if Evm.block_timestamp() >= storage.periodFinish then {
      storage.rewardRate := reward / storage.rewardsDuration;
    } else {
      const remaining : uint := storage.periodFinish - Evm.block_timestamp();
      const leftover : uint := remaining * storage.rewardRate;
      storage.rewardRate := (reward + leftover) / storage.rewardsDuration;
    }
    const balance : uint := query storage.rewardsToken.balanceOf(Evm.self());
    assert(storage.rewardRate <= balance / storage.rewardsDuration, RewardTooHigh);
    storage.lastUpdateTime := Evm.block_timestamp();
    storage.periodFinish := Evm.block_timestamp() + storage.rewardsDuration;
    emit RewardAdded {
      reward = reward;
    };
  }

  external function setRewardsDuration(const duration : uint)
    raises OwnableUnauthorizedAccount | RewardPeriodActive
  is {
    Ownable.check_owner();
    assert(Evm.block_timestamp() > storage.periodFinish, RewardPeriodActive);
    storage.rewardsDuration := duration;
    emit RewardsDurationUpdated {
      newDuration = duration;
    };
  }

  external view function rewardsToken() : IERC20 is
    storage.rewardsToken

  external view function stakingToken() : IERC20 is
    storage.stakingToken

  external view function periodFinish() : timestamp is
    storage.periodFinish

  external view function rewardRate() : uint is
    storage.rewardRate

  external view function rewardsDuration() : uint is
    storage.rewardsDuration

  external view function lastUpdateTime() : timestamp is
    storage.lastUpdateTime

  external view function rewardPerTokenStored() : uint is
    storage.rewardPerTokenStored

  external view function userRewardPerTokenPaid(const account : address) : uint is
    storage.userRewardPerTokenPaid[account]

  external view function rewards(const account : address) : uint is
    storage.rewards[account]

  external view function totalSupply() : uint is
    storage.totalSupply

  external view function balanceOf(const account : address) : uint is
    storage.balances[account]

  external view function lastTimeRewardApplicable() : timestamp is
    last_time_reward_applicable()

  external view function rewardPerToken() : uint is
    reward_per_token()

  external view function earned(const account : address) : uint is
    earned_by(account)

  external view function getRewardForDuration() : uint is
    storage.rewardRate * storage.rewardsDuration
}
