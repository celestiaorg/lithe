(* Benchmark: overloaded internal functions, picked by argument count and type, including
   ones that take a storage map; and overloaded entrypoints. Mirrors overloads.sol. *)

type shares is nat;

storage is record {
  balances : map(address, nat);
  staked : map(address, nat);
  total : nat;
}

pure function fee(const amount : nat) : nat is
  fee(amount, 30n)

pure function fee(const amount : nat; const bps : nat) : nat is
  amount * bps / 10_000n

function credit(const ledger : map(address, nat); const to : address; const amount : nat) is {
  ledger[to] := ledger[to] + amount;
}

function credit(const to : address; const amount : nat) is {
  credit(storage.balances, to, amount);
  storage.total := storage.total + amount;
}

function credit(const to : address; const amount : shares) is {
  credit(storage.staked, to, nat(amount));
}

function move(const ledger : map(address, nat); const to : address; const amount : nat) is {
  ledger[Evm.sender()] := ledger[Evm.sender()] - amount;
  credit(ledger, to, amount);
}

function move(const to : address; const amount : nat) is {
  move(storage.balances, to, amount);
}

function move(const to : address; const amount : shares) is {
  move(storage.staked, to, nat(amount));
}

external function deposit(const amount : nat) is {
  credit(Evm.sender(), amount - fee(amount));
}

external function deposit(const amount : nat; const bps : nat) is {
  credit(Evm.sender(), amount - fee(amount, bps));
}

external function stake(const amount : nat) is {
  credit(Evm.sender(), shares(amount));
}

external function transfer(const to : address; const amount : nat) is {
  move(to, amount);
}

external function transfer_staked(const to : address; const amount : nat) is {
  move(to, shares(amount));
}

external view function balance_of(const who : address) : nat is
  storage.balances[who]

external view function staked_of(const who : address) : nat is
  storage.staked[who]

external view function total() : nat is
  storage.total
