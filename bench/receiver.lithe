(* Benchmark: an ERC-721 receiver that records each delivery. Mirrors receiver.sol.
   In mode 1 it answers with the wrong selector; in mode 2 it refuses with a reason. *)

import "std/abi";
import "std/interfaces/erc721";

error Refused of uint;

storage is record {
  lastOperator : address;
  lastFrom : address;
  lastToken : uint;
  lastData : bytes;
  calls : uint;
  mode : uint;
}

external function setMode(const m : uint) is {
  storage.mode := m;
}

external function onERC721Received(
  const operator : address;
  const from : address;
  const tokenId : uint;
  const data : bytes
) : bytes4
  raises Refused
is {
  assert(storage.mode <> 2, Refused(tokenId));
  storage.lastOperator := operator;
  storage.lastFrom := from;
  storage.lastToken := tokenId;
  storage.lastData := data;
  storage.calls := storage.calls + 1;
  var answer : bytes4 := Abi.selector(IERC721Receiver.onERC721Received);
  if storage.mode = 1 then {
    answer := 0xdeadbeef;
  }
} with answer
