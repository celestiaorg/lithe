(* Benchmark: an ERC-721 receiver that records each delivery. Mirrors receiver.sol.
   In mode 1 it answers with the wrong selector; in mode 2 it refuses with a reason. *)

import "std/interfaces/erc721.lithe";

error Refused of nat;

storage is record {
  last_operator : address;
  last_from : address;
  last_token : nat;
  last_data : bytes;
  calls : nat;
  mode : nat;
}

external function set_mode(const m : nat) is {
  storage.mode := m;
}

external function onERC721Received(
  const operator : address;
  const from : address;
  const tokenId : nat;
  const data : bytes
) : bytes4
  raises Refused
is {
  assert(storage.mode <> 2n, Refused(tokenId));
  storage.last_operator := operator;
  storage.last_from := from;
  storage.last_token := tokenId;
  storage.last_data := data;
  storage.calls := storage.calls + 1n;
  var answer : bytes4 := Abi.selector(IERC721Receiver.onERC721Received);
  if storage.mode = 1n then {
    answer := 0xdeadbeef;
  }
} with answer
