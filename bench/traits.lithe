(* Benchmark: token traits whose errors carry strings and lists. Mirrors traits.sol. *)

error EmptyTrait of string;
error AttributeNotFound of record {
  tokenId : uint;
  traitType : string;
}
error NotMinted of list(uint);

storage is record {
  minted : uint;
  tagged : uint;
}

external function mint(const count : uint) is {
  storage.minted += count;
}

external function tag(const tokenId : uint; const traitType : string)
  raises EmptyTrait | AttributeNotFound
is {
  assert(traitType.length > 0, EmptyTrait("trait type is empty"));
  assert(
    tokenId < storage.minted,
    AttributeNotFound { tokenId = tokenId; traitType = traitType; }
  );
  storage.tagged := tokenId;
}

external view function background(const tokenId : uint) : uint
  raises AttributeNotFound
is {
  assert(
    tokenId < storage.minted,
    AttributeNotFound { tokenId = tokenId; traitType = "Background"; }
  );
} with tokenId

external view function check(const ids : list(uint)) : uint
  raises NotMinted
is {
  for id : uint in ids do {
    assert(id < storage.minted, NotMinted(ids));
  }
} with ids.length
