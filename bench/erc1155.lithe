(* Benchmark: OpenZeppelin's wizard multi-token, upgradeable, burnable, pausable, ownable,
   with supply tracking and an updatable URI, built from modules. Mirrors erc1155.sol,
   which imports OpenZeppelin. *)

import "std/address";
import "std/evm";
import "./lib/initializable";
import "./lib/ownable";
import "./lib/pausable";
import "./lib/erc1155";
import "./lib/erc1155_supply";

contract BenchMultiToken is {
  use Initializable;

  use ERC1155 exposing IERC1155Views, IERC1155MetadataURI;
  use ERC1155Supply exposing IERC1155Supply;
  use Ownable exposing IOwnable;
  use Pausable exposing IPausable;

  supports IERC1155, IERC1155MetadataURI;

  (* Initializable's bookkeeping matches the `initializer` modifier on Solidity's
     constructor, so storage and events stay the same. *)
  deploy(const initialOwner : address)
    raises InvalidInitialization | OwnableInvalidOwner
  is {
    Initializable.begin();
    ERC1155.setURI("https://bench.example/token/{id}.json");
    Ownable.init(initialOwner);
    Initializable.finish();
  }

  (* `ERC1155Pausable` checks the pause, and `ERC1155Supply` counts after the balances. *)
  hook ERC1155.beforeTransfer is Pausable.requireNotPaused;
  hook ERC1155.afterTransfer is ERC1155Supply.update;

  function transfer(const from : address; const to : address; const ids : list(uint); const values : list(uint))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidReceiver | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    ERC1155.checkAuthorized(Evm.sender(), from);
    assert(to <> Address.zero, ERC1155InvalidReceiver(Address.zero));
    assert(from <> Address.zero, ERC1155InvalidSender(Address.zero));
    ERC1155.update(from, to, ids, values);
  }

  function burnFrom(const account : address; const ids : list(uint); const values : list(uint))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | EnforcedPause | ERC1155InvalidArrayLength
      | ERC1155InsufficientBalance
  is {
    ERC1155.checkAuthorized(Evm.sender(), account);
    assert(account <> Address.zero, ERC1155InvalidSender(Address.zero));
    ERC1155.update(account, Address.zero, ids, values);
  }

  function mintTo(const to : address; const ids : list(uint); const values : list(uint))
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | EnforcedPause | ERC1155InvalidArrayLength
      | ERC1155InsufficientBalance
  is {
    Ownable.checkOwner();
    assert(to <> Address.zero, ERC1155InvalidReceiver(Address.zero));
    ERC1155.update(Address.zero, to, ids, values);
  }

  external function setApprovalForAll(const operator : address; const approved : bool)
    raises ERC1155InvalidApprover | ERC1155InvalidOperator
  is {
    ERC1155.setApprovalForAll(Evm.sender(), operator, approved);
  }

  external function safeTransferFrom(
    const from : address;
    const to : address;
    const id : uint;
    const value : uint;
    const data : bytes
  )
    raises ERC1155MissingApprovalForAll | ERC1155InvalidReceiver | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance | forwarded
  is {
    transfer(from, to, [id], [value]);
    ERC1155.checkReceived(from, to, id, value, data);
  }

  external function safeBatchTransferFrom(
    const from : address;
    const to : address;
    const ids : list(uint);
    const values : list(uint);
    const data : bytes
  )
    raises ERC1155MissingApprovalForAll | ERC1155InvalidReceiver | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance | forwarded
  is {
    transfer(from, to, ids, values);
    ERC1155.checkBatchReceived(from, to, ids, values, data);
  }

  external function burn(const account : address; const id : uint; const value : uint)
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | EnforcedPause | ERC1155InvalidArrayLength
      | ERC1155InsufficientBalance
  is {
    burnFrom(account, [id], [value]);
  }

  external function burnBatch(const account : address; const ids : list(uint); const values : list(uint))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | EnforcedPause | ERC1155InvalidArrayLength
      | ERC1155InsufficientBalance
  is {
    burnFrom(account, ids, values);
  }

  external function mint(const account : address; const id : uint; const amount : uint; const data : bytes)
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | EnforcedPause | ERC1155InvalidArrayLength
      | ERC1155InsufficientBalance | forwarded
  is {
    mintTo(account, [id], [amount]);
    ERC1155.checkReceived(Address.zero, account, id, amount, data);
  }

  external function mintBatch(
    const to : address;
    const ids : list(uint);
    const amounts : list(uint);
    const data : bytes
  )
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | EnforcedPause | ERC1155InvalidArrayLength
      | ERC1155InsufficientBalance | forwarded
  is {
    mintTo(to, ids, amounts);
    ERC1155.checkBatchReceived(Address.zero, to, ids, amounts, data);
  }

  external function setURI(const newuri : string)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.checkOwner();
    ERC1155.setURI(newuri);
  }

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.checkOwner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.checkOwner();
    Pausable.unpause();
  }
}
