(* Benchmark: OpenZeppelin's wizard multi-token, upgradeable, burnable, pausable, ownable,
   with supply tracking and an updatable URI, built from modules. Mirrors erc1155.sol,
   which imports OpenZeppelin. *)

import "./lib/initializable.lithe";
import "./lib/ownable.lithe";
import "./lib/pausable.lithe";
import "./lib/erc1155.lithe";
import "./lib/erc1155_supply.lithe";

contract BenchMultiToken is {
  use Initializable;

  use ERC1155 exposing IERC1155Views, IERC1155MetadataURI;
  use ERC1155Supply exposing IERC1155Supply;
  use Ownable exposing IOwnable;
  use Pausable exposing IPausable;

  supports IERC1155, IERC1155MetadataURI;

  (* Initializable's bookkeeping matches the `initializer` modifier on Solidity's
     constructor, so storage and events stay the same. *)
  deploy(const initialOwner : address)
    raises InvalidInitialization | OwnableInvalidOwner
  is {
    Initializable.begin();
    ERC1155.set_uri("https://bench.example/token/{id}.json");
    Ownable.init(initialOwner);
    Initializable.finish();
  }

  (* `ERC1155Pausable` checks the pause, and `ERC1155Supply` counts after the balances. *)
  function update(const from : address; const to : address; const ids : list(nat); const values : list(nat))
    raises EnforcedPause | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    Pausable.require_not_paused();
    ERC1155.update(from, to, ids, values);
    ERC1155Supply.update(from, to, ids, values);
  }

  function transfer(const from : address; const to : address; const ids : list(nat); const values : list(nat))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidReceiver | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    ERC1155.check_authorized(Evm.sender(), from);
    assert(to <> Address.zero, ERC1155InvalidReceiver(Address.zero));
    assert(from <> Address.zero, ERC1155InvalidSender(Address.zero));
    update(from, to, ids, values);
  }

  function burn_from(const account : address; const ids : list(nat); const values : list(nat))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    ERC1155.check_authorized(Evm.sender(), account);
    assert(account <> Address.zero, ERC1155InvalidSender(Address.zero));
    update(account, Address.zero, ids, values);
  }

  function mint_to(const to : address; const ids : list(nat); const values : list(nat))
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    Ownable.check_owner();
    assert(to <> Address.zero, ERC1155InvalidReceiver(Address.zero));
    update(Address.zero, to, ids, values);
  }

  external function setApprovalForAll(const operator : address; const approved : bool)
    raises ERC1155InvalidApprover | ERC1155InvalidOperator
  is {
    ERC1155.set_approval_for_all(Evm.sender(), operator, approved);
  }

  external function safeTransferFrom(
    const from : address;
    const to : address;
    const id : nat;
    const value : nat;
    const data : bytes
  )
    raises ERC1155MissingApprovalForAll | ERC1155InvalidReceiver | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    transfer(from, to, [id], [value]);
    ERC1155.check_received(from, to, id, value, data);
  }

  external function safeBatchTransferFrom(
    const from : address;
    const to : address;
    const ids : list(nat);
    const values : list(nat);
    const data : bytes
  )
    raises ERC1155MissingApprovalForAll | ERC1155InvalidReceiver | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    transfer(from, to, ids, values);
    ERC1155.check_batch_received(from, to, ids, values, data);
  }

  external function burn(const account : address; const id : nat; const value : nat)
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    burn_from(account, [id], [value]);
  }

  external function burnBatch(const account : address; const ids : list(nat); const values : list(nat))
    raises ERC1155MissingApprovalForAll | ERC1155InvalidSender | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    burn_from(account, ids, values);
  }

  external function mint(const account : address; const id : nat; const amount : nat; const data : bytes)
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    mint_to(account, [id], [amount]);
    ERC1155.check_received(Address.zero, account, id, amount, data);
  }

  external function mintBatch(const to : address; const ids : list(nat); const amounts : list(nat); const data : bytes)
    raises OwnableUnauthorizedAccount | ERC1155InvalidReceiver | EnforcedPause
      | ERC1155InvalidArrayLength | ERC1155InsufficientBalance
  is {
    mint_to(to, ids, amounts);
    ERC1155.check_batch_received(Address.zero, to, ids, amounts, data);
  }

  external function setURI(const newuri : string)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.check_owner();
    ERC1155.set_uri(newuri);
  }

  external function pause()
    raises OwnableUnauthorizedAccount | EnforcedPause
  is {
    Ownable.check_owner();
    Pausable.pause();
  }

  external function unpause()
    raises OwnableUnauthorizedAccount | ExpectedPause
  is {
    Ownable.check_owner();
    Pausable.unpause();
  }
}
