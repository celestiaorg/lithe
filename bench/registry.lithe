(* Benchmark: string and bytes storage. Mirrors registry.sol. *)

import "std/crypto";
import "std/evm";

event Renamed of record {
  indexed label : string;
}

event Tagged of record {
  indexed who : address;
  tag : bytes4;
  level : uint8;
}

storage is record {
  name : string;
  blob : bytes;
  updates : uint;
  tag : bytes4;
  level : uint8;
}

deploy(const n : string) is {
  storage.name := n;
}

external function rename(const n : string) is {
  storage.name := n;
  storage.updates += 1;
  emit Renamed {
    label = n;
  };
}

external function setBlob(const b : bytes) is {
  storage.blob := b;
}

external function setBoth(const n : string; const b : bytes) is {
  storage.name := n;
  storage.blob := b;
}

external view function name() : string is
  storage.name

external view function blob() : bytes is
  storage.blob

external view function digest() : bytes32 is
  Crypto.keccak256(storage.blob)

external function setTag(const t : bytes4; const level : uint8) is {
  storage.tag := t;
  storage.level := level;
  emit Tagged {
    who = Evm.sender();
    tag = t;
    level = level;
  };
}

external view function tag() : bytes4 is
  storage.tag

external view function level() : uint8 is
  storage.level
