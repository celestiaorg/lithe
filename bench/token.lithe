(* Benchmark: a minimal token with owner minting. Mirrors token.sol. *)

import "std/address";
import "std/evm";

error Not_owner;

error Insufficient_balance of record {
  available : uint;
  required : uint;
}

event Transfer of record {
  indexed from : address;
  indexed to : address;
  amount : uint;
}

immutable is record {
  owner : address;
}

storage is record {
  total : uint;
  balances : map(address, uint);
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function mint(const to : address; const amount : uint)
  raises Not_owner
is {
  assert(Evm.sender() = immutable.owner, Not_owner);
  storage.balances[to] := storage.balances[to] + amount;
  storage.total := storage.total + amount;
  emit Transfer {
    from = Address.zero;
    to = to;
    amount = amount;
  };
}

external function transfer(const to : address; const amount : uint)
  raises Insufficient_balance
is {
  const from : address := Evm.sender();
  const have : uint := storage.balances[from];
  assert(
    have >= amount,
    Insufficient_balance {
      available = have;
      required = amount;
    }
  );
  storage.balances[from] := have - amount;
  storage.balances[to] := storage.balances[to] + amount;
  emit Transfer {
    from = from;
    to = to;
    amount = amount;
  };
}

external view function balance_of(const who : address) : uint is
  storage.balances[who]

external view function total_supply() : uint is
  storage.total
