(* Benchmark: a minimal token with owner minting. Mirrors token.sol. *)

import "std/address";
import "std/evm";

error NotOwner;

error InsufficientBalance of record {
  available : uint;
  required : uint;
}

event Transfer of record {
  indexed from : address;
  indexed to : address;
  amount : uint;
}

immutable is record {
  owner : address;
}

storage is record {
  total : uint;
  balances : map(address, uint);
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function mint(const to : address; const amount : uint)
  raises NotOwner
is {
  assert(Evm.sender() = immutable.owner, NotOwner);
  storage.balances[to] += amount;
  storage.total += amount;
  emit Transfer {
    from = Address.zero;
    to = to;
    amount = amount;
  };
}

external function transfer(const to : address; const amount : uint)
  raises InsufficientBalance
is {
  const from : address := Evm.sender();
  const have : uint := storage.balances[from];
  assert(
    have >= amount,
    InsufficientBalance {
      available = have;
      required = amount;
    }
  );
  storage.balances[from] := have - amount;
  storage.balances[to] += amount;
  emit Transfer {
    from = from;
    to = to;
    amount = amount;
  };
}

external view function balanceOf(const who : address) : uint is
  storage.balances[who]

external view function totalSupply() : uint is
  storage.total
