(* Benchmark: errors of several shapes, strings and lists among words, each raised from
   more than one place. Mirrors shapes.sol. *)

error Unauthorized of record {
  caller : address;
  role : string;
}
error Out_of_range of record {
  value : uint;
  min : uint;
  max : uint;
}
error Unknown_item of record {
  id : uint;
  name : string;
}
error Bad_items of list(uint);
error Bad_batch of record {
  reason : string;
  ids : list(uint);
}
error Bad_data of bytes;
error Mismatch of record {
  expected : string;
  actual : string;
}

immutable is record {
  owner : address;
}

storage is record {
  items : uint;
  sold : uint;
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function add(const count : uint)
  raises Unauthorized | Out_of_range
is {
  assert(Evm.sender() = immutable.owner, Unauthorized { caller = Evm.sender(); role = "owner"; });
  assert(count > 0 and count <= 10, Out_of_range { value = count; min = 1; max = 10; });
  storage.items := storage.items + count;
}

external function buy(const id : uint; const name : string)
  raises Unknown_item | Out_of_range | Mismatch
is {
  assert(id < storage.items, Unknown_item { id = id; name = name; });
  assert(name.length <= 40, Out_of_range { value = name.length; min = 0; max = 40; });
  assert(name.length > 0, Mismatch { expected = "a name"; actual = name; });
  storage.sold := storage.sold + 1;
}

external function buy_all(const ids : list(uint); const note : string)
  raises Bad_items | Bad_batch | Unknown_item
is {
  assert(ids.length > 0, Bad_batch { reason = note; ids = ids; });
  assert(ids.length <= 4, Bad_batch { reason = "batch too large"; ids = ids; });
  for id : uint in ids do {
    assert(id < storage.items, Bad_items(ids));
  }
  assert(ids[0] > 0, Unknown_item { id = 0; name = note; });
  storage.sold := storage.sold + ids.length;
}

external function load(const data : bytes)
  raises Bad_data | Unauthorized | Bad_items
is {
  assert(Evm.sender() = immutable.owner, Unauthorized { caller = Evm.sender(); role = "loader"; });
  assert(data.length > 0, Bad_data(data));
  assert(data.length <= 64, Bad_items([data.length, 64]));
  storage.sold := storage.sold + data.length;
}

external view function compare(const expected : string; const actual : string) : uint
  raises Mismatch | Bad_data
is {
  assert(expected = actual, Mismatch { expected = expected; actual = actual; });
  assert(expected.length > 0, Bad_data(0xff));
} with expected.length
