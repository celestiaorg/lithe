(* Benchmark: errors of several shapes, strings and lists among words, each raised from
   more than one place. Mirrors shapes.sol. *)

import "std/evm";

error Unauthorized of record {
  caller : address;
  role : string;
}
error OutOfRange of record {
  value : uint;
  min : uint;
  max : uint;
}
error UnknownItem of record {
  id : uint;
  name : string;
}
error BadItems of list(uint);
error BadBatch of record {
  reason : string;
  ids : list(uint);
}
error BadData of bytes;
error Mismatch of record {
  expected : string;
  actual : string;
}

immutable is record {
  owner : address;
}

storage is record {
  items : uint;
  sold : uint;
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function add(const count : uint)
  raises Unauthorized | OutOfRange
is {
  assert(Evm.sender() = immutable.owner, Unauthorized { caller = Evm.sender(); role = "owner"; });
  assert(count > 0 and count <= 10, OutOfRange { value = count; min = 1; max = 10; });
  storage.items += count;
}

external function buy(const id : uint; const name : string)
  raises UnknownItem | OutOfRange | Mismatch
is {
  assert(id < storage.items, UnknownItem { id = id; name = name; });
  assert(name.length <= 40, OutOfRange { value = name.length; min = 0; max = 40; });
  assert(name.length > 0, Mismatch { expected = "a name"; actual = name; });
  storage.sold += 1;
}

external function buyAll(const ids : list(uint); const note : string)
  raises BadItems | BadBatch | UnknownItem
is {
  assert(ids.length > 0, BadBatch { reason = note; ids = ids; });
  assert(ids.length <= 4, BadBatch { reason = "batch too large"; ids = ids; });
  for id : uint in ids do {
    assert(id < storage.items, BadItems(ids));
  }
  assert(ids[0] > 0, UnknownItem { id = 0; name = note; });
  storage.sold += ids.length;
}

external function load(const data : bytes)
  raises BadData | Unauthorized | BadItems
is {
  assert(Evm.sender() = immutable.owner, Unauthorized { caller = Evm.sender(); role = "loader"; });
  assert(data.length > 0, BadData(data));
  assert(data.length <= 64, BadItems([data.length, 64]));
  storage.sold += data.length;
}

external view function compare(const expected : string; const actual : string) : uint
  raises Mismatch | BadData
is {
  assert(expected = actual, Mismatch { expected = expected; actual = actual; });
  assert(expected.length > 0, BadData(0xff));
} with expected.length
