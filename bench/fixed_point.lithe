(* Benchmark: the standard library's fixed-point and integer helpers ported from Solady,
   on runtime arguments. Mirrors fixed_point.sol, which imports Solady's FixedPointMathLib. *)

import "std/math/math";
import "std/math/fixed_point";
import "std/uint";

contract FixedPointBench is {
  use Math;
  use FixedPoint;

  storage is record {
    last : uint;
  }

  external pure function wadMulUp(const a : uint; const b : uint) : uint is
    uint(FixedPoint.wadMulUp(Wad(a), Wad(b)))
  external pure function wadDivUp(const a : uint; const b : uint) : uint is
    uint(FixedPoint.wadDivUp(Wad(a), Wad(b)))
  external pure function divWad(const a : uint; const b : uint) : uint is FixedPoint.divWad(a, Wad(b))
  external pure function sMulWad(const a : int; const b : int) : int is int(FixedPoint.sMulWad(Swad(a), Swad(b)))
  external pure function sDivWad(const a : int; const b : int) : int is int(FixedPoint.sDivWad(Swad(a), Swad(b)))

  external pure function expWad(const x : int) : int
    raises ExpOverflow
  is int(FixedPoint.expWad(Swad(x)))

  external pure function lnWad(const x : int) : int
    raises LnWadUndefined
  is int(FixedPoint.lnWad(Swad(x)))

  external pure function powWad(const x : int; const y : int) : int
    raises LnWadUndefined | ExpOverflow
  is int(FixedPoint.powWad(Swad(x), Swad(y)))

  external pure function sqrtWad(const x : uint) : uint is uint(FixedPoint.sqrtWad(Wad(x)))
  external pure function cbrtWad(const x : uint) : uint is uint(FixedPoint.cbrtWad(Wad(x)))
  external pure function rpow(const x : uint; const n : uint; const base : uint) : uint is FixedPoint.rpow(x, n, base)

  external pure function cbrt(const x : uint) : uint is Math.cbrt(x)
  external pure function dist(const a : uint; const b : uint) : uint is Math.dist(a, b)
  external pure function distInt(const a : int; const b : int) : uint is Math.dist(a, b)
  external pure function gcd(const a : uint; const b : uint) : uint is Math.gcd(a, b)
  external pure function saturatingAdd(const a : uint; const b : uint) : uint is Math.saturatingAdd(a, b)
  external pure function saturatingSub(const a : uint; const b : uint) : uint is Math.saturatingSub(a, b)
  external pure function saturatingMul(const a : uint; const b : uint) : uint is Math.saturatingMul(a, b)

  external pure function lerp(
    const a : uint;
    const b : uint;
    const t : uint;
    const t0 : uint;
    const t1 : uint
  ) : uint is
    Math.lerp(a, b, t, t0, t1)

  external pure function lerpInt(const a : int; const b : int; const t : int; const t0 : int; const t1 : int) : int is
    Math.lerp(a, b, t, t0, t1)

  external function setLast(const x : int) raises ExpOverflow is {
    storage.last := Uint.fromBits(int(FixedPoint.expWad(Swad(x))));
  }
}
