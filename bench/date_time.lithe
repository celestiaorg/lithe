(* Benchmark: a subscription calendar on the standard library's `DateTime`, which ports
   Solady's `DateTimeLib`. A plan starts on a date, renews by months, and reports its
   dates. Mirrors date_time.sol. *)

import "std/utils/date_time";

contract Billing is {
  use DateTime;

  storage is record {
    started : uint;
    renews : uint;
  }

  external function start_on(const year : uint; const month : uint; const day : uint) is {
    const t : uint := uint(DateTime.date_to_timestamp(year, month, day));
    storage.started := t;
    storage.renews := t;
  }

  external function renew(const months : uint) is {
    storage.renews := uint(DateTime.add_months(timestamp(storage.renews), months));
  }

  external function extend(const years : uint) is {
    storage.renews := uint(DateTime.add_years(timestamp(storage.renews), years));
  }

  external view function months_active(const now : uint) : uint is
    DateTime.diff_months(timestamp(storage.started), timestamp(now))

  external view function years_active(const now : uint) : uint is
    DateTime.diff_years(timestamp(storage.started), timestamp(now))

  external view function renewal_date() : (uint, uint, uint) is
    DateTime.timestamp_to_date(timestamp(storage.renews))

  external pure function stamp(
    const year : uint;
    const month : uint;
    const day : uint;
    const hour : uint;
    const minute : uint;
    const second : uint
  ) : uint is
    uint(DateTime.date_time_to_timestamp(year, month, day, hour, minute, second))

  external pure function parts(const t : uint) : (uint, uint, uint, uint, uint, uint) is
    DateTime.timestamp_to_date_time(timestamp(t))

  external pure function weekday_of(const t : uint) : uint is
    DateTime.weekday(timestamp(t))

  external pure function valid(const year : uint; const month : uint; const day : uint) : bool is
    DateTime.is_supported_date(year, month, day)

  external pure function days_in(const year : uint; const month : uint) : uint is
    DateTime.days_in_month(year, month)
}
