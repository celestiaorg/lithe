(* Benchmark: a subscription calendar on the standard library's `DateTime`, which ports
   Solady's `DateTimeLib`. A plan starts on a date, renews by months, and reports its
   dates. Mirrors date_time.sol. *)

import "std/utils/date_time";

contract Billing is {
  use DateTime;

  storage is record {
    started : uint;
    renews : uint;
  }

  external function startOn(const year : uint; const month : uint; const day : uint) is {
    const t : uint := uint(DateTime.dateToTimestamp(year, month, day));
    storage.started := t;
    storage.renews := t;
  }

  external function renew(const months : uint) is {
    storage.renews := uint(DateTime.addMonths(timestamp(storage.renews), months));
  }

  external function extend(const years : uint) is {
    storage.renews := uint(DateTime.addYears(timestamp(storage.renews), years));
  }

  external view function monthsActive(const now : uint) : uint is
    DateTime.diffMonths(timestamp(storage.started), timestamp(now))

  external view function yearsActive(const now : uint) : uint is
    DateTime.diffYears(timestamp(storage.started), timestamp(now))

  external view function renewalDate() : (uint, uint, uint) is
    DateTime.timestampToDate(timestamp(storage.renews))

  external pure function stamp(
    const year : uint;
    const month : uint;
    const day : uint;
    const hour : uint;
    const minute : uint;
    const second : uint
  ) : uint is
    uint(DateTime.dateTimeToTimestamp(year, month, day, hour, minute, second))

  external pure function parts(const t : uint) : (uint, uint, uint, uint, uint, uint) is
    DateTime.timestampToDateTime(timestamp(t))

  external pure function weekdayOf(const t : uint) : uint is
    DateTime.weekday(timestamp(t))

  external pure function valid(const year : uint; const month : uint; const day : uint) : bool is
    DateTime.isSupportedDate(year, month, day)

  external pure function daysIn(const year : uint; const month : uint) : uint is
    DateTime.daysInMonth(year, month)
}
