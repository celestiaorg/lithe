(* Benchmark: a fixed-price exchange whose state-changing calls return values.
   Mirrors exchange.sol. The executor consumes the results in continuations. *)

import "std/evm";

type SwapResult is record {
  amountOut : uint;
  fee : uint;
}

error Slippage of record {
  amountOut : uint;
  minOut : uint;
}

event Swapped of record {
  indexed trader : address;
  amountIn : uint;
  amountOut : uint;
}

storage is record {
  volume : uint;
  fees : uint;
  totalShares : uint;
  shares : map(address, uint);
}

external function swap(const amountIn : uint; const minOut : uint) : SwapResult
  raises Slippage
is {
  const fee : uint := amountIn * 3 / 1000;
  const amountOut : uint := (amountIn - fee) * 2;
  assert(amountOut >= minOut, Slippage { amountOut = amountOut; minOut = minOut; });
  storage.volume += amountIn;
  storage.fees += fee;
  emit Swapped { trader = Evm.sender(); amountIn = amountIn; amountOut = amountOut; };
  const result : SwapResult := { amountOut = amountOut; fee = fee; };
} with result

external function deposit(const amount : uint) : uint is {
  const minted : uint := amount * 10;
  storage.totalShares += minted;
  storage.shares[Evm.sender()] += minted;
} with minted

external function split(const shares : uint) : (uint, uint) is {
  storage.totalShares -= shares;
} with (shares / 3, shares - shares / 3)

external view function sharesOf(const who : address) : uint is storage.shares[who]
