(* Benchmark: the target of dialer's raw calls. Takes a batch of orders, answers their
   ids, and refuses an order with no legs. Mirrors book.sol. *)

type order is record {
  id : uint;
  note : string;
  legs : list(uint);
}

error Rejected of uint;

storage is record {
  notes : map(uint, string);
  placed : uint;
}

external function place(const os : list(order)) : list(uint)
  raises Rejected
is {
  var ids : list(uint) := [];
  for o : order in os do {
    assert(o.legs.length > 0, Rejected(o.id));
    storage.notes[o.id] := o.note;
    List.push(ids, o.id);
  }
  storage.placed := storage.placed + os.length;
} with ids

external view function note_of(const id : uint) : string is
  storage.notes[id]

external view function placed() : uint is
  storage.placed
