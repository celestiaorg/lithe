(* Benchmark: the contract's own balance and the blob base fee. Mirrors env.sol. *)

import "std/evm";

storage is record {
  deposits : uint;
}

external payable function deposit() : wei is {
  storage.deposits += 1;
} with Evm.balance(Evm.self())

(* The base fee is left out: it follows the gas earlier blocks used, which differs by
   build. *)
external view function blobFee() : wei is
  Evm.blobBaseFee()
