(* Benchmark: strings and bytes as map values and list elements. Mirrors names.sol. *)

import "std/evm";
import "std/list";

storage is record {
  names : map(uint, string);
  blobs : map(bytes32, bytes);
  labels : map(address, map(uint, string));
  notes : list(string);
}

external function setName(const id : uint; const n : string) is {
  storage.names[id] := n;
}

external view function name(const id : uint) : string is
  storage.names[id]

external function setBlob(const key : bytes32; const b : bytes) is {
  storage.blobs[key] := b;
}

external view function blob(const key : bytes32) : bytes is
  storage.blobs[key]

external function setLabel(const id : uint; const l : string) is {
  storage.labels[Evm.sender()][id] := l;
}

external view function label(const who : address; const id : uint) : string is
  storage.labels[who][id]

external function addNote(const n : string) is {
  List.push(storage.notes, n);
}

external function setNote(const i : uint; const n : string) is {
  storage.notes[i] := n;
}

external view function note(const i : uint) : string is
  storage.notes[i]

external function setNotes(const a : string; const b : string) is {
  storage.notes := [a, b];
}

external view function noteCopy(const i : uint) : string is {
  const ns : list(string) := storage.notes;
} with ns[i]

external view function notesLength() : uint is {
  var total : uint := 0;
  for n : string in storage.notes bound 8 do {
    total := total + n.length;
  }
} with total
