(* Benchmark: owner-gated counter with an event. Mirrors counter.sol. *)

import "std/evm";

error Not_owner;

immutable is record {
  owner : address;
}

storage is record {
  count : uint;
}

event Count_changed of record {
  old_count : uint;
  new_count : uint;
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function increment(const n : uint) is {
  if n > 0 then {
    const old : uint := storage.count;
    storage.count := old + n;
    emit Count_changed {
      old_count = old;
      new_count = storage.count;
    };
  }
}

external function reset()
  raises Not_owner
is {
  assert(Evm.sender() = immutable.owner, Not_owner);
  const old : uint := storage.count;
  storage.count := 0;
  emit Count_changed {
    old_count = old;
    new_count = 0;
  };
}

external view function get_count() : uint is
  storage.count
