(* Benchmark: owner-gated counter with an event. Mirrors counter.sol. *)

import "std/evm";

error NotOwner;

immutable is record {
  owner : address;
}

storage is record {
  count : uint;
}

event CountChanged of record {
  oldCount : uint;
  newCount : uint;
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function increment(const n : uint) is {
  if n > 0 then {
    const old : uint := storage.count;
    storage.count := old + n;
    emit CountChanged {
      oldCount = old;
      newCount = storage.count;
    };
  }
}

external function reset()
  raises NotOwner
is {
  assert(Evm.sender() = immutable.owner, NotOwner);
  const old : uint := storage.count;
  storage.count := 0;
  emit CountChanged {
    oldCount = old;
    newCount = 0;
  };
}

external view function getCount() : uint is
  storage.count
