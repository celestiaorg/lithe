(* Benchmark: owner-gated counter with an event. Mirrors counter.sol. *)

error Not_owner;

immutable is record {
  owner : address;
}

storage is record {
  count : nat;
}

event Count_changed of record {
  old_count : nat;
  new_count : nat;
}

deploy() is {
  immutable.owner := Evm.sender();
}

external function increment(const n : nat) is {
  if n > 0n then {
    const old : nat := storage.count;
    storage.count := old + n;
    emit Count_changed {
      old_count = old;
      new_count = storage.count;
    };
  }
}

external function reset()
  raises Not_owner
is {
  assert(Evm.sender() = immutable.owner, Not_owner);
  const old : nat := storage.count;
  storage.count := 0n;
  emit Count_changed {
    old_count = old;
    new_count = 0n;
  };
}

external view function get_count() : nat is
  storage.count
