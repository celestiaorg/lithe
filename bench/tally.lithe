(* Benchmark: a module keeps generic tallies in its own namespaced storage and passes
   them to a generic module. Mirrors tally.sol. *)

import "std/evm";

module Tally(K : MapKey) is {
  type Self is record {
    counts : map(K, uint);
    total : uint;
  }

  view function count(storage tally : Self; const key : K) : uint is
    tally.counts[key]

  view function total(storage tally : Self) : uint is
    tally.total

  function add(storage tally : Self; const key : K; const n : uint) is {
    tally.counts[key] += n;
    tally.total += n;
  }
}

module Votes is {
  storage votes at "bench.votes" is record {
    byVoter : Tally(address);
    byTopic : Tally(bytes32);
  }

  error ZeroWeight;

  external function vote(const topic : bytes32; const weight : uint)
    raises ZeroWeight
  is {
    assert(weight > 0, ZeroWeight);
    Tally.add(votes.byVoter, Evm.sender(), weight);
    Tally.add(votes.byTopic, topic, weight);
  }

  external view function votesOf(const voter : address) : uint is
    Tally.count(votes.byVoter, voter)

  external view function votesFor(const topic : bytes32) : uint is
    Tally.count(votes.byTopic, topic)

  external view function totalVotes() : uint is
    Tally.total(votes.byTopic)
}

interface ITally is {
  function vote(topic : bytes32; weight : uint)
    raises ZeroWeight;
  view function votesOf(voter : address) : uint;
  view function votesFor(topic : bytes32) : uint;
  view function totalVotes() : uint;
}

use Votes exposing ITally;
