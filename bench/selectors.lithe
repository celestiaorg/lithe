(* Benchmark: selectors and ERC-165 ids taken from interfaces, as constants. Mirrors
   selectors.sol. *)

import "std/abi";
import "std/interfaces/erc165";

interface Vault is {
  function deposit(amount : uint);
  function withdraw(amount : uint; to : address);
  view function balanceOf(who : address) : uint;
}

interface Token is {
  function transfer(to : address; amount : uint) : bool;
}

error Unrouted of bytes4;

storage is record {
  handled : map(bytes4, uint);
}

external pure function supportsInterface(const interfaceId : bytes4) : bool is
  interfaceId = Abi.interfaceId(Vault) or interfaceId = Abi.interfaceId(IERC165)

(* Counts calls by the method they name, and refuses any other selector. *)
external function handle(const selector : bytes4)
  raises Unrouted
is {
  assert(
    selector = Abi.selector(Vault.deposit)
    or selector = Abi.selector(Vault.withdraw)
    or selector = Abi.selector(Token.transfer),
    Unrouted(selector)
  );
  storage.handled[selector] := storage.handled[selector] + 1;
}

external view function handled(const selector : bytes4) : uint is
  storage.handled[selector]

external pure function transferCall(const to : address; const amount : uint) : bytes is
  Abi.encodeWithSelector(Abi.selector(Token.transfer), to, amount)

external pure function ids() : (bytes4, bytes4, bytes4) is
  (Abi.interfaceId(Vault), Abi.interfaceId(Token), Abi.selector(Vault.balanceOf))
