(* Benchmark: selectors and ERC-165 ids taken from interfaces, as constants. Mirrors
   selectors.sol. *)

import "std/interfaces/erc165.lithe";

interface Vault is {
  function deposit(amount : nat);
  function withdraw(amount : nat; to : address);
  view function balanceOf(who : address) : nat;
}

interface Token is {
  function transfer(to : address; amount : nat) : bool;
}

error Unrouted of bytes4;

storage is record {
  handled : map(bytes4, nat);
}

external pure function supportsInterface(const interfaceId : bytes4) : bool is
  interfaceId = Abi.interface_id(Vault) or interfaceId = Abi.interface_id(IERC165)

(* Counts calls by the method they name, and refuses any other selector. *)
external function handle(const selector : bytes4)
  raises Unrouted
is {
  assert(
    selector = Abi.selector(Vault.deposit)
    or selector = Abi.selector(Vault.withdraw)
    or selector = Abi.selector(Token.transfer),
    Unrouted(selector)
  );
  storage.handled[selector] := storage.handled[selector] + 1n;
}

external view function handled(const selector : bytes4) : nat is
  storage.handled[selector]

external pure function transfer_call(const to : address; const amount : nat) : bytes is
  Abi.encode_with_selector(Abi.selector(Token.transfer), to, amount)

external pure function ids() : (bytes4, bytes4, bytes4) is
  (Abi.interface_id(Vault), Abi.interface_id(Token), Abi.selector(Vault.balanceOf))
