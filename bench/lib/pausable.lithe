(* An emergency stop, like OpenZeppelin's `PausableUpgradeable`. *)

import "std/evm";

error EnforcedPause;

error ExpectedPause;

module Pausable is {
  storage pausable at "openzeppelin.storage.Pausable" is record {
    paused : bool;
  }

  event Paused of record {
    account : address;
  }

  event Unpaused of record {
    account : address;
  }

  external view function paused() : bool is
    pausable.paused

  view function requireNotPaused()
    raises EnforcedPause
  is {
    assert(not pausable.paused, EnforcedPause);
  }

  function pause()
    raises EnforcedPause
  is {
    requireNotPaused();
    pausable.paused := true;
    emit Paused {
      account = Evm.sender();
    };
  }

  function unpause()
    raises ExpectedPause
  is {
    assert(pausable.paused, ExpectedPause);
    pausable.paused := false;
    emit Unpaused {
      account = Evm.sender();
    };
  }
}

interface IPausable is {
  view function paused() : bool;
}
