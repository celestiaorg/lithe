(* Enumeration of every token and of each owner's tokens, like OpenZeppelin's
   `ERC721EnumerableUpgradeable`: same storage, errors, and swap-and-pop removal, so the
   order of the enumerations matches. The contract runs `afterTransfer` from `ERC721`'s
   hook of the same name. *)

import "std/address";
import "std/list";
import "./erc721";

error ERC721OutOfBoundsIndex of record {
  owner : address;
  index : uint;
}

module ERC721Enumerable is {
  requires ERC721;

  storage erc721Enumerable at "openzeppelin.storage.ERC721Enumerable" is record {
    ownedTokens      : map(address, map(uint, uint));
    ownedTokensIndex : map(uint, uint);
    allTokens        : list(uint);
    allTokensIndex   : map(uint, uint);
  }

  external view function totalSupply() : uint is
    storage.erc721Enumerable.allTokens.length

  external view function tokenByIndex(const index : uint) : uint
    raises ERC721OutOfBoundsIndex
  is {
    assert(
      index < storage.erc721Enumerable.allTokens.length,
      ERC721OutOfBoundsIndex { owner = Address.zero; index = index; }
    );
  } with storage.erc721Enumerable.allTokens[index]

  external view function tokenOfOwnerByIndex(const owner : address; const index : uint) : uint
    raises ERC721InvalidOwner | ERC721OutOfBoundsIndex
  is {
    assert(owner <> Address.zero, ERC721InvalidOwner(Address.zero));
    assert(
      index < ERC721.storage.erc721.balances[owner],
      ERC721OutOfBoundsIndex { owner = owner; index = index; }
    );
  } with storage.erc721Enumerable.ownedTokens[owner][index]

  (* After `ERC721.update`: the enumerations follow the token. *)
  function afterTransfer(const from : address; const to : address; const tokenId : uint) is {
    if from = Address.zero then {
      addToAll(tokenId);
    } else if from <> to then {
      removeFromOwner(from, tokenId);
    }
    if to = Address.zero then {
      removeFromAll(tokenId);
    } else if from <> to then {
      addToOwner(to, tokenId);
    }
  }

  function addToOwner(const to : address; const tokenId : uint) is {
    const length : uint := ERC721.storage.erc721.balances[to] - 1;
    storage.erc721Enumerable.ownedTokens[to][length] := tokenId;
    storage.erc721Enumerable.ownedTokensIndex[tokenId] := length;
  }

  function addToAll(const tokenId : uint) is {
    storage.erc721Enumerable.allTokensIndex[tokenId] := storage.erc721Enumerable.allTokens.length;
    List.push(storage.erc721Enumerable.allTokens, tokenId);
  }

  (* The owner's last token moves into the removed token's place. *)
  function removeFromOwner(const from : address; const tokenId : uint) is {
    const lastTokenIndex : uint := ERC721.storage.erc721.balances[from];
    const tokenIndex : uint := storage.erc721Enumerable.ownedTokensIndex[tokenId];
    if tokenIndex <> lastTokenIndex then {
      const lastTokenId : uint := storage.erc721Enumerable.ownedTokens[from][lastTokenIndex];
      storage.erc721Enumerable.ownedTokens[from][tokenIndex] := lastTokenId;
      storage.erc721Enumerable.ownedTokensIndex[lastTokenId] := tokenIndex;
    }
    storage.erc721Enumerable.ownedTokensIndex[tokenId] := 0;
    storage.erc721Enumerable.ownedTokens[from][lastTokenIndex] := 0;
  }

  function removeFromAll(const tokenId : uint) is {
    const lastTokenIndex : uint := storage.erc721Enumerable.allTokens.length - 1;
    const tokenIndex : uint := storage.erc721Enumerable.allTokensIndex[tokenId];
    const lastTokenId : uint := storage.erc721Enumerable.allTokens[lastTokenIndex];
    storage.erc721Enumerable.allTokens[tokenIndex] := lastTokenId;
    storage.erc721Enumerable.allTokensIndex[lastTokenId] := tokenIndex;
    storage.erc721Enumerable.allTokensIndex[tokenId] := 0;
    List.pop(storage.erc721Enumerable.allTokens);
  }
}

interface IERC721Enumerable is {
  view function totalSupply() : uint;
  view function tokenByIndex(index : uint) : uint
    raises ERC721OutOfBoundsIndex;
  view function tokenOfOwnerByIndex(owner : address; index : uint) : uint
    raises ERC721InvalidOwner | ERC721OutOfBoundsIndex;
}
