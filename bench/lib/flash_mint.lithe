(* ERC-3156 flash loans of the token itself, like OpenZeppelin's
   `ERC20FlashMintUpgradeable`, with no fee. The token mints the loan, calls the borrower,
   then spends the borrower's allowance and burns the repayment: it composes those steps
   around its own balance updates. *)

import "std/crypto";
import "std/evm";
import "std/uint";
import "./erc20";

interface ERC3156FlashBorrower is {
  function onFlashLoan(initiator : address; token : address; amount : uint; fee : uint; data : bytes) : bytes32;
}

error ERC3156UnsupportedToken of address;

error ERC3156ExceededMaxLoan of uint;

error ERC3156InvalidReceiver of address;

module ERC20FlashMint is {
  requires ERC20;

  pure function returnValue() : bytes32 is
    Crypto.keccak256("ERC3156FlashBorrower.onFlashLoan")

  view function maxLoan(const token : address) : uint is {
    var most : uint := 0;
    if token = Evm.self() then {
      most := Uint.max - ERC20.erc20.totalSupply;
    }
  } with most

  view function loanFee(const token : address; const value : uint) : uint
    raises ERC3156UnsupportedToken
  is {
    assert(token = Evm.self(), ERC3156UnsupportedToken(token));
  } with 0

  (* The fee for a loan the token can make. *)
  view function checkLoan(const token : address; const value : uint) : uint
    raises ERC3156ExceededMaxLoan | ERC3156UnsupportedToken
  is {
    const most : uint := maxLoan(token);
    assert(value <= most, ERC3156ExceededMaxLoan(most));
  } with loanFee(token, value)

  external view function maxFlashLoan(const token : address) : uint is
    maxLoan(token)

  external view function flashFee(const token : address; const value : uint) : uint
    raises ERC3156UnsupportedToken
  is
    loanFee(token, value)
}

(* IERC3156FlashLender's views. `flashLoan` is the token's own, since it mints and burns
   through the token's balance updates. *)
interface IERC3156FlashLenderViews is {
  view function maxFlashLoan(token : address) : uint;
  view function flashFee(token : address; value : uint) : uint
    raises ERC3156UnsupportedToken;
}
