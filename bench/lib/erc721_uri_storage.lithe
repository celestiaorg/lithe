(* A URI per token, like OpenZeppelin's `ERC721URIStorageUpgradeable`: same storage and
   ERC-4906 event. A token's URI is the base URI with its own suffix, or with its id when
   it has none. *)

import "std/string";
import "std/uint";
import "./erc721";

module ERC721URIStorage is {
  requires ERC721;

  storage erc721URIStorage at "openzeppelin.storage.ERC721URIStorage" is record {
    tokenURIs : map(uint, string);
  }

  event MetadataUpdate of record {
    tokenId : uint;
  }

  function setTokenURI(const tokenId : uint; const uri : string) is {
    erc721URIStorage.tokenURIs[tokenId] := uri;
    emit MetadataUpdate {
      tokenId = tokenId;
    };
  }

  view function tokenURI(const tokenId : uint; const base : string) : string
    raises ERC721NonexistentToken
  is {
    const owner : address := ERC721.requireOwned(tokenId);
    const suffix : string := erc721URIStorage.tokenURIs[tokenId];
    var uri : string := suffix;
    if base.length > 0 then {
      if suffix.length > 0 then {
        uri := String.concat(base, suffix);
      } else {
        uri := String.concat(base, Uint.toString(tokenId));
      }
    }
  } with uri
}
