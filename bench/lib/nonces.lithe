(* Per-account counters for replay protection, like OpenZeppelin's `NoncesUpgradeable`. *)

error InvalidAccountNonce of record {
  account : address;
  currentNonce : uint;
}

module Nonces is {
  storage nonce_state at "openzeppelin.storage.Nonces" is record {
    nonces : map(address, uint);
  }

  external view function nonces(const owner : address) : uint is
    nonce_state.nonces[owner]

  (* Returns the current nonce and moves the counter on. *)
  function use_nonce(const owner : address) : uint is {
    const current : uint := nonce_state.nonces[owner];
    nonce_state.nonces[owner] := current + 1;
  } with current

  function use_checked_nonce(const owner : address; const nonce : uint)
    raises InvalidAccountNonce
  is {
    const current : uint := use_nonce(owner);
    assert(nonce = current, InvalidAccountNonce { account = owner; currentNonce = current; });
  }
}
