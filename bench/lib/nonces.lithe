(* Per-account counters for replay protection, like OpenZeppelin's `NoncesUpgradeable`. *)

error InvalidAccountNonce of record {
  account : address;
  currentNonce : uint;
}

module Nonces is {
  storage nonceState at "openzeppelin.storage.Nonces" is record {
    nonces : map(address, uint);
  }

  external view function nonces(const owner : address) : uint is
    nonceState.nonces[owner]

  (* Returns the current nonce and moves the counter on. *)
  function useNonce(const owner : address) : uint is {
    const current : uint := nonceState.nonces[owner];
    nonceState.nonces[owner] := current + 1;
  } with current

  function useCheckedNonce(const owner : address; const nonce : uint)
    raises InvalidAccountNonce
  is {
    const current : uint := useNonce(owner);
    assert(nonce = current, InvalidAccountNonce { account = owner; currentNonce = current; });
  }
}
