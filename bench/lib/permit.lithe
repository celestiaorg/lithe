(* ERC-2612 approvals by signature, like OpenZeppelin's `ERC20PermitUpgradeable`. *)

import "std/abi";
import "std/crypto";
import "std/evm";
import "std/crypto/ecdsa";
import "./erc20";
import "./eip712";
import "./nonces";

error ERC2612ExpiredSignature of uint;

error ERC2612InvalidSigner of record {
  signer : address;
  owner : address;
}

module ERC20Permit is {
  requires ERC20;
  requires EIP712;
  requires ECDSA;
  requires Nonces;

  external function permit(
    const owner : address;
    const spender : address;
    const value : uint;
    const deadline : uint;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  )
    raises ERC2612ExpiredSignature | ECDSAInvalidSignature | ECDSAInvalidSignatureS | ERC2612InvalidSigner
      | ERC20InvalidApprover | ERC20InvalidSpender
  is {
    assert(uint(Evm.block_timestamp()) <= deadline, ERC2612ExpiredSignature(deadline));
    const struct_hash : bytes32 := Crypto.keccak256(Abi.encode(
      Crypto.keccak256("Permit(address owner,address spender,uint256 value,uint256 nonce,uint256 deadline)"),
      owner,
      spender,
      value,
      Nonces.use_nonce(owner),
      deadline
    ));
    const signer : address := ECDSA.recover(EIP712.hash_typed_data(struct_hash), v, r, s);
    assert(signer = owner, ERC2612InvalidSigner { signer = signer; owner = owner; });
    ERC20.approve_as(owner, spender, value, true);
  }

  external view function nonces(const owner : address) : uint is
    Nonces.nonce_state.nonces[owner]

  external view function DOMAIN_SEPARATOR() : bytes32 is
    EIP712.domain_separator()
}

interface IERC20Permit is {
  function permit(
    owner : address;
    spender : address;
    value : uint;
    deadline : uint;
    v : uint8;
    r : bytes32;
    s : bytes32
  )
    raises ERC2612ExpiredSignature | ECDSAInvalidSignature | ECDSAInvalidSignatureS | ERC2612InvalidSigner
      | ERC20InvalidApprover | ERC20InvalidSpender;
  view function nonces(owner : address) : uint;
  view function DOMAIN_SEPARATOR() : bytes32;
}
