(* Delegated voting power with a history, like OpenZeppelin's `ERC20VotesUpgradeable`: a
   holder's balance counts as votes for whomever it delegates to, and each delegate's
   votes, and the total supply, are checkpointed by block number. The token runs
   `update` from `ERC20`'s `afterTransfer` hook. *)

import "std/abi";
import "std/address";
import "std/crypto";
import "std/evm";
import "std/uint";
import "std/crypto/ecdsa";
import "std/utils/checkpoint";
import "./erc20";
import "./eip712";
import "./nonces";

error ERC20ExceededSafeSupply of record {
  increasedSupply : uint;
  cap : uint;
}

error ERC6372InconsistentClock;

error ERC5805FutureLookup of record {
  timepoint : uint;
  clock : uint48;
}

error VotesExpiredSignature of uint;

module ERC20Votes is {
  requires ERC20;
  requires EIP712;
  requires ECDSA;
  requires Nonces;
  requires Checkpoints;

  storage votes at "openzeppelin.storage.Votes" is record {
    delegatee : map(address, address);
    delegateCheckpoints : map(address, Trace);
    totalCheckpoints : Trace;
  }

  event DelegateChanged of record {
    indexed delegator : address;
    indexed fromDelegate : address;
    indexed toDelegate : address;
  }

  event DelegateVotesChanged of record {
    indexed delegate : address;
    previousVotes : uint;
    newVotes : uint;
  }

  view function timepoint() : uint48 is
    uint48(Evm.blockNumber())

  external view function clock() : uint48 is
    timepoint()

  external view function CLOCK_MODE() : string
    raises ERC6372InconsistentClock
  is {
    assert(timepoint() = uint48(Evm.blockNumber()), ERC6372InconsistentClock);
  } with "mode=blocknumber&from=default"

  view function validateTimepoint(const timepoint : uint) : uint48
    raises ERC5805FutureLookup
  is {
    const current : uint48 := timepoint();
    assert(timepoint < uint(current), ERC5805FutureLookup { timepoint = timepoint; clock = current; });
  } with uint48(timepoint)

  external view function getVotes(const account : address) : uint is
    uint(Checkpoints.latest(votes.delegateCheckpoints[account]))

  external view function getPastVotes(const account : address; const timepoint : uint) : uint
    raises ERC5805FutureLookup
  is
    uint(Checkpoints.upperLookupRecent(votes.delegateCheckpoints[account], validateTimepoint(timepoint)))

  external view function getPastTotalSupply(const timepoint : uint) : uint
    raises ERC5805FutureLookup
  is
    uint(Checkpoints.upperLookupRecent(votes.totalCheckpoints, validateTimepoint(timepoint)))

  external view function delegates(const account : address) : address is
    votes.delegatee[account]

  external view function numCheckpoints(const account : address) : uint32 is
    uint32(Checkpoints.length(votes.delegateCheckpoints[account]))

  external view function checkpoints(const account : address; const pos : uint32) : Checkpoint is
    Checkpoints.at(votes.delegateCheckpoints[account], uint(pos))

  external function delegate(const delegatee : address)
    raises CheckpointUnorderedInsertion
  is {
    delegateAs(Evm.sender(), delegatee);
  }

  external function delegateBySig(
    const delegatee : address;
    const nonce : uint;
    const expiry : uint;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  )
    raises VotesExpiredSignature | ECDSAInvalidSignature | ECDSAInvalidSignatureS | InvalidAccountNonce
      | CheckpointUnorderedInsertion
  is {
    assert(uint(Evm.blockTimestamp()) <= expiry, VotesExpiredSignature(expiry));
    const signer : address := ECDSA.recover(
      EIP712.hashTypedData(Crypto.keccak256(Abi.encode(
        Crypto.keccak256("Delegation(address delegatee,uint256 nonce,uint256 expiry)"),
        delegatee,
        nonce,
        expiry
      ))),
      v,
      r,
      s
    );
    Nonces.useCheckedNonce(signer, nonce);
    delegateAs(signer, delegatee);
  }

  function delegateAs(const account : address; const delegatee : address)
    raises CheckpointUnorderedInsertion
  is {
    const previous : address := votes.delegatee[account];
    votes.delegatee[account] := delegatee;
    emit DelegateChanged {
      delegator = account;
      fromDelegate = previous;
      toDelegate = delegatee;
    };
    moveDelegateVotes(previous, delegatee, ERC20.erc20.balances[account]);
  }

  (* After a balance change: a mint checks the supply still fits a checkpoint, then the
     total and the delegates' votes follow the tokens. *)
  function update(const from : address; const to : address; const value : uint)
    raises ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    if from = Address.zero then {
      const supply : uint := ERC20.erc20.totalSupply;
      const cap : uint208 := Uint.max;
      assert(supply <= uint(cap), ERC20ExceededSafeSupply { increasedSupply = supply; cap = uint(cap); });
      Checkpoints.push(
        votes.totalCheckpoints,
        timepoint(),
        Checkpoints.latest(votes.totalCheckpoints) + uint208(value)
      );
    }
    if to = Address.zero then {
      Checkpoints.push(
        votes.totalCheckpoints,
        timepoint(),
        Checkpoints.latest(votes.totalCheckpoints) - uint208(value)
      );
    }
    moveDelegateVotes(votes.delegatee[from], votes.delegatee[to], value);
  }

  function moveDelegateVotes(const from : address; const to : address; const amount : uint)
    raises CheckpointUnorderedInsertion
  is {
    if from <> to and amount > 0 then {
      if from <> Address.zero then {
        const previous : uint208 := Checkpoints.latest(votes.delegateCheckpoints[from]);
        const next : uint208 := previous - uint208(amount);
        Checkpoints.push(votes.delegateCheckpoints[from], timepoint(), next);
        emit DelegateVotesChanged {
          delegate = from;
          previousVotes = uint(previous);
          newVotes = uint(next);
        };
      }
      if to <> Address.zero then {
        const previous : uint208 := Checkpoints.latest(votes.delegateCheckpoints[to]);
        const next : uint208 := previous + uint208(amount);
        Checkpoints.push(votes.delegateCheckpoints[to], timepoint(), next);
        emit DelegateVotesChanged {
          delegate = to;
          previousVotes = uint(previous);
          newVotes = uint(next);
        };
      }
    }
  }
}

interface IERC6372 is {
  view function clock() : uint48;
  view function CLOCK_MODE() : string
    raises ERC6372InconsistentClock;
}

interface IVotes is {
  view function getVotes(account : address) : uint;
  view function getPastVotes(account : address; timepoint : uint) : uint
    raises ERC5805FutureLookup;
  view function getPastTotalSupply(timepoint : uint) : uint
    raises ERC5805FutureLookup;
  view function delegates(account : address) : address;
  function delegate(delegatee : address)
    raises CheckpointUnorderedInsertion;
  function delegateBySig(delegatee : address; nonce : uint; expiry : uint; v : uint8; r : bytes32; s : bytes32)
    raises VotesExpiredSignature | ECDSAInvalidSignature | ECDSAInvalidSignatureS | InvalidAccountNonce
      | CheckpointUnorderedInsertion;
}

interface IVotesCheckpoints is {
  view function numCheckpoints(account : address) : uint32;
  view function checkpoints(account : address; pos : uint32) : Checkpoint;
}
