(* Single-owner access control, like OpenZeppelin's `OwnableUpgradeable`. *)

import "std/address";
import "std/evm";

error OwnableUnauthorizedAccount of address;

error OwnableInvalidOwner of address;

module Ownable is {
  storage ownable at "openzeppelin.storage.Ownable" is record {
    owner : address;
  }

  event OwnershipTransferred of record {
    indexed previousOwner : address;
    indexed newOwner : address;
  }

  external view function owner() : address is
    ownable.owner

  view function checkOwner()
    raises OwnableUnauthorizedAccount
  is {
    assert(ownable.owner = Evm.sender(), OwnableUnauthorizedAccount(Evm.sender()));
  }

  function init(const initialOwner : address)
    raises OwnableInvalidOwner
  is {
    assert(
      initialOwner <> Address.zero,
      OwnableInvalidOwner(Address.zero)
    );
    setOwner(initialOwner);
  }

  function setOwner(const newOwner : address) is {
    const previous : address := ownable.owner;
    ownable.owner := newOwner;
    emit OwnershipTransferred {
      previousOwner = previous;
      newOwner = newOwner;
    };
  }

  external function transferOwnership(const newOwner : address)
    raises OwnableUnauthorizedAccount | OwnableInvalidOwner
  is {
    checkOwner();
    assert(
      newOwner <> Address.zero,
      OwnableInvalidOwner(Address.zero)
    );
    setOwner(newOwner);
  }

  external function renounceOwnership()
    raises OwnableUnauthorizedAccount
  is {
    checkOwner();
    setOwner(Address.zero);
  }
}

interface IOwnable is {
  view function owner() : address;
  function transferOwnership(newOwner : address)
    raises OwnableUnauthorizedAccount | OwnableInvalidOwner;
  function renounceOwnership()
    raises OwnableUnauthorizedAccount;
}
