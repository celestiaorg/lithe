(* Benchmark: an order executor that consumes call results. Each continuation is a new
   phase after its call returns; the order is marked pending before the exchange runs.
   Mirrors executor.sol, which assigns the results inline. *)

type SwapResult is record {
  amountOut : uint;
  fee : uint;
}

interface Exchange is {
  function swap(amountIn : uint; minOut : uint) : SwapResult;
  function deposit(amount : uint) : uint;
  function split(shares : uint) : (uint, uint);
}

type OrderStatus is
  | New
  | Pending
  | Complete
  | Unwound

type Order is record {
  status : OrderStatus;
  amountIn : uint;
  amountOut : uint;
  shares : uint;
}

error AlreadyExecuted of uint;
error NotComplete of uint;
error TooLittle of record {
  amountOut : uint;
  floor : uint;
}

event Executed of record {
  indexed id : uint;
  amountOut : uint;
  fee : uint;
}

event Deposited of record {
  indexed id : uint;
  shares : uint;
}

immutable is record {
  exchange : Exchange;
  floor : uint;
}

storage is record {
  executed : uint;
  totalOut : uint;
  left : uint;
  right : uint;
  orders : map(uint, Order);
}

deploy(const exchange : Exchange; const floor : uint) is {
  immutable.exchange := exchange;
  immutable.floor := floor;
}

external function execute(const id : uint; const amountIn : uint; const minOut : uint)
  raises AlreadyExecuted | TooLittle
is {
  assert(storage.orders[id].status = New, AlreadyExecuted(id));
  storage.orders[id].status := Pending;
  storage.orders[id].amountIn := amountIn;
  defer immutable.exchange.swap(amountIn, minOut)
    then (result : SwapResult) {
      assert(
        result.amountOut >= immutable.floor,
        TooLittle { amountOut = result.amountOut; floor = immutable.floor; }
      );
      storage.orders[id].status := Complete;
      storage.orders[id].amountOut := result.amountOut;
      storage.executed += 1;
      storage.totalOut += result.amountOut;
      emit Executed { id = id; amountOut = result.amountOut; fee = result.fee; };
    };
}

external function executeAndDeposit(const id : uint; const amountIn : uint)
  raises AlreadyExecuted | TooLittle
is {
  assert(storage.orders[id].status = New, AlreadyExecuted(id));
  storage.orders[id].status := Pending;
  storage.orders[id].amountIn := amountIn;
  defer immutable.exchange.swap(amountIn, 0)
    then (result : SwapResult) {
      storage.orders[id].status := Complete;
      storage.orders[id].amountOut := result.amountOut;
      defer immutable.exchange.deposit(result.amountOut)
        then (shares : uint) {
          storage.orders[id].shares := shares;
          emit Deposited { id = id; shares = shares; };
        };
    };
}

external function unwind(const id : uint)
  raises NotComplete
is {
  assert(storage.orders[id].status = Complete, NotComplete(id));
  defer immutable.exchange.split(storage.orders[id].shares)
    then ((a, b) : (uint, uint)) {
      storage.orders[id].status := Unwound;
      storage.left += a;
      storage.right += b;
    };
}

external view function orderOf(const id : uint) : Order is storage.orders[id]
