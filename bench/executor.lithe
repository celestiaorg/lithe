(* Benchmark: an order executor that consumes call results. Each continuation is a new
   phase after its call returns; the order is marked pending before the exchange runs.
   Mirrors executor.sol, which assigns the results inline. *)

type swap_result is record {
  amount_out : uint;
  fee : uint;
}

interface Exchange is {
  function swap(amount_in : uint; min_out : uint) : swap_result;
  function deposit(amount : uint) : uint;
  function split(shares : uint) : (uint, uint);
}

type order_status is
  | New
  | Pending
  | Complete
  | Unwound

type order is record {
  status : order_status;
  amount_in : uint;
  amount_out : uint;
  shares : uint;
}

error AlreadyExecuted of uint;
error NotComplete of uint;
error TooLittle of record {
  amount_out : uint;
  floor : uint;
}

event Executed of record {
  indexed id : uint;
  amount_out : uint;
  fee : uint;
}

event Deposited of record {
  indexed id : uint;
  shares : uint;
}

immutable is record {
  exchange : Exchange;
  floor : uint;
}

storage is record {
  executed : uint;
  total_out : uint;
  left : uint;
  right : uint;
  orders : map(uint, order);
}

deploy(const exchange : Exchange; const floor : uint) is {
  immutable.exchange := exchange;
  immutable.floor := floor;
}

external function execute(const id : uint; const amount_in : uint; const min_out : uint)
  raises AlreadyExecuted | TooLittle
is {
  assert(storage.orders[id].status = New, AlreadyExecuted(id));
  storage.orders[id].status := Pending;
  storage.orders[id].amount_in := amount_in;
  defer immutable.exchange.swap(amount_in, min_out)
    then (result : swap_result) {
      assert(
        result.amount_out >= immutable.floor,
        TooLittle { amount_out = result.amount_out; floor = immutable.floor; }
      );
      storage.orders[id].status := Complete;
      storage.orders[id].amount_out := result.amount_out;
      storage.executed := storage.executed + 1;
      storage.total_out := storage.total_out + result.amount_out;
      emit Executed { id = id; amount_out = result.amount_out; fee = result.fee; };
    };
}

external function execute_and_deposit(const id : uint; const amount_in : uint)
  raises AlreadyExecuted | TooLittle
is {
  assert(storage.orders[id].status = New, AlreadyExecuted(id));
  storage.orders[id].status := Pending;
  storage.orders[id].amount_in := amount_in;
  defer immutable.exchange.swap(amount_in, 0)
    then (result : swap_result) {
      storage.orders[id].status := Complete;
      storage.orders[id].amount_out := result.amount_out;
      defer immutable.exchange.deposit(result.amount_out)
        then (shares : uint) {
          storage.orders[id].shares := shares;
          emit Deposited { id = id; shares = shares; };
        };
    };
}

external function unwind(const id : uint)
  raises NotComplete
is {
  assert(storage.orders[id].status = Complete, NotComplete(id));
  defer immutable.exchange.split(storage.orders[id].shares)
    then ((a, b) : (uint, uint)) {
      storage.orders[id].status := Unwound;
      storage.left := storage.left + a;
      storage.right := storage.right + b;
    };
}

external view function order_of(const id : uint) : order is storage.orders[id]
