(* Benchmark: OpenZeppelin's wizard token with every common add-on, upgradeable: burnable,
   pausable, role-gated minting and pausing, capped, permits, votes, and flash mints,
   built from modules. Mirrors erc20_full.sol, which imports OpenZeppelin. *)

import "std/crypto";
import "std/address";
import "std/evm";
import "std/crypto/ecdsa";
import "std/math/math";
import "std/utils/checkpoint";
import "./lib/initializable";
import "./lib/access_control";
import "./lib/pausable";
import "./lib/erc20";
import "./lib/capped";
import "./lib/eip712";
import "./lib/nonces";
import "./lib/permit";
import "./lib/votes";
import "./lib/flash_mint";

contract BenchGovernanceToken is {
  use Initializable;
  use ECDSA;
  use Math;
  use Checkpoints;
  use Nonces;

  use ERC20 exposing IERC20Views, IERC20Metadata;
  use AccessControl exposing IAccessControl;
  use Pausable exposing IPausable;
  use ERC20Capped exposing IERC20Capped;
  use EIP712 exposing IERC5267;
  use ERC20Permit exposing IERC20Permit;
  use ERC20Votes exposing IERC6372, IVotes, IVotesCheckpoints;
  use ERC20FlashMint exposing IERC3156FlashLenderViews;

  supports IAccessControl;

  pure function pauser_role() : bytes32 is
    Crypto.keccak256("PAUSER_ROLE")

  pure function minter_role() : bytes32 is
    Crypto.keccak256("MINTER_ROLE")

  external pure function DEFAULT_ADMIN_ROLE() : bytes32 is
    AccessControl.default_admin_role()

  external pure function PAUSER_ROLE() : bytes32 is
    pauser_role()

  external pure function MINTER_ROLE() : bytes32 is
    minter_role()

  (* Initializable's bookkeeping matches the `initializer` modifier on Solidity's
     constructor, so storage and events stay the same. *)
  deploy(const defaultAdmin : address; const pauser : address; const minter : address)
    raises InvalidInitialization | ERC20InvalidCap
  is {
    Initializable.begin();
    ERC20.init("Bench Governance Token", "BGOV");
    ERC20Capped.init(1_000_000 * 10 ** 18);
    EIP712.init("Bench Governance Token", "1");
    AccessControl.grant(AccessControl.default_admin_role(), defaultAdmin);
    AccessControl.grant(pauser_role(), pauser);
    AccessControl.grant(minter_role(), minter);
    Initializable.finish();
  }

  (* Every balance change: the pause, the move, the cap on a mint, then the votes. *)
  hook ERC20.before_transfer is Pausable.require_not_paused;

  hook ERC20.after_transfer(const from : address; const to : address; const value : uint)
    raises ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    if from = Address.zero then {
      ERC20Capped.check_cap(ERC20.erc20.totalSupply);
    }
    ERC20Votes.update(from, to, value);
  }

  function mint_to(const to : address; const value : uint)
    raises ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
      | CheckpointUnorderedInsertion
  is {
    assert(to <> Address.zero, ERC20InvalidReceiver(Address.zero));
    ERC20.update(Address.zero, to, value);
  }

  function burn_from(const account : address; const value : uint)
    raises ERC20InvalidSender | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
      | CheckpointUnorderedInsertion
  is {
    assert(account <> Address.zero, ERC20InvalidSender(Address.zero));
    ERC20.update(account, Address.zero, value);
  }

  external function transfer(const to : address; const value : uint) : bool
    raises ERC20InvalidSender | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap
      | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    ERC20.check_transfer(Evm.sender(), to);
    ERC20.update(Evm.sender(), to, value);
  } with true

  external function approve(const spender : address; const value : uint) : bool
    raises ERC20InvalidApprover | ERC20InvalidSpender
  is {
    ERC20.approve_as(Evm.sender(), spender, value, true);
  } with true

  external function transferFrom(const from : address; const to : address; const value : uint) : bool
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
      | CheckpointUnorderedInsertion
  is {
    ERC20.spend_allowance(from, Evm.sender(), value);
    ERC20.check_transfer(from, to);
    ERC20.update(from, to, value);
  } with true

  external function burn(const value : uint)
    raises ERC20InvalidSender | EnforcedPause | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply
      | CheckpointUnorderedInsertion
  is {
    burn_from(Evm.sender(), value);
  }

  external function burnFrom(const account : address; const value : uint)
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender | EnforcedPause
      | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    ERC20.spend_allowance(account, Evm.sender(), value);
    burn_from(account, value);
  }

  external function mint(const to : address; const amount : uint)
    raises AccessControlUnauthorizedAccount | ERC20InvalidReceiver | EnforcedPause | ERC20InsufficientBalance
      | ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    AccessControl.check_role(minter_role());
    mint_to(to, amount);
  }

  external function pause()
    raises AccessControlUnauthorizedAccount | EnforcedPause
  is {
    AccessControl.check_role(pauser_role());
    Pausable.pause();
  }

  external function unpause()
    raises AccessControlUnauthorizedAccount | ExpectedPause
  is {
    AccessControl.check_role(pauser_role());
    Pausable.unpause();
  }

  (* The loan is minted before the borrower runs, and repaid from its allowance after. A
     borrower's failure passes through unchanged, as Solidity's call passes it on. *)
  external function flashLoan(
    const receiver : ERC3156FlashBorrower;
    const token : address;
    const value : uint;
    const data : bytes
  ) : bool
    raises ERC3156ExceededMaxLoan | ERC3156UnsupportedToken | ERC3156InvalidReceiver | ERC20InsufficientAllowance
      | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidReceiver | ERC20InvalidSender | EnforcedPause
      | ERC20InsufficientBalance | ERC20ExceededCap | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion | forwarded
  is {
    const fee : uint := ERC20FlashMint.check_loan(token, value);
    mint_to(address(receiver), value);
    defer receiver.onFlashLoan(Evm.sender(), token, value, fee, data) then {
      | Ok(answer : bytes32) -> {
          assert(answer = ERC20FlashMint.return_value(), ERC3156InvalidReceiver(address(receiver)));
          ERC20.spend_allowance(address(receiver), Evm.self(), value + fee);
          burn_from(address(receiver), value + fee);
        }
      | Error(reason : bytes) -> {
          forward reason;
        }
    };
  } with true
}
