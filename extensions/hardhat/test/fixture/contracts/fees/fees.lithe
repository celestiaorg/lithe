error FeeTooHigh of uint;

storage is record {
  owner : address;
  feeBps : uint;
}

event Configured of record {
  indexed owner : address;
  feeBps : uint;
}

deploy(const owner : address; const feeBps : uint)
  raises FeeTooHigh
is {
  assert(feeBps <= 1000, FeeTooHigh(feeBps));
  storage.owner := owner;
  storage.feeBps := feeBps;
  emit Configured {
    owner = owner;
    feeBps = feeBps;
  };
}

external view function owner() : address is
  storage.owner
