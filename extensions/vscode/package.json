{
  "name": "lithe",
  "displayName": "Lithe",
  "description": "Syntax highlighting for Lithe",
  "version": "0.1.0",
  "publisher": "lithe",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "lithe",
        "aliases": ["Lithe", "lithe"],
        "extensions": [".lithe"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lithe",
        "scopeName": "source.lithe",
        "path": "./syntaxes/lithe.tmLanguage.json"
      }
    ]
  }
}
