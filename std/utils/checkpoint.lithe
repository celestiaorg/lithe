(* A history of values, each from a key onward: a block number or a timestamp. Pushes
   come in key order, so the history is sorted, and a lookup finds the value as of a
   key by binary search. A `trace` is laid out as OpenZeppelin's `Checkpoints.Trace208`:
   a list of checkpoints, each a `uint48` key and a `uint208` value in one slot.

     storage is record {
       supply : trace;
       votes : map(address, trace);
     }

     Checkpoints.push(storage.supply, uint48(Evm.block_number()), uint208(total));
     const then : uint208 := Checkpoints.upper_lookup(storage.votes[account], uint48(block)); *)

import "std/math/math.lithe";

error CheckpointUnorderedInsertion;

type checkpoint is record {
  key : uint48;
  value : uint208;
}

module Checkpoints is {
  requires Math;

  type trace is record {
    checkpoints : list(checkpoint);
  }

  view function length(storage history : trace) : nat is
    history.checkpoints.length

  (* Panics past the end, as a list index does. *)
  view function at(storage history : trace; const index : nat) : checkpoint is
    history.checkpoints[index]

  (* The newest value, or zero before the first push. *)
  view function latest(storage history : trace) : uint208 is {
    const count : nat := history.checkpoints.length;
    var value : uint208 := 0;
    if count > 0n then {
      value := history.checkpoints[count - 1n].value;
    }
  } with value

  (* Records `value` from `key` on. A second push at the newest key replaces its value. *)
  function push(storage history : trace; const key : uint48; const value : uint208)
    raises CheckpointUnorderedInsertion
  is {
    const count : nat := history.checkpoints.length;
    var replace : bool := false;
    if count > 0n then {
      const last : checkpoint := history.checkpoints[count - 1n];
      assert(last.key <= key, CheckpointUnorderedInsertion);
      replace := last.key = key;
    }
    if replace then {
      history.checkpoints[count - 1n].value := value;
    } else {
      List.push(history.checkpoints, { key = key; value = value; });
    }
  }

  (* The first checkpoint in `[low, high)` after `key`, or `high`. The halving ends
     within 256 steps for any count. *)
  view function upper_search(storage history : trace; const key : uint48; const low : nat; const high : nat) : nat is {
    var lo : nat := low;
    var hi : nat := high;
    for _ : nat in 0n .. 256n until lo = hi do {
      const mid : nat := (lo + hi) / 2n;
      if history.checkpoints[mid].key > key then {
        hi := mid;
      } else {
        lo := mid + 1n;
      }
    }
  } with hi

  (* The value as of `key`: that of the last checkpoint at or before it, or zero if there
     is none. *)
  view function upper_lookup(storage history : trace; const key : uint48) : uint208 is {
    const pos : nat := upper_search(history, key, 0n, history.checkpoints.length);
    var value : uint208 := 0;
    if pos > 0n then {
      value := history.checkpoints[pos - 1n].value;
    }
  } with value

  (* `upper_lookup` for a key that is likely recent: it first checks the last square root
     of the history, then searches only the part the key is in. *)
  view function upper_lookup_recent(storage history : trace; const key : uint48) : uint208 is {
    const count : nat := history.checkpoints.length;
    var low : nat := 0n;
    var high : nat := count;
    if count > 5n then {
      const mid : nat := count - Math.sqrt(count);
      if key < history.checkpoints[mid].key then {
        high := mid;
      } else {
        low := mid + 1n;
      }
    }
    const pos : nat := upper_search(history, key, low, high);
    var value : uint208 := 0;
    if pos > 0n then {
      value := history.checkpoints[pos - 1n].value;
    }
  } with value
}
