(* ERC-1167 minimal proxies: clones that delegate every call to one implementation,
   matching OpenZeppelin's `Clones`. `code` is a clone's creation code:

     defer create(Clones.code(implementation)) then (instance : address) { ... };

   `codeWithArgs` appends immutable arguments after the clone's code, where `argsOf`
   reads them back. The deterministic forms create with `CREATE2` and answer where the
   clone lands. *)

import "std/bytes";
import "std/crypto";
import "std/evm";
import "std/utils/create2";

error CloneArgumentsTooLong;

module Clones is {
  requires Create2;

  pure function code(const implementation : address) : bytes is
    Bytes.concat(0x3d602d80600a3d3981f3363d3d373d3d3d363d73, bytes20(implementation), 0x5af43d82803e903d91602b57fd5bf3)

  (* A clone's code is 45 bytes, and the arguments must fit after it. *)
  pure function codeWithArgs(const implementation : address; const args : bytes) : bytes
    raises CloneArgumentsTooLong
  is {
    assert(args.length <= 24531, CloneArgumentsTooLong);
  } with Bytes.concat(
    0x61,
    bytes2(uint16(args.length + 45)),
    0x3d81600a3d39f3363d3d373d3d3d363d73,
    bytes20(implementation),
    0x5af43d82803e903d91602b57fd5bf3,
    args
  )

  (* Raises `FailedDeployment` if the clone is already there. *)
  function cloneDeterministic(const implementation : address; const salt : bytes32) : address
    raises FailedDeployment
  is cloneDeterministic(implementation, salt, 0)

  function cloneDeterministic(const implementation : address; const salt : bytes32; const value : uint) : address
    raises FailedDeployment
  is {
    defer create(code(implementation)) with { value = value; salt = salt; } then {
      | Ok(_) -> { skip }
      | Error(_) -> { fail FailedDeployment; }
    };
  } with predictHere(implementation, salt)

  function cloneDeterministicWithArgs(
    const implementation : address;
    const args : bytes;
    const salt : bytes32
  ) : address
    raises CloneArgumentsTooLong | FailedDeployment
  is cloneDeterministicWithArgs(implementation, args, salt, 0)

  function cloneDeterministicWithArgs(
    const implementation : address;
    const args : bytes;
    const salt : bytes32;
    const value : uint
  ) : address
    raises CloneArgumentsTooLong | FailedDeployment
  is {
    const init : bytes := codeWithArgs(implementation, args);
    defer create(init) with { value = value; salt = salt; } then {
      | Ok(_) -> { skip }
      | Error(_) -> { fail FailedDeployment; }
    };
  } with Create2.computeAddressHere(salt, Crypto.keccak256(init))

  pure function predict(const implementation : address; const salt : bytes32; const deployer : address) : address is
    Create2.computeAddress(salt, Crypto.keccak256(code(implementation)), deployer)

  view function predictHere(const implementation : address; const salt : bytes32) : address is
    predict(implementation, salt, Evm.self())

  pure function predictWithArgs(
    const implementation : address;
    const args : bytes;
    const salt : bytes32;
    const deployer : address
  ) : address
    raises CloneArgumentsTooLong
  is Create2.computeAddress(salt, Crypto.keccak256(codeWithArgs(implementation, args)), deployer)

  (* The arguments a clone was created with; empty for a clone without them. *)
  view function argsOf(const instance : address) : bytes is
    Evm.code(instance)[45:]
}
