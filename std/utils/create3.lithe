(* Addresses that depend only on the deployer and a salt, not on the creation code,
   matching Solady's `CREATE3`. A `CREATE2` makes a small proxy at a salted address,
   and the proxy creates the contract with its first `CREATE`. *)

import "std/abi";
import "std/crypto";
import "std/evm";
import "std/utils/create2";

module Create3 is {
  requires Create2;

  (* The hash of the proxy's creation code. *)
  pure function proxyCodeHash() : bytes32 is
    Crypto.keccak256(0x67363d3d37363d34f03d5260086018f3)

  (* Creates `code`, and answers its address. Raises `FailedDeployment` if the salt was
     used before or the creation fails. *)
  function deployDeterministic(const code : bytes; const salt : bytes32) : address
    raises FailedDeployment
  is deployDeterministic(code, salt, 0)

  (* The same, sending `value` wei to the new contract. *)
  function deployDeterministic(const code : bytes; const salt : bytes32; const value : uint) : address
    raises FailedDeployment
  is {
    const deployed : address := predict(salt, Evm.self());
    defer create(0x67363d3d37363d34f03d5260086018f3) with salt = salt then {
      | Ok(proxy : address) -> {
          defer Evm.call(proxy, code) with value = value then {
            assert(Evm.codeSize(deployed) > 0, FailedDeployment);
          };
        }
      | Error(_) -> { fail FailedDeployment; }
    };
  } with deployed

  (* The proxy's address, then the address of the proxy's first creation. *)
  pure function predict(const salt : bytes32; const deployer : address) : address is {
    const proxy : address := Create2.computeAddress(salt, proxyCodeHash(), deployer);
    const prefix : bytes2 := 0xd694;
    const nonce : bytes1 := 0x01;
    const hash : bytes32 := Crypto.keccak256(Abi.encodePacked(prefix, proxy, nonce));
  } with address(uint160(uint(hash) & ((1 << 160) - 1)))

  view function predictHere(const salt : bytes32) : address is
    predict(salt, Evm.self())
}
