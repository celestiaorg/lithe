(* CREATE2 addresses: where `defer create C() with salt = s` lands, given the hash of C's
   creation code, arguments included. *)

import "std/abi";
import "std/crypto";
import "std/evm";

error FailedDeployment;

module Create2 is {
  pure function computeAddress(
    const salt : bytes32;
    const initCodeHash : bytes32;
    const deployer : address
  ) : address is {
    const marker : bytes1 := 0xff;
    const hash : bytes32 := Crypto.keccak256(Abi.encodePacked(marker, deployer, salt, initCodeHash));
  } with address(uint160(uint(hash) & ((1 << 160) - 1)))

  (* Where this contract would create it. *)
  view function computeAddressHere(const salt : bytes32; const initCodeHash : bytes32) : address is
    computeAddress(salt, initCodeHash, Evm.self())
}
