(* ERC-1967 proxies, as OpenZeppelin 5.0.2's `ERC1967Proxy` makes them, for an upgradeable
   contract's implementation. `code` is a proxy's creation code: its constructor stores the
   implementation and calls it with `data`, so an upgradeable Lithe contract's `deploy`
   runs inside the proxy's creation:

     defer create(ERC1967Proxy.code(implementation, Abi.encodeCall(I.deploy, ...)));

   The data is part of the creation code, so a `CREATE2` address depends on it; create
   with `Create3` for an address that depends only on the salt. *)

import "std/abi";
import "std/bytes";

module ERC1967Proxy is {
  (* The proxy's creation code, before its arguments: the `bytecode` of the
     `@openzeppelin/contracts@5.0.2` package's `build/contracts/ERC1967Proxy.json`. *)
  pure function creationCode() : bytes is
    Bytes.concat(
      0x608060405260405161040a38038061040a83398101604081905261002291610268565b61002c8282610033565b5050610352565b,
      0x61003c82610092565b6040516001600160a01b038316907fbc7cd75a20ee27fd9adebab32041f755214dbc6bffa90cc0225b39da,
      0x2e5c2d3b90600090a280511561008657610081828261010e565b505050565b61008e610185565b5050565b806001600160a01b03,
      0x163b6000036100cd57604051634c9c8ce360e01b81526001600160a01b03821660048201526024015b60405180910390fd5b7f36,
      0x0894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc80546001600160a01b0319166001600160a01b0392,
      0x909216919091179055565b6060600080846001600160a01b03168460405161012b9190610336565b600060405180830381855af4,
      0x9150503d8060008114610166576040519150601f19603f3d011682016040523d82523d6000602084013e61016b565b606091505b,
      0x50909250905061017c8583836101a6565b95945050505050565b34156101a45760405163b398979f60e01b815260040160405180,
      0x910390fd5b565b6060826101bb576101b682610205565b6101fe565b81511580156101d257506001600160a01b0384163b155b15,
      0x6101fb57604051639996b31560e01b81526001600160a01b03851660048201526024016100c4565b50805b9392505050565b8051,
      0x156102155780518082602001fd5b604051630a12f52160e11b815260040160405180910390fd5b634e487b7160e01b6000526041,
      0x60045260246000fd5b60005b8381101561025f578181015183820152602001610247565b50506000910152565b60008060408385,
      0x03121561027b57600080fd5b82516001600160a01b038116811461029257600080fd5b60208401519092506001600160401b0380,
      0x8211156102af57600080fd5b818501915085601f8301126102c357600080fd5b8151818111156102d5576102d561022e565b6040,
      0x51601f8201601f19908116603f011681019083821181831017156102fd576102fd61022e565b8160405282815288602084870101,
      0x111561031657600080fd5b610327836020830160208801610244565b80955050505050509250929050565b600082516103488184,
      0x60208701610244565b9190910192915050565b60aa806103606000396000f3fe6080604052600a600c565b005b60186014601a56,
      0x5b6051565b565b6000604c7f360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc546001600160a01b,
      0x031690565b905090565b3660008037600080366000845af43d6000803e808015606f573d6000f35b3d6000fdfea2646970667358,
      0x22122067631f2999302c060f07436abddfd851a804c5b3f66ce15f7498cf4904e82b7664736f6c63430008140033
    )

  pure function code(const implementation : address; const data : bytes) : bytes is
    Bytes.concat(creationCode(), Abi.encode(implementation, data))
}
