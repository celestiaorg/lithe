(* Per-account counters that only move forward, for replay protection: each signed
   message names the next nonce, and using it moves the counter on. Matches
   OpenZeppelin's `Nonces`.

     use Nonces exposing {
       view function nonces(owner : address) : uint;
     } *)

error InvalidAccountNonce of record {
  account : address;
  currentNonce : uint;
}

module Nonces is {
  storage nonce_state at "lithe.std.nonces" is record {
    counts : map(address, uint);
  }

  view function nonces(const owner : address) : uint is
    nonce_state.counts[owner]

  external view function nonces(const owner : address) : uint is
    nonce_state.counts[owner]

  (* Returns the current nonce and moves the counter on. *)
  function use_nonce(const owner : address) : uint is {
    const current : uint := nonce_state.counts[owner];
    nonce_state.counts[owner] := current + 1;
  } with current

  (* Like `use_nonce`, when the caller names the nonce it expects. *)
  function use_checked_nonce(const owner : address; const nonce : uint)
    raises InvalidAccountNonce
  is {
    const current : uint := use_nonce(owner);
    assert(current = nonce, InvalidAccountNonce { account = owner; currentNonce = current; });
  }
}
