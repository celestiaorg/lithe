(* ABI encoding and decoding. Usable in any function, `pure` ones included. *)

module Abi is {
  (* encode(a; b; ...) : bytes
     `abi.encode(a, b, ...)`: any ABI values, each one argument. *)
  intrinsic encode;

  (* decode(data : bytes; T) : T
     `abi.decode(data, (T))`: the second argument is a type name, or a tuple of them. *)
  intrinsic decode;

  (* encodePacked(a; b; ...) : bytes
     `abi.encodePacked(a, b, ...)`: words, strings, bytes, and lists of words. *)
  intrinsic encodePacked;

  (* encodeWithSelector(sel : bytes4; a; ...) : bytes
     `abi.encodeWithSelector(sel, a, ...)`. *)
  intrinsic encodeWithSelector;

  (* encodeWithSignature(sig : string; a; ...) : bytes
     `abi.encodeWithSignature(sig, a, ...)`. *)
  intrinsic encodeWithSignature;

  (* encodeCall(I.method; a; ...) : bytes
     `abi.encodeCall(I.method, (a, ...))`, for an interface method: the arguments are
     checked against it. *)
  intrinsic encodeCall;

  (* selector(I.method) : bytes4
     `I.method.selector`, for an interface method: a constant `bytes4`. *)
  intrinsic selector;

  (* interfaceId(I) : bytes4
     `type(I).interfaceId`: the XOR of the interface's selectors, a constant `bytes4`. *)
  intrinsic interfaceId;

  (* Whether `id` is ERC-165's or one the contract's `supports` lists, as the generated
     `supportsInterface` answers. *)
  intrinsic pure function supportsInterface(id : bytes4) : bool;
}
