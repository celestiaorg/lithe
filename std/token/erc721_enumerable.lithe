(* Enumeration of every token and of each owner's tokens: ERC-721's enumeration extension,
   like OpenZeppelin's `ERC721Enumerable`. A removed token's place goes to the last token,
   so enumerations are unordered.

   The lists follow every ownership change, through `ERC721`'s `afterTransfer` hook, which
   the contract points here, or calls this from its own body with what else it runs after a
   transfer:

     use ERC721 exposing IERC721, IERC721Metadata with {
       hook beforeTransfer is skip;
       hook afterTransfer is ERC721Enumerable.afterTransfer;
     }
     use ERC721Enumerable exposing IERC721Enumerable; *)

import "std/address";
import "std/list";
import "std/token/erc721";
import "std/interfaces/erc721";

module ERC721Enumerable is {
  requires ERC721;

  storage erc721Enumerable at "lithe.std.erc721.enumerable" is record {
    ownedTokens : map(address, map(uint, uint));
    ownedTokensIndex : map(uint, uint);
    allTokens : list(uint);
    allTokensIndex : map(uint, uint);
  }

  (* After `ERC721` moves, mints, or burns a token: the enumerations follow it. *)
  function afterTransfer(const from : address; const to : address; const tokenId : uint) is {
    if from = Address.zero then {
      addToAll(tokenId);
    } else if from <> to then {
      removeFromOwner(from, tokenId);
    }
    if to = Address.zero then {
      removeFromAll(tokenId);
    } else if from <> to then {
      addToOwner(to, tokenId);
    }
  }

  function addToOwner(const to : address; const tokenId : uint) is {
    const length : uint := ERC721.storage.erc721.balances[to] - 1;
    storage.erc721Enumerable.ownedTokens[to][length] := tokenId;
    storage.erc721Enumerable.ownedTokensIndex[tokenId] := length;
  }

  function addToAll(const tokenId : uint) is {
    storage.erc721Enumerable.allTokensIndex[tokenId] := storage.erc721Enumerable.allTokens.length;
    List.push(storage.erc721Enumerable.allTokens, tokenId);
  }

  function removeFromOwner(const from : address; const tokenId : uint) is {
    const lastIndex : uint := ERC721.storage.erc721.balances[from];
    const index : uint := storage.erc721Enumerable.ownedTokensIndex[tokenId];
    if index <> lastIndex then {
      const lastId : uint := storage.erc721Enumerable.ownedTokens[from][lastIndex];
      storage.erc721Enumerable.ownedTokens[from][index] := lastId;
      storage.erc721Enumerable.ownedTokensIndex[lastId] := index;
    }
    storage.erc721Enumerable.ownedTokensIndex[tokenId] := 0;
    storage.erc721Enumerable.ownedTokens[from][lastIndex] := 0;
  }

  function removeFromAll(const tokenId : uint) is {
    const lastIndex : uint := storage.erc721Enumerable.allTokens.length - 1;
    const index : uint := storage.erc721Enumerable.allTokensIndex[tokenId];
    const lastId : uint := storage.erc721Enumerable.allTokens[lastIndex];
    storage.erc721Enumerable.allTokens[index] := lastId;
    storage.erc721Enumerable.allTokensIndex[lastId] := index;
    storage.erc721Enumerable.allTokensIndex[tokenId] := 0;
    List.pop(storage.erc721Enumerable.allTokens);
  }

  external view function totalSupply() : uint is
    storage.erc721Enumerable.allTokens.length

  external view function tokenByIndex(const index : uint) : uint
    raises ERC721OutOfBoundsIndex
  is {
    assert(
      index < storage.erc721Enumerable.allTokens.length,
      ERC721OutOfBoundsIndex { owner = Address.zero; index = index; }
    );
  } with storage.erc721Enumerable.allTokens[index]

  external view function tokenOfOwnerByIndex(const owner : address; const index : uint) : uint
    raises ERC721InvalidOwner | ERC721OutOfBoundsIndex
  is {
    assert(
      index < ERC721.checkedBalance(owner),
      ERC721OutOfBoundsIndex { owner = owner; index = index; }
    );
  } with storage.erc721Enumerable.ownedTokens[owner][index]
}
