(* Enumeration of every token and of each owner's tokens: ERC-721's enumeration extension,
   like OpenZeppelin's `ERC721Enumerable`. A removed token's place goes to the last token,
   so enumerations are unordered.

   The lists follow every ownership change, through `ERC721`'s `after_transfer` hook, which
   the contract points here, or calls this from its own body with what else it runs after a
   transfer:

     use ERC721 exposing IERC721, IERC721Metadata;
     use ERC721Enumerable exposing IERC721Enumerable;

     hook ERC721.before_transfer is skip;
     hook ERC721.after_transfer is ERC721Enumerable.after_transfer; *)

import "std/address";
import "std/list";
import "std/token/erc721";
import "std/interfaces/erc721";

module ERC721Enumerable is {
  requires ERC721;

  storage erc721_enumerable at "lithe.std.erc721.enumerable" is record {
    owned_tokens : map(address, map(uint, uint));
    owned_tokens_index : map(uint, uint);
    all_tokens : list(uint);
    all_tokens_index : map(uint, uint);
  }

  view function total_supply() : uint is
    erc721_enumerable.all_tokens.length

  view function token_by_index(const index : uint) : uint
    raises ERC721OutOfBoundsIndex
  is {
    assert(
      index < erc721_enumerable.all_tokens.length,
      ERC721OutOfBoundsIndex { owner = Address.zero; index = index; }
    );
  } with erc721_enumerable.all_tokens[index]

  view function token_of_owner_by_index(const owner : address; const index : uint) : uint
    raises ERC721InvalidOwner | ERC721OutOfBoundsIndex
  is {
    assert(
      index < ERC721.balance_of(owner),
      ERC721OutOfBoundsIndex { owner = owner; index = index; }
    );
  } with erc721_enumerable.owned_tokens[owner][index]

  (* After `ERC721` moves, mints, or burns a token: the enumerations follow it. *)
  function after_transfer(const from : address; const to : address; const tokenId : uint) is {
    if from = Address.zero then {
      add_to_all(tokenId);
    } else if from <> to then {
      remove_from_owner(from, tokenId);
    }
    if to = Address.zero then {
      remove_from_all(tokenId);
    } else if from <> to then {
      add_to_owner(to, tokenId);
    }
  }

  function add_to_owner(const to : address; const tokenId : uint) is {
    const length : uint := ERC721.erc721.balances[to] - 1;
    erc721_enumerable.owned_tokens[to][length] := tokenId;
    erc721_enumerable.owned_tokens_index[tokenId] := length;
  }

  function add_to_all(const tokenId : uint) is {
    erc721_enumerable.all_tokens_index[tokenId] := erc721_enumerable.all_tokens.length;
    List.push(erc721_enumerable.all_tokens, tokenId);
  }

  function remove_from_owner(const from : address; const tokenId : uint) is {
    const last_index : uint := ERC721.erc721.balances[from];
    const index : uint := erc721_enumerable.owned_tokens_index[tokenId];
    if index <> last_index then {
      const last_id : uint := erc721_enumerable.owned_tokens[from][last_index];
      erc721_enumerable.owned_tokens[from][index] := last_id;
      erc721_enumerable.owned_tokens_index[last_id] := index;
    }
    erc721_enumerable.owned_tokens_index[tokenId] := 0;
    erc721_enumerable.owned_tokens[from][last_index] := 0;
  }

  function remove_from_all(const tokenId : uint) is {
    const last_index : uint := erc721_enumerable.all_tokens.length - 1;
    const index : uint := erc721_enumerable.all_tokens_index[tokenId];
    const last_id : uint := erc721_enumerable.all_tokens[last_index];
    erc721_enumerable.all_tokens[index] := last_id;
    erc721_enumerable.all_tokens_index[last_id] := index;
    erc721_enumerable.all_tokens_index[tokenId] := 0;
    List.pop(erc721_enumerable.all_tokens);
  }

  external view function totalSupply() : uint is
    total_supply()

  external view function tokenByIndex(const index : uint) : uint
    raises ERC721OutOfBoundsIndex
  is
    token_by_index(index)

  external view function tokenOfOwnerByIndex(const owner : address; const index : uint) : uint
    raises ERC721InvalidOwner | ERC721OutOfBoundsIndex
  is
    token_of_owner_by_index(owner, index)
}
