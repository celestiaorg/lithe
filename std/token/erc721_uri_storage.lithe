(* A URI per token, like OpenZeppelin's `ERC721URIStorage`. `tokenURI` joins the base URI
   the collection passes with the token's own URI, or with its id when it has none; with
   no base, it is the token's own URI alone. Setting a token's URI logs ERC-4906's
   `MetadataUpdate`.

   ERC-4906's ERC-165 id is fixed by the standard rather than derived from functions, so
   the collection answers for it in its own `supportsInterface`, and for what its
   `supports` lists with `Abi.supportsInterface`:

     external view function tokenURI(const tokenId : uint) : string
       raises ERC721NonexistentToken
     is
       ERC721URIStorage.tokenURI(tokenId, "ipfs://collection/")

     external pure function supportsInterface(const interfaceId : bytes4) : bool is
       ERC721URIStorage.supportsInterface(interfaceId) or Abi.supportsInterface(interfaceId) *)

import "std/string";
import "std/uint";
import "std/token/erc721";
import "std/interfaces/erc721";

module ERC721URIStorage is {
  requires ERC721;

  storage erc721URIStorage at "lithe.std.erc721.uri_storage" is record {
    tokenUris : map(uint, string);
  }

  event MetadataUpdate of record {
    tokenId : uint;
  }

  event BatchMetadataUpdate of record {
    fromTokenId : uint;
    toTokenId : uint;
  }

  (* ERC-4906's id, which the standard fixes rather than derives from functions. *)
  pure function supportsInterface(const interfaceId : bytes4) : bool is
    interfaceId = 0x49064906

  view function tokenURI(const tokenId : uint; const base : string) : string
    raises ERC721NonexistentToken
  is {
    const owner : address := ERC721.requireOwned(tokenId);
    const own : string := erc721URIStorage.tokenUris[tokenId];
    var uri : string := own;
    if base.length > 0 then {
      if own.length > 0 then {
        uri := String.concat(base, own);
      } else {
        uri := String.concat(base, Uint.toString(tokenId));
      }
    }
  } with uri

  function setTokenURI(const tokenId : uint; const uri : string) is {
    erc721URIStorage.tokenUris[tokenId] := uri;
    emit MetadataUpdate {
      tokenId = tokenId;
    };
  }

  (* For a change that reaches many tokens' URIs at once, such as a new base URI. *)
  function announceUpdate(const fromTokenId : uint; const toTokenId : uint) is {
    emit BatchMetadataUpdate {
      fromTokenId = fromTokenId;
      toTokenId = toTokenId;
    };
  }
}
