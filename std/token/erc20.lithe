(* The ERC-20 token standard. Errors and events match OpenZeppelin's `ERC20`, and so does
   the order of its checks. Set the name and symbol with `init`, usually from `deploy`.

   The module's externals are the standard's, and a token exposes them by naming its
   interfaces, and announces them through ERC-165 with `supports`:

     use ERC20 exposing IERC20, IERC20Metadata;
     supports IERC20, IERC20Metadata;

   Every balance change goes through `update`. To add a rule, such as a pause, the
   contract writes its own `transfer` and `transferFrom` around `move` and
   `spend_allowance`: an extension never changes these functions silently. It exposes the
   rest of `IERC20` as `IERC20Views` and `IERC20Approvals`:

     use ERC20 exposing IERC20Metadata, IERC20Views, IERC20Approvals; *)

import "std/address";
import "std/evm";
import "std/uint";
import "std/interfaces/erc20";

module ERC20 is {
  storage erc20 at "lithe.std.erc20" is record {
    balances : map(address, uint);
    allowances : map(address, map(address, uint));
    total_supply : uint;
    name : string;
    symbol : string;
  }

  event Transfer of record {
    indexed from : address;
    indexed to : address;
    value : uint;
  }

  event Approval of record {
    indexed owner : address;
    indexed spender : address;
    value : uint;
  }

  function init(const name : string; const symbol : string) is {
    erc20.name := name;
    erc20.symbol := symbol;
  }

  view function name() : string is
    erc20.name

  view function symbol() : string is
    erc20.symbol

  pure function decimals() : uint8 is
    18

  view function total_supply() : uint is
    erc20.total_supply

  view function balance_of(const account : address) : uint is
    erc20.balances[account]

  view function allowance(const owner : address; const spender : address) : uint is
    erc20.allowances[owner][spender]

  function transfer(const to : address; const value : uint) : bool
    raises ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    move(Evm.sender(), to, value);
  } with true

  function approve(const spender : address; const value : uint) : bool
    raises ERC20InvalidApprover | ERC20InvalidSpender
  is {
    approve_as(Evm.sender(), spender, value, true);
  } with true

  function transfer_from(const from : address; const to : address; const value : uint) : bool
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    spend_allowance(from, Evm.sender(), value);
    move(from, to, value);
  } with true

  (* A transfer between two real accounts. *)
  function move(const from : address; const to : address; const value : uint)
    raises ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    assert(from <> Address.zero, ERC20InvalidSender(Address.zero));
    assert(to <> Address.zero, ERC20InvalidReceiver(Address.zero));
    update(from, to, value);
  }

  function mint(const account : address; const value : uint)
    raises ERC20InvalidReceiver | ERC20InsufficientBalance
  is {
    assert(account <> Address.zero, ERC20InvalidReceiver(Address.zero));
    update(Address.zero, account, value);
  }

  function burn(const account : address; const value : uint)
    raises ERC20InvalidSender | ERC20InsufficientBalance
  is {
    assert(account <> Address.zero, ERC20InvalidSender(Address.zero));
    update(account, Address.zero, value);
  }

  (* Moves, mints (`from` is zero), or burns (`to` is zero), and logs the `Transfer`. *)
  function update(const from : address; const to : address; const value : uint)
    raises ERC20InsufficientBalance
  is {
    if from = Address.zero then {
      erc20.total_supply := erc20.total_supply + value;
    } else {
      const balance : uint := erc20.balances[from];
      assert(
        balance >= value,
        ERC20InsufficientBalance { sender = from; balance = balance; needed = value; }
      );
      erc20.balances[from] := balance - value;
    }
    if to = Address.zero then {
      erc20.total_supply := erc20.total_supply - value;
    } else {
      erc20.balances[to] := erc20.balances[to] + value;
    }
    emit Transfer {
      from = from;
      to = to;
      value = value;
    };
  }

  (* Sets an allowance. `announce` logs the `Approval`; spending one doesn't. *)
  function approve_as(const owner : address; const spender : address; const value : uint; const announce : bool)
    raises ERC20InvalidApprover | ERC20InvalidSpender
  is {
    assert(owner <> Address.zero, ERC20InvalidApprover(Address.zero));
    assert(spender <> Address.zero, ERC20InvalidSpender(Address.zero));
    erc20.allowances[owner][spender] := value;
    if announce then {
      emit Approval {
        owner = owner;
        spender = spender;
        value = value;
      };
    }
  }

  (* Spends from an allowance. An unlimited allowance, `Uint.max`, is never spent down. *)
  function spend_allowance(const owner : address; const spender : address; const value : uint)
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
  is {
    const current : uint := erc20.allowances[owner][spender];
    if current < Uint.max then {
      assert(
        current >= value,
        ERC20InsufficientAllowance { spender = spender; allowance = current; needed = value; }
      );
      approve_as(owner, spender, current - value, false);
    }
  }

  external view function name() : string is
    erc20.name

  external view function symbol() : string is
    erc20.symbol

  external view function decimals() : uint8 is
    18

  external view function totalSupply() : uint is
    erc20.total_supply

  external view function balanceOf(const account : address) : uint is
    erc20.balances[account]

  external view function allowance(const owner : address; const spender : address) : uint is
    erc20.allowances[owner][spender]

  external function transfer(const to : address; const value : uint) : bool
    raises ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance
  is
    transfer(to, value)

  external function approve(const spender : address; const value : uint) : bool
    raises ERC20InvalidApprover | ERC20InvalidSpender
  is
    approve(spender, value)

  external function transferFrom(const from : address; const to : address; const value : uint) : bool
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InvalidReceiver | ERC20InsufficientBalance
  is
    transfer_from(from, to, value)
}

(* `IERC20` without its transfers and approvals, for a token that writes its own. *)
interface IERC20Views is {
  view function totalSupply() : uint;
  view function balanceOf(account : address) : uint;
  view function allowance(owner : address; spender : address) : uint;
}

interface IERC20Approvals is {
  function approve(spender : address; value : uint) : bool
    raises ERC20InvalidApprover | ERC20InvalidSpender;
}
