(* Voting power from balances, ERC-5805 with ERC-6372's block-number clock, like
   OpenZeppelin's `ERC20Votes`. A holder's balance counts as votes for the account it
   delegates to, itself included, and nothing until it delegates. Each delegate's votes,
   and the total supply, are checkpointed by block, so a governor reads them as of a past
   block. The supply is capped at what a checkpoint holds, `2^208 - 1`.

   The votes follow every balance change, through `ERC20`'s `afterTransfer` hook, which
   the token points at `transferVotingUnits`, or calls it from its own body with what
   else it runs after a balance change. Its errors join those of the transfers, mints, and
   burns, so the token lists them where it exposes the transfers:

     use ERC20 exposing IERC20Metadata, IERC20Views, IERC20Approvals, {
       function transfer(to : address; value : uint) : bool
         raises ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance
           | ERC20ExceededSafeSupply | CheckpointUnorderedInsertion;
       ...
     }
     use ERC20Votes exposing IERC6372, IVotes, IVotesCheckpoints;

     hook ERC20.beforeTransfer is skip;
     hook ERC20.afterTransfer is ERC20Votes.transferVotingUnits; *)

import "std/abi";
import "std/address";
import "std/crypto";
import "std/evm";
import "std/uint";
import "std/token/erc20";
import "std/crypto/eip712";
import "std/interfaces/erc5805";
import "std/utils/checkpoint";
import "std/crypto/ecdsa";
import "std/utils/nonce";
import "std/interfaces/erc20";

module ERC20Votes is {
  requires ERC20;
  requires EIP712;
  requires ECDSA;
  requires Nonces;
  requires Checkpoints;

  storage erc20Votes at "lithe.std.erc20.votes" is record {
    delegatee : map(address, address);
    delegateCheckpoints : map(address, Trace);
    totalCheckpoints : Trace;
  }

  error ERC20ExceededSafeSupply of record {
    increasedSupply : uint;
    cap : uint;
  }

  event DelegateChanged of record {
    indexed delegator : address;
    indexed fromDelegate : address;
    indexed toDelegate : address;
  }

  event DelegateVotesChanged of record {
    indexed delegate : address;
    previousVotes : uint;
    newVotes : uint;
  }

  view function timepoint() : uint48 is
    uint48(Evm.blockNumber())

  (* A past block, checked: a lookup at the current block could still change. *)
  view function past(const timepoint : uint) : uint48
    raises ERC5805FutureLookup
  is {
    const now : uint48 := timepoint();
    assert(timepoint < uint(now), ERC5805FutureLookup { timepoint = timepoint; clock = now; });
  } with uint48(timepoint)

  view function checkpointAt(const account : address; const pos : uint32) : Checkpoint is
    Checkpoints.at(erc20Votes.delegateCheckpoints[account], uint(pos))

  (* `account`'s votes go to `delegatee` from now on, all of its balance at once. *)
  function delegateAs(const account : address; const delegatee : address)
    raises CheckpointUnorderedInsertion
  is {
    const previous : address := erc20Votes.delegatee[account];
    erc20Votes.delegatee[account] := delegatee;
    emit DelegateChanged {
      delegator = account;
      fromDelegate = previous;
      toDelegate = delegatee;
    };
    moveDelegateVotes(previous, delegatee, ERC20.erc20.balances[account]);
  }

  pure function delegationTypehash() : bytes32 is
    Crypto.keccak256("Delegation(address delegatee,uint256 nonce,uint256 expiry)")

  (* After a balance change: a mint checks the supply still fits a checkpoint, then the
     total and the delegates' votes move with the tokens. *)
  function transferVotingUnits(const from : address; const to : address; const value : uint)
    raises ERC20ExceededSafeSupply | CheckpointUnorderedInsertion
  is {
    if from = Address.zero then {
      const supply : uint := ERC20.erc20.totalSupply;
      const cap : uint208 := Uint.max;
      assert(supply <= uint(cap), ERC20ExceededSafeSupply { increasedSupply = supply; cap = uint(cap); });
      Checkpoints.push(
        erc20Votes.totalCheckpoints,
        timepoint(),
        Checkpoints.latest(erc20Votes.totalCheckpoints) + uint208(value)
      );
    }
    if to = Address.zero then {
      Checkpoints.push(
        erc20Votes.totalCheckpoints,
        timepoint(),
        Checkpoints.latest(erc20Votes.totalCheckpoints) - uint208(value)
      );
    }
    moveDelegateVotes(erc20Votes.delegatee[from], erc20Votes.delegatee[to], value);
  }

  function moveDelegateVotes(const from : address; const to : address; const amount : uint)
    raises CheckpointUnorderedInsertion
  is {
    if from <> to and amount > 0 then {
      if from <> Address.zero then {
        const previous : uint208 := Checkpoints.latest(erc20Votes.delegateCheckpoints[from]);
        const next : uint208 := previous - uint208(amount);
        Checkpoints.push(erc20Votes.delegateCheckpoints[from], timepoint(), next);
        emit DelegateVotesChanged { delegate = from; previousVotes = uint(previous); newVotes = uint(next); };
      }
      if to <> Address.zero then {
        const previous : uint208 := Checkpoints.latest(erc20Votes.delegateCheckpoints[to]);
        const next : uint208 := previous + uint208(amount);
        Checkpoints.push(erc20Votes.delegateCheckpoints[to], timepoint(), next);
        emit DelegateVotesChanged { delegate = to; previousVotes = uint(previous); newVotes = uint(next); };
      }
    }
  }

  external view function clock() : uint48 is
    timepoint()

  external view function CLOCK_MODE() : string
    raises ERC6372InconsistentClock
  is {
    assert(timepoint() = uint48(Evm.blockNumber()), ERC6372InconsistentClock);
  } with "mode=blocknumber&from=default"

  external view function getVotes(const account : address) : uint is
    uint(Checkpoints.latest(erc20Votes.delegateCheckpoints[account]))

  external view function getPastVotes(const account : address; const timepoint : uint) : uint
    raises ERC5805FutureLookup
  is
    uint(Checkpoints.upperLookupRecent(erc20Votes.delegateCheckpoints[account], past(timepoint)))

  external view function getPastTotalSupply(const timepoint : uint) : uint
    raises ERC5805FutureLookup
  is
    uint(Checkpoints.upperLookupRecent(erc20Votes.totalCheckpoints, past(timepoint)))

  external view function delegates(const account : address) : address is
    erc20Votes.delegatee[account]

  external view function numCheckpoints(const account : address) : uint32 is
    uint32(Checkpoints.length(erc20Votes.delegateCheckpoints[account]))

  external view function checkpoints(const account : address; const pos : uint32) : Checkpoint is
    checkpointAt(account, pos)

  external function delegate(const delegatee : address)
    raises CheckpointUnorderedInsertion
  is {
    delegateAs(Evm.sender(), delegatee);
  }

  external function delegateBySig(
    const delegatee : address;
    const nonce : uint;
    const expiry : uint;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  )
    raises VotesExpiredSignature | ECDSAInvalidSignature | ECDSAInvalidSignatureS | InvalidAccountNonce
      | CheckpointUnorderedInsertion
  is {
    assert(uint(Evm.blockTimestamp()) <= expiry, VotesExpiredSignature(expiry));
    const structHash : bytes32 := Crypto.keccak256(Abi.encode(
      delegationTypehash(),
      delegatee,
      nonce,
      expiry
    ));
    const signer : address := ECDSA.recover(EIP712.hashTypedData(structHash), v, r, s);
    Nonces.useCheckedNonce(signer, nonce);
    delegateAs(signer, delegatee);
  }
}

(* OpenZeppelin's checkpoint views, which ERC-5805 leaves out. *)
interface IVotesCheckpoints is {
  view function numCheckpoints(account : address) : uint32;
  view function checkpoints(account : address; pos : uint32) : Checkpoint;
}
