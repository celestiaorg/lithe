(* Each id's total supply for ERC-6909, like OpenZeppelin's `ERC6909TokenSupply`. Mints and
   burns change it, through `ERC6909`'s `afterTransfer` hook, which the contract points
   here, or calls this from its own body with what else it runs after a balance change:

     use ERC6909TokenSupply exposing IERC6909TokenSupply;
     supports IERC6909TokenSupply;

     hook ERC6909.beforeTransfer is skip;
     hook ERC6909.afterTransfer is ERC6909TokenSupply.afterTransfer; *)

import "std/token/erc6909";
import "std/interfaces/erc6909";
import "std/address";
import "std/uint";

module ERC6909TokenSupply is {
  requires ERC6909;

  storage erc6909TokenSupply at "lithe.std.erc6909_token_supply" is record {
    totalSupplies : map(uint, uint);
  }

  (* After `ERC6909` changes balances: a mint adds to the supply, a burn takes away. A burn
     is bounded by a balance, which the supply covers. *)
  function afterTransfer(const from : address; const to : address; const id : uint; const amount : uint) is {
    if from = Address.zero then {
      erc6909TokenSupply.totalSupplies[id] := erc6909TokenSupply.totalSupplies[id] + amount;
    }
    if to = Address.zero then {
      erc6909TokenSupply.totalSupplies[id] := Uint.wrappingSub(erc6909TokenSupply.totalSupplies[id], amount);
    }
  }

  external view function totalSupply(const id : uint) : uint is
    erc6909TokenSupply.totalSupplies[id]
}
