(* The ERC-721 non-fungible token standard, with the metadata extension. Errors and
   events match OpenZeppelin's `ERC721`, and so does the order of its checks. Set the
   name and symbol with `init`, usually from `deploy`. A token has no URI of its own:
   `tokenURI` checks the token exists and answers the empty string, as OpenZeppelin's
   does without a base URI, so a contract with URIs writes its own `tokenURI`.

     use ERC721 exposing IERC721, IERC721Metadata;
     supports IERC721, IERC721Metadata;

   Every ownership change goes through `update`, like OpenZeppelin's `_update`, which
   calls the contract's two hooks: `beforeTransfer` once it has read the owner, before
   the approval check, where OpenZeppelin's overrides check a pause, and `afterTransfer`
   after the `Transfer` log, where extensions such as `ERC721Enumerable` follow the token.
   `from` is zero for a mint, `to` for a burn. A collection without extensions skips both:

     hook ERC721.beforeTransfer is skip;
     hook ERC721.afterTransfer is skip;

   A hook that raises adds its errors to the transfers, mints, and burns. A collection
   with such hooks, or with its own `tokenURI`, exposes the rest as `IERC721Views`,
   `IERC721Name`, and `IERC721Approvals`, and lists the transfers with their errors.

   The safe transfers call the receiver in a deferred call, after the transfer's own
   effects, and pass a receiver's revert reason through unchanged. *)

import "std/abi";
import "std/address";
import "std/evm";
import "std/interfaces/erc165";
import "std/interfaces/erc721";

module ERC721 is {
  storage erc721 at "lithe.std.erc721" is record {
    name : string;
    symbol : string;
    owners : map(uint, address);
    balances : map(address, uint);
    tokenApprovals : map(uint, address);
    operatorApprovals : map(address, map(address, bool));
  }

  event Transfer of record {
    indexed from : address;
    indexed to : address;
    indexed tokenId : uint;
  }

  event Approval of record {
    indexed owner : address;
    indexed approved : address;
    indexed tokenId : uint;
  }

  event ApprovalForAll of record {
    indexed owner : address;
    indexed operator : address;
    approved : bool;
  }

  hook beforeTransfer(const to : address; const tokenId : uint; const auth : address);
  hook afterTransfer(const from : address; const to : address; const tokenId : uint);

  function init(const name : string; const symbol : string) is {
    erc721.name := name;
    erc721.symbol := symbol;
  }

  (* ERC-721, its metadata extension, and ERC-165 itself. *)
  pure function supportsInterface(const interfaceId : bytes4) : bool is
    interfaceId = Abi.interfaceId(IERC721)
      or interfaceId = Abi.interfaceId(IERC721Metadata)
      or interfaceId = Abi.interfaceId(IERC165)

  view function checkedBalance(const owner : address) : uint
    raises ERC721InvalidOwner
  is {
    assert(owner <> Address.zero, ERC721InvalidOwner(Address.zero));
  } with erc721.balances[owner]

  view function requireOwned(const tokenId : uint) : address
    raises ERC721NonexistentToken
  is {
    const owner : address := erc721.owners[tokenId];
    assert(owner <> Address.zero, ERC721NonexistentToken(tokenId));
  } with owner

  view function checkAuthorized(const owner : address; const spender : address; const tokenId : uint)
    raises ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const authorized : bool := spender <> Address.zero
      and (owner = spender
        or erc721.operatorApprovals[owner][spender]
        or erc721.tokenApprovals[tokenId] = spender);
    if not authorized then {
      assert(owner <> Address.zero, ERC721NonexistentToken(tokenId));
      fail ERC721InsufficientApproval { operator = spender; tokenId = tokenId; };
    }
  }

  (* Moves, mints (`to` from zero), or burns (`to` is zero); returns the previous owner.
     A nonzero `auth` must be allowed to move the token. *)
  function update(const to : address; const tokenId : uint; const auth : address) : address
    raises ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    beforeTransfer(to, tokenId, auth);
    const from : address := erc721.owners[tokenId];
    if auth <> Address.zero then {
      checkAuthorized(from, auth, tokenId);
    }
    if from <> Address.zero then {
      erc721.tokenApprovals[tokenId] := Address.zero;
      erc721.balances[from] := erc721.balances[from] - 1;
    }
    if to <> Address.zero then {
      erc721.balances[to] := erc721.balances[to] + 1;
    }
    erc721.owners[tokenId] := to;
    emit Transfer {
      from = from;
      to = to;
      tokenId = tokenId;
    };
    afterTransfer(from, to, tokenId);
  } with from

  function approveAs(const to : address; const tokenId : uint; const auth : address)
    raises ERC721NonexistentToken | ERC721InvalidApprover
  is {
    const owner : address := requireOwned(tokenId);
    assert(
      auth = Address.zero or owner = auth or erc721.operatorApprovals[owner][auth],
      ERC721InvalidApprover(auth)
    );
    emit Approval {
      owner = owner;
      approved = to;
      tokenId = tokenId;
    };
    erc721.tokenApprovals[tokenId] := to;
  }

  function approveAllAs(const owner : address; const operator : address; const approved : bool)
    raises ERC721InvalidApprover | ERC721InvalidOperator
  is {
    assert(owner <> Address.zero, ERC721InvalidApprover(Address.zero));
    assert(operator <> Address.zero, ERC721InvalidOperator(operator));
    erc721.operatorApprovals[owner][operator] := approved;
    emit ApprovalForAll {
      owner = owner;
      operator = operator;
      approved = approved;
    };
  }

  (* Like `ERC721Utils.checkOnERC721Received`: a contract receiver must answer with the
     selector. The call runs after the transfer's effects, as in Solidity. A receiver that
     reverts without a reason is invalid; its own reason is passed on unchanged. *)
  function checkReceived(
    const operator : address;
    const from : address;
    const to : address;
    const tokenId : uint;
    const data : bytes
  )
    raises ERC721InvalidReceiver | forwarded
  is {
    if Evm.codeSize(to) > 0 then {
      const receiver : IERC721Receiver := IERC721Receiver(to);
      defer receiver.onERC721Received(operator, from, tokenId, data) then {
        | Ok(answer : bytes4) -> {
            assert(answer = Abi.selector(IERC721Receiver.onERC721Received), ERC721InvalidReceiver(to));
          }
        | Error(reason : bytes) -> {
            if reason.length = 0 then {
              fail ERC721InvalidReceiver(to);
            }
            forward reason;
          }
      };
    }
  }

  function authorizedTransfer(const from : address; const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    assert(to <> Address.zero, ERC721InvalidReceiver(Address.zero));
    const previous : address := update(to, tokenId, Evm.sender());
    assert(
      previous = from,
      ERC721IncorrectOwner { sender = from; tokenId = tokenId; owner = previous; }
    );
  }

  (* The four-argument `safeTransferFrom`, passing `data` to the receiver. *)
  function safeTransferFromWithData(
    const from : address;
    const to : address;
    const tokenId : uint;
    const data : bytes
  )
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
      | forwarded
  is {
    authorizedTransfer(from, to, tokenId);
    checkReceived(Evm.sender(), from, to, tokenId, data);
  }

  function mint(const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721InvalidSender | ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    assert(to <> Address.zero, ERC721InvalidReceiver(Address.zero));
    const previous : address := update(to, tokenId, Address.zero);
    assert(previous = Address.zero, ERC721InvalidSender(Address.zero));
  }

  (* Mints, then checks that a contract receiver accepts the token. *)
  function safeMint(const to : address; const tokenId : uint; const data : bytes)
    raises ERC721InvalidReceiver | ERC721InvalidSender | ERC721NonexistentToken | ERC721InsufficientApproval | forwarded
  is {
    mint(to, tokenId);
    checkReceived(Evm.sender(), Address.zero, to, tokenId, data);
  }

  function burn(const tokenId : uint)
    raises ERC721NonexistentToken | ERC721InsufficientApproval
  is {
    const previous : address := update(Address.zero, tokenId, Address.zero);
    assert(previous <> Address.zero, ERC721NonexistentToken(tokenId));
  }

  external view function name() : string is
    erc721.name

  external view function symbol() : string is
    erc721.symbol

  (* Without a base URI, an existing token's URI is empty. *)
  external view function tokenURI(const tokenId : uint) : string
    raises ERC721NonexistentToken
  is {
    const owner : address := requireOwned(tokenId);
  } with ""

  external view function balanceOf(const owner : address) : uint
    raises ERC721InvalidOwner
  is
    checkedBalance(owner)

  external view function ownerOf(const tokenId : uint) : address
    raises ERC721NonexistentToken
  is
    requireOwned(tokenId)

  external view function getApproved(const tokenId : uint) : address
    raises ERC721NonexistentToken
  is {
    const owner : address := requireOwned(tokenId);
  } with erc721.tokenApprovals[tokenId]

  external view function isApprovedForAll(const owner : address; const operator : address) : bool is
    erc721.operatorApprovals[owner][operator]

  external function approve(const to : address; const tokenId : uint)
    raises ERC721NonexistentToken | ERC721InvalidApprover
  is {
    approveAs(to, tokenId, Evm.sender());
  }

  external function setApprovalForAll(const operator : address; const approved : bool)
    raises ERC721InvalidApprover | ERC721InvalidOperator
  is {
    approveAllAs(Evm.sender(), operator, approved);
  }

  external function transferFrom(const from : address; const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
  is
    authorizedTransfer(from, to, tokenId)

  external function safeTransferFrom(const from : address; const to : address; const tokenId : uint)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
      | forwarded
  is {
    authorizedTransfer(from, to, tokenId);
    checkReceived(Evm.sender(), from, to, tokenId, "");
  }

  external function safeTransferFrom(const from : address; const to : address; const tokenId : uint; const data : bytes)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
      | forwarded
  is
    safeTransferFromWithData(from, to, tokenId, data)
}

(* `IERC721` without its transfers and approvals, for a collection that writes its own. *)
interface IERC721Views is {
  view function balanceOf(owner : address) : uint
    raises ERC721InvalidOwner;
  view function ownerOf(tokenId : uint) : address
    raises ERC721NonexistentToken;
  view function getApproved(tokenId : uint) : address
    raises ERC721NonexistentToken;
  view function isApprovedForAll(owner : address; operator : address) : bool;
}

interface IERC721Approvals is {
  function approve(to : address; tokenId : uint)
    raises ERC721NonexistentToken | ERC721InvalidApprover;
  function setApprovalForAll(operator : address; approved : bool)
    raises ERC721InvalidApprover | ERC721InvalidOperator;
}

(* `IERC721Metadata` without `tokenURI`, for a collection with URIs of its own. *)
interface IERC721Name is {
  view function name() : string;
  view function symbol() : string;
}
