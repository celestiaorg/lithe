(* ERC-2612: approvals by signature, so an account can approve without a transaction of
   its own. Like OpenZeppelin's `ERC20Permit`. The EIP-712 domain's name is usually the
   token's name, and its version "1":

     deploy() is {
       ERC20.init("My Token", "MTK");
       EIP712.init("My Token", "1");
     }

     use ERC20Permit exposing IERC20Permit; *)

import "std/abi";
import "std/crypto";
import "std/evm";
import "std/token/erc20";
import "std/crypto/eip712";
import "std/crypto/ecdsa";
import "std/utils/nonce";
import "std/interfaces/erc20";

module ERC20Permit is {
  requires ERC20;
  requires EIP712;
  requires ECDSA;
  requires Nonces;

  pure function permitTypehash() : bytes32 is
    Crypto.keccak256("Permit(address owner,address spender,uint256 value,uint256 nonce,uint256 deadline)")

  external function permit(
    const owner : address;
    const spender : address;
    const value : uint;
    const deadline : uint;
    const v : uint8;
    const r : bytes32;
    const s : bytes32
  )
    raises ERC2612ExpiredSignature | ERC2612InvalidSigner | ECDSAInvalidSignature | ECDSAInvalidSignatureS
      | ERC20InvalidApprover | ERC20InvalidSpender
  is {
    assert(uint(Evm.blockTimestamp()) <= deadline, ERC2612ExpiredSignature(deadline));
    const structHash : bytes32 := Crypto.keccak256(Abi.encode(
      permitTypehash(),
      owner,
      spender,
      value,
      Nonces.useNonce(owner),
      deadline
    ));
    const signer : address := ECDSA.recover(EIP712.hashTypedData(structHash), v, r, s);
    assert(signer = owner, ERC2612InvalidSigner { signer = signer; owner = owner; });
    ERC20.approveAs(owner, spender, value, true);
  }

  external view function nonces(const owner : address) : uint is
    Nonces.nonceState.counts[owner]

  external view function DOMAIN_SEPARATOR() : bytes32 is
    EIP712.domainSeparator()
}
