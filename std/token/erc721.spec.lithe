(* What `ERC721` guarantees. `lithe prove` proves these for each contract that uses the module:
   the contract's own code can write the module's storage too. *)

spec for module ERC721 is {
  spec is {
    (* Each owned token counts once in its owner's balance. *)
    invariant counted is sum(storage.erc721.balances) = count(storage.erc721.owners);
    (* The zero address owns nothing, and approves no one. *)
    invariant nothingAtZero is storage.erc721.balances[Address.zero] = 0;
    invariant noZeroOperator is
      forall a : address . not storage.erc721.operatorApprovals[Address.zero][a];
    (* Only a token that exists has an approval. *)
    invariant approvalsOwned is
      forall id : uint . storage.erc721.owners[id] <> Address.zero
        or storage.erc721.tokenApprovals[id] = Address.zero;
  }

  spec for transferFrom is partial {
    raises ERC721InvalidReceiver when to = Address.zero;
    raises ERC721NonexistentToken when old.storage.erc721.owners[tokenId] = Address.zero;
    ensures new.storage.erc721.owners[tokenId] = to;
    ensures new.storage.erc721.tokenApprovals[tokenId] = Address.zero;
    ensures from = to or new.storage.erc721.balances[to] = old.storage.erc721.balances[to] + 1;
  }
}
