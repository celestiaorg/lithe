(* ERC-4626 tokenized vaults, like OpenZeppelin's `ERC4626`: the vault's shares are its
   `ERC20`, and a deposit of `asset` mints them. Errors, events, rounding, and the order of
   checks are OpenZeppelin's. Conversions count `10 ** offset` virtual shares and one
   virtual asset, so a first depositor can't inflate the share price to round a later
   deposit down to nothing: the attack costs the attacker more than the victim loses, by
   a factor of `10 ** offset`.

   The asset moves in deferred calls that accept tokens returning nothing, and pass an
   asset's revert on unchanged, as `SafeERC20` does. A deposit mints in the continuation
   of its `transferFrom`, so while the asset runs, the vault's shares and assets are those
   of before the deposit, as in OpenZeppelin's order. A withdrawal burns first and sends
   the assets with `SafeERC20.safe_transfer` after, also in OpenZeppelin's order.

     use SafeERC20;
     use ERC20 exposing IERC20, IERC20Name;
     use ERC4626 exposing IERC4626, {
       view function decimals() : uint8;
     }
     supports IERC20, IERC20Metadata, IERC4626;

   `decimals` is the asset's plus the offset. A vault with limits or fees writes its own
   entrypoints around `convert_to_shares`, `convert_to_assets`, `deposit_as`, and
   `withdraw_as`, and exposes the rest of `IERC4626`. *)

import "std/token/erc20";
import "std/interfaces/erc4626";
import "std/evm";
import "std/token/safe_erc20";
import "std/interfaces/erc20";
import "std/abi";
import "std/bytes";
import "std/uint";

module ERC4626 is {
  requires ERC20;
  requires SafeERC20;

  immutable erc4626 at "lithe.std.erc4626" is record {
    asset : IERC20;
    decimals : uint8;
    virtual_shares : uint64;
  }

  event Deposit of record {
    indexed sender : address;
    indexed owner : address;
    assets : uint;
    shares : uint;
  }

  event Withdraw of record {
    indexed sender : address;
    indexed receiver : address;
    indexed owner : address;
    assets : uint;
    shares : uint;
  }

  (* Set once, from `deploy` or a migration. `decimals` is the asset's, which
     `asset_decimals` reads, and `offset` adds decimals to the shares.
     simplify: `10 ** offset` is kept in 64 bits, so an offset past 19 panics here; widen
     `virtual_shares` if a vault ever needs more. *)
  function init(const asset : address; const decimals : uint8; const offset : uint8) is {
    erc4626.asset := IERC20(asset);
    erc4626.decimals := decimals + offset;
    erc4626.virtual_shares := uint64(10 ** uint(offset));
  }

  (* The asset's `decimals`, or 18 when it has none that fits a `uint8`. *)
  view function asset_decimals(const asset : address) : uint8 is {
    var decimals : uint8 := 18;
    case query Evm.static_call(asset, Abi.encode_call(IERC20Metadata.decimals)) of {
      | Ok(data) -> {
          if data.length >= 32 and uint(Bytes.word(data, 0)) < 256 then {
            decimals := uint8(uint(Bytes.word(data, 0)));
          }
        }
      | Error(_) -> { skip }
    };
  } with decimals

  view function asset() : address is
    address(erc4626.asset)

  view function decimals() : uint8 is
    erc4626.decimals

  view function total_assets() : uint is
    query erc4626.asset.balanceOf(Evm.self())

  (* `assets` in shares, rounded up if `up`. *)
  view function convert_to_shares(const assets : uint; const up : bool) : uint is
    mul_div(assets, ERC20.total_supply() + uint(erc4626.virtual_shares), total_assets() + 1, up)

  view function convert_to_assets(const shares : uint; const up : bool) : uint is
    mul_div(shares, total_assets() + 1, ERC20.total_supply() + uint(erc4626.virtual_shares), up)

  pure function mul_div(const a : uint; const b : uint; const d : uint; const up : bool) : uint is
    Uint.mul_div(a, b, d) + uint(up) * uint(Uint.mul_mod(a, b, d) > 0)

  view function max_deposit(const receiver : address) : uint is
    Uint.max

  view function max_mint(const receiver : address) : uint is
    Uint.max

  view function max_withdraw(const owner : address) : uint is
    convert_to_assets(ERC20.balance_of(owner), false)

  view function max_redeem(const owner : address) : uint is
    ERC20.balance_of(owner)

  view function preview_deposit(const assets : uint) : uint is
    convert_to_shares(assets, false)

  view function preview_mint(const shares : uint) : uint is
    convert_to_assets(shares, true)

  view function preview_withdraw(const assets : uint) : uint is
    convert_to_shares(assets, true)

  view function preview_redeem(const shares : uint) : uint is
    convert_to_assets(shares, false)

  function deposit(const assets : uint; const receiver : address) : uint
    raises ERC4626ExceededMaxDeposit | SafeERC20FailedOperation | ERC20InvalidReceiver | ERC20InsufficientBalance
      | forwarded
  is {
    (* `max_deposit` and `max_mint` are unlimited, so no deposit or mint exceeds them. A
       vault with a limit checks it in its own entrypoint. *)
    const shares : uint := preview_deposit(assets);
    deposit_as(Evm.sender(), receiver, assets, shares);
  } with shares

  function mint(const shares : uint; const receiver : address) : uint
    raises ERC4626ExceededMaxMint | SafeERC20FailedOperation | ERC20InvalidReceiver | ERC20InsufficientBalance
      | forwarded
  is {
    const assets : uint := preview_mint(shares);
    deposit_as(Evm.sender(), receiver, assets, shares);
  } with assets

  function withdraw(const assets : uint; const receiver : address; const owner : address) : uint
    raises ERC4626ExceededMaxWithdraw | ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
      | ERC20InvalidSender | ERC20InsufficientBalance | SafeERC20FailedOperation | forwarded
  is {
    const most : uint := max_withdraw(owner);
    assert(
      assets <= most,
      ERC4626ExceededMaxWithdraw { owner = owner; assets = assets; max = most; }
    );
    const shares : uint := preview_withdraw(assets);
    withdraw_as(Evm.sender(), receiver, owner, assets, shares);
  } with shares

  function redeem(const shares : uint; const receiver : address; const owner : address) : uint
    raises ERC4626ExceededMaxRedeem | ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
      | ERC20InvalidSender | ERC20InsufficientBalance | SafeERC20FailedOperation | forwarded
  is {
    const most : uint := max_redeem(owner);
    assert(
      shares <= most,
      ERC4626ExceededMaxRedeem { owner = owner; shares = shares; max = most; }
    );
    const assets : uint := preview_redeem(shares);
    withdraw_as(Evm.sender(), receiver, owner, assets, shares);
  } with assets

  (* Takes `assets` from `caller`, then mints `shares` to `receiver`, in the transfer's
     continuation. *)
  function deposit_as(const caller : address; const receiver : address; const assets : uint; const shares : uint)
    raises SafeERC20FailedOperation | ERC20InvalidReceiver | ERC20InsufficientBalance | forwarded
  is {
    defer IERC20OptionalReturn(address(erc4626.asset)).transferFrom(caller, Evm.self(), assets) then {
      | Ok(ok : option(bool)) -> {
          assert(ok <> Some(false), SafeERC20FailedOperation(address(erc4626.asset)));
          ERC20.mint(receiver, shares);
          emit Deposit {
            sender = caller;
            owner = receiver;
            assets = assets;
            shares = shares;
          };
        }
      | Error(reason : bytes) -> {
          forward reason;
        }
    };
  }

  (* Burns `shares` from `owner`, spending `caller`'s allowance unless it is the owner,
     then sends `assets` to `receiver` in a deferred call. *)
  function withdraw_as(
    const caller : address;
    const receiver : address;
    const owner : address;
    const assets : uint;
    const shares : uint
  )
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InsufficientBalance | SafeERC20FailedOperation | forwarded
  is {
    if caller <> owner then {
      ERC20.spend_allowance(owner, caller, shares);
    }
    ERC20.burn(owner, shares);
    emit Withdraw {
      sender = caller;
      receiver = receiver;
      owner = owner;
      assets = assets;
      shares = shares;
    };
    SafeERC20.safe_transfer(erc4626.asset, receiver, assets);
  }

  external view function asset() : address is
    address(erc4626.asset)

  external view function decimals() : uint8 is
    erc4626.decimals

  external view function totalAssets() : uint is
    total_assets()

  external view function convertToShares(const assets : uint) : uint is
    convert_to_shares(assets, false)

  external view function convertToAssets(const shares : uint) : uint is
    convert_to_assets(shares, false)

  external view function maxDeposit(const receiver : address) : uint is
    max_deposit(receiver)

  external view function previewDeposit(const assets : uint) : uint is
    preview_deposit(assets)

  external view function maxMint(const receiver : address) : uint is
    max_mint(receiver)

  external view function previewMint(const shares : uint) : uint is
    preview_mint(shares)

  external view function maxWithdraw(const owner : address) : uint is
    max_withdraw(owner)

  external view function previewWithdraw(const assets : uint) : uint is
    preview_withdraw(assets)

  external view function maxRedeem(const owner : address) : uint is
    max_redeem(owner)

  external view function previewRedeem(const shares : uint) : uint is
    preview_redeem(shares)

  external function deposit(const assets : uint; const receiver : address) : uint
    raises ERC4626ExceededMaxDeposit | SafeERC20FailedOperation | ERC20InvalidReceiver | ERC20InsufficientBalance
      | forwarded
  is
    deposit(assets, receiver)

  external function mint(const shares : uint; const receiver : address) : uint
    raises ERC4626ExceededMaxMint | SafeERC20FailedOperation | ERC20InvalidReceiver | ERC20InsufficientBalance
      | forwarded
  is
    mint(shares, receiver)

  external function withdraw(const assets : uint; const receiver : address; const owner : address) : uint
    raises ERC4626ExceededMaxWithdraw | ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
      | ERC20InvalidSender | ERC20InsufficientBalance | SafeERC20FailedOperation | forwarded
  is
    withdraw(assets, receiver, owner)

  external function redeem(const shares : uint; const receiver : address; const owner : address) : uint
    raises ERC4626ExceededMaxRedeem | ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
      | ERC20InvalidSender | ERC20InsufficientBalance | SafeERC20FailedOperation | forwarded
  is
    redeem(shares, receiver, owner)
}
