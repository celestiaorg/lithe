(* A ceiling on the supply, like OpenZeppelin's `ERC20Capped`. Minting is the contract's own,
   so it checks the cap after each mint:

     external function mint(const to : address; const value : uint)
       raises ERC20InvalidReceiver | ERC20InsufficientBalance | ERC20ExceededCap
     is {
       ERC20.mint(to, value);
       ERC20Capped.check(ERC20.total_supply());
     }

     use ERC20Capped exposing IERC20Capped; *)

(* lithe-ignore unused-import: brings ERC20, which ERC20Capped extends *)
import "std/token/erc20.lithe";

module ERC20Capped is {
  immutable erc20_capped at "lithe.std.erc20.capped" is record {
    cap : uint;
  }

  error ERC20ExceededCap of record {
    increasedSupply : uint;
    cap : uint;
  }

  error ERC20InvalidCap of uint;

  (* The cap is set once, from `deploy` or a migration, and can't be zero. It is an
     immutable: read from the code, or from storage in an upgradeable contract. *)
  function init(const cap : uint)
    raises ERC20InvalidCap
  is {
    assert(cap > 0, ERC20InvalidCap(0));
    erc20_capped.cap := cap;
  }

  view function cap() : uint is
    erc20_capped.cap

  view function check(const supply : uint)
    raises ERC20ExceededCap
  is {
    const cap : uint := erc20_capped.cap;
    assert(supply <= cap, ERC20ExceededCap { increasedSupply = supply; cap = cap; });
  }

  external view function cap() : uint is
    erc20_capped.cap
}

interface IERC20Capped is {
  view function cap() : uint;
}
