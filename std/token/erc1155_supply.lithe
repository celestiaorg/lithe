(* Supply tracking for ERC-1155, like OpenZeppelin's `ERC1155Supply`: each id's total, and
   the total of every id. Mints and burns change them, through `ERC1155`'s `after_transfer`
   hook, which the contract points here, or calls this from its own body with what else
   it runs after a balance change:

     use ERC1155 exposing IERC1155, IERC1155MetadataURI;
     use ERC1155Supply exposing IERC1155Supply;

     hook ERC1155.before_transfer is skip;
     hook ERC1155.after_transfer is ERC1155Supply.after_transfer; *)

import "std/address";
import "std/token/erc1155";
import "std/interfaces/erc1155";

module ERC1155Supply is {
  requires ERC1155;

  storage erc1155_supply at "lithe.std.erc1155_supply" is record {
    total_supply : map(uint, uint);
    total_supply_all : uint;
  }

  view function total_supply(const id : uint) : uint is
    erc1155_supply.total_supply[id]

  view function total_supply_all() : uint is
    erc1155_supply.total_supply_all

  view function exists(const id : uint) : bool is
    erc1155_supply.total_supply[id] > 0

  (* After `ERC1155` changes balances: a mint adds to the supplies, a burn takes away. *)
  function after_transfer(
    const from : address;
    const to : address;
    const ids : list(uint);
    const values : list(uint)
  ) is {
    if from = Address.zero then {
      var minted : uint := 0;
      for (i, id) : (uint, uint) in ids do {
        erc1155_supply.total_supply[id] := erc1155_supply.total_supply[id] + values[i];
        minted := minted + values[i];
      }
      erc1155_supply.total_supply_all := erc1155_supply.total_supply_all + minted;
    }
    if to = Address.zero then {
      var burned : uint := 0;
      for (i, id) : (uint, uint) in ids do {
        erc1155_supply.total_supply[id] := erc1155_supply.total_supply[id] - values[i];
        burned := burned + values[i];
      }
      erc1155_supply.total_supply_all := erc1155_supply.total_supply_all - burned;
    }
  }

  external view function totalSupply(const id : uint) : uint is
    erc1155_supply.total_supply[id]

  external view function totalSupply() : uint is
    erc1155_supply.total_supply_all

  external view function exists(const id : uint) : bool is
    exists(id)
}

interface IERC1155Supply is {
  view function totalSupply(id : uint) : uint;
  view function totalSupply() : uint;
  view function exists(id : uint) : bool;
}
