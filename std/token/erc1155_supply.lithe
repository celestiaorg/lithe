(* Supply tracking for ERC-1155, like OpenZeppelin's `ERC1155Supply`: each id's total, and
   the total of every id. Mints and burns change them, through `ERC1155`'s `afterTransfer`
   hook, which the contract points here, or calls this from its own body with what else
   it runs after a balance change:

     use ERC1155 exposing IERC1155, IERC1155MetadataURI;
     use ERC1155Supply exposing IERC1155Supply;

     hook ERC1155.beforeTransfer is skip;
     hook ERC1155.afterTransfer is ERC1155Supply.afterTransfer; *)

import "std/address";
import "std/token/erc1155";
import "std/interfaces/erc1155";

module ERC1155Supply is {
  requires ERC1155;

  storage erc1155Supply at "lithe.std.erc1155_supply" is record {
    totalSupply : map(uint, uint);
    totalSupplyAll : uint;
  }

  view function totalSupplyAll() : uint is
    erc1155Supply.totalSupplyAll

  (* After `ERC1155` changes balances: a mint adds to the supplies, a burn takes away. *)
  function afterTransfer(
    const from : address;
    const to : address;
    const ids : list(uint);
    const values : list(uint)
  ) is {
    if from = Address.zero then {
      var minted : uint := 0;
      for (i, id) : (uint, uint) in ids do {
        erc1155Supply.totalSupply[id] += values[i];
        minted += values[i];
      }
      erc1155Supply.totalSupplyAll += minted;
    }
    if to = Address.zero then {
      var burned : uint := 0;
      for (i, id) : (uint, uint) in ids do {
        erc1155Supply.totalSupply[id] -= values[i];
        burned += values[i];
      }
      erc1155Supply.totalSupplyAll -= burned;
    }
  }

  external view function totalSupply(const id : uint) : uint is
    erc1155Supply.totalSupply[id]

  external view function totalSupply() : uint is
    erc1155Supply.totalSupplyAll

  external view function exists(const id : uint) : bool is
    erc1155Supply.totalSupply[id] > 0
}

interface IERC1155Supply is {
  view function totalSupply(id : uint) : uint;
  view function totalSupply() : uint;
  view function exists(id : uint) : bool;
}
