(* Holders burn their own tokens, or tokens they are allowed to spend. Like OpenZeppelin's
   `ERC20Burnable`.

     use ERC20Burnable exposing IERC20Burnable; *)

import "std/evm";
import "std/token/erc20";
import "std/interfaces/erc20";

module ERC20Burnable is {
  requires ERC20;

  external function burn(const value : uint)
    raises ERC20InvalidSender | ERC20InsufficientBalance
  is {
    ERC20.burn(Evm.sender(), value);
  }

  external function burnFrom(const account : address; const value : uint)
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InsufficientBalance
  is {
    ERC20.spendAllowance(account, Evm.sender(), value);
    ERC20.burn(account, value);
  }
}

interface IERC20Burnable is {
  function burn(value : uint)
    raises ERC20InvalidSender | ERC20InsufficientBalance;
  function burnFrom(account : address; value : uint)
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InsufficientBalance;
}
