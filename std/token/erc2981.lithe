(* ERC-2981 royalties, like OpenZeppelin's `ERC2981`: a default royalty, and a royalty per
   token that takes its place. Fees are fractions of 10000, basis points, and a royalty is
   `salePrice * fee / 10000`, rounded down. Marketplaces read it; nothing enforces it.

     use ERC2981 exposing IERC2981; *)

import "std/address";
import "std/interfaces/erc2981";

module ERC2981 is {
  type Royalty is record {
    receiver : address;
    fraction : uint96;
  }

  storage erc2981 at "lithe.std.erc2981" is record {
    defaultRoyalty : Royalty;
    tokenRoyalties : map(uint, Royalty);
  }

  pure function feeDenominator() : uint96 is
    10000

  function setDefaultRoyalty(const receiver : address; const fee : uint96)
    raises ERC2981InvalidDefaultRoyalty | ERC2981InvalidDefaultRoyaltyReceiver
  is {
    assert(
      fee <= feeDenominator(),
      ERC2981InvalidDefaultRoyalty { numerator = uint(fee); denominator = uint(feeDenominator()); }
    );
    assert(receiver <> Address.zero, ERC2981InvalidDefaultRoyaltyReceiver(Address.zero));
    erc2981.defaultRoyalty := { receiver = receiver; fraction = fee; };
  }

  function deleteDefaultRoyalty() is {
    delete erc2981.defaultRoyalty;
  }

  function setTokenRoyalty(const tokenId : uint; const receiver : address; const fee : uint96)
    raises ERC2981InvalidTokenRoyalty | ERC2981InvalidTokenRoyaltyReceiver
  is {
    assert(
      fee <= feeDenominator(),
      ERC2981InvalidTokenRoyalty { tokenId = tokenId; numerator = uint(fee); denominator = uint(feeDenominator()); }
    );
    assert(
      receiver <> Address.zero,
      ERC2981InvalidTokenRoyaltyReceiver { tokenId = tokenId; receiver = Address.zero; }
    );
    erc2981.tokenRoyalties[tokenId] := { receiver = receiver; fraction = fee; };
  }

  (* The token falls back to the default royalty. *)
  function resetTokenRoyalty(const tokenId : uint) is {
    delete erc2981.tokenRoyalties[tokenId];
  }

  external view function royaltyInfo(const tokenId : uint; const salePrice : uint) : (address, uint) is {
    var receiver : address := erc2981.tokenRoyalties[tokenId].receiver;
    var fraction : uint96 := erc2981.tokenRoyalties[tokenId].fraction;
    if receiver = Address.zero then {
      receiver := erc2981.defaultRoyalty.receiver;
      fraction := erc2981.defaultRoyalty.fraction;
    }
  } with (receiver, salePrice * uint(fraction) / uint(feeDenominator()))
}
