(* ERC-3156 flash loans of the token itself, like OpenZeppelin's `ERC20FlashMint`, with no
   fee: the loan is minted to the borrower, the borrower is called, and the loan comes back
   from the borrower's allowance to the token and is burned. The call is deferred, so it
   runs after the mint, and the repayment runs in its continuation. A borrower's own
   failure passes through unchanged.

     use ERC20FlashMint exposing IERC3156FlashLender;

   `flashLoan` mints and burns with `ERC20`, so the token's transfer hooks run for both,
   and their errors join `flashLoan`'s. A token whose hooks raise lists them where it
   exposes `flashLoan`, after `IERC3156FlashLenderViews`:

     use ERC20FlashMint exposing IERC3156FlashLenderViews, {
       function flashLoan(receiver : IERC3156FlashBorrower; token : address; amount : uint; data : bytes) : bool
         raises ...;
     } *)

import "std/crypto";
import "std/evm";
import "std/uint";
import "std/token/erc20";
import "std/interfaces/erc3156";
import "std/interfaces/erc20";

module ERC20FlashMint is {
  requires ERC20;

  pure function returnValue() : bytes32 is
    Crypto.keccak256("ERC3156FlashBorrower.onFlashLoan")

  (* All the supply can still grow by, for the token itself; nothing of any other. *)
  view function maxLoan(const token : address) : uint is {
    var most : uint := 0;
    if token = Evm.self() then {
      most := Uint.max - ERC20.erc20.totalSupply;
    }
  } with most

  view function loanFee(const token : address; const value : uint) : uint
    raises ERC3156UnsupportedToken
  is {
    assert(token = Evm.self(), ERC3156UnsupportedToken(token));
  } with 0

  (* The fee for a loan the token can make. *)
  view function checkLoan(const token : address; const value : uint) : uint
    raises ERC3156ExceededMaxLoan | ERC3156UnsupportedToken
  is {
    const most : uint := maxLoan(token);
    assert(value <= most, ERC3156ExceededMaxLoan(most));
  } with loanFee(token, value)

  (* After the borrower answers: the answer must be ERC-3156's, and the loan and fee come
     back from the borrower's allowance to the token. The caller burns them. *)
  function repay(const receiver : address; const answer : bytes32; const value : uint; const fee : uint)
    raises ERC3156InvalidReceiver | ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender
  is {
    assert(answer = returnValue(), ERC3156InvalidReceiver(receiver));
    ERC20.spendAllowance(receiver, Evm.self(), value + fee);
  }

  external view function maxFlashLoan(const token : address) : uint is
    maxLoan(token)

  external view function flashFee(const token : address; const amount : uint) : uint
    raises ERC3156UnsupportedToken
  is
    loanFee(token, amount)

  external function flashLoan(
    const receiver : IERC3156FlashBorrower;
    const token : address;
    const amount : uint;
    const data : bytes
  ) : bool
    raises ERC3156ExceededMaxLoan | ERC3156UnsupportedToken | ERC3156InvalidReceiver | ERC20InsufficientAllowance
      | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidReceiver | ERC20InvalidSender
      | ERC20InsufficientBalance | forwarded
  is {
    const fee : uint := checkLoan(token, amount);
    ERC20.mint(address(receiver), amount);
    defer receiver.onFlashLoan(Evm.sender(), token, amount, fee, data) then {
      | Ok(answer : bytes32) -> {
          repay(address(receiver), answer, amount, fee);
          ERC20.burn(address(receiver), amount + fee);
        }
      | Error(reason : bytes) -> {
          forward reason;
        }
    };
  } with true
}

(* `IERC3156FlashLender` without `flashLoan`, for a token that lists more errors for it. *)
interface IERC3156FlashLenderViews is {
  view function maxFlashLoan(token : address) : uint;
  view function flashFee(token : address; amount : uint) : uint
    raises ERC3156UnsupportedToken;
}
