(* ERC-4626 tokenized vaults. Shares are an ERC-20; `asset` is the token they are shares
   of. *)

interface IERC4626 is {
  view function asset() : address;
  view function totalAssets() : nat;
  view function convertToShares(assets : nat) : nat;
  view function convertToAssets(shares : nat) : nat;
  view function maxDeposit(receiver : address) : nat;
  view function previewDeposit(assets : nat) : nat;
  view function maxMint(receiver : address) : nat;
  view function previewMint(shares : nat) : nat;
  view function maxWithdraw(owner : address) : nat;
  view function previewWithdraw(assets : nat) : nat;
  view function maxRedeem(owner : address) : nat;
  view function previewRedeem(shares : nat) : nat;
  function deposit(assets : nat; receiver : address) : nat;
  function mint(shares : nat; receiver : address) : nat;
  function withdraw(assets : nat; receiver : address; owner : address) : nat;
  function redeem(shares : nat; receiver : address; owner : address) : nat;
}
