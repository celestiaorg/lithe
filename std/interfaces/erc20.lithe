(* ERC-20 tokens, their metadata extension, and ERC-2612 permits, with the errors of
   ERC-6093 that OpenZeppelin raises. Each interface is exactly its standard's functions,
   so its ERC-165 id is the standard's. *)

import "std/crypto/ecdsa";

error ERC20InsufficientBalance of record {
  sender : address;
  balance : uint;
  needed : uint;
}

error ERC20InvalidSender of address;

error ERC20InvalidReceiver of address;

error ERC20InsufficientAllowance of record {
  spender : address;
  allowance : uint;
  needed : uint;
}

error ERC20InvalidApprover of address;

error ERC20InvalidSpender of address;

error ERC2612ExpiredSignature of uint;

error ERC2612InvalidSigner of record {
  signer : address;
  owner : address;
}

interface IERC20 is {
  view function totalSupply() : uint;
  view function balanceOf(account : address) : uint;
  view function allowance(owner : address; spender : address) : uint;
  function transfer(to : address; value : uint) : bool
    raises ERC20InvalidSender | ERC20InvalidReceiver | ERC20InsufficientBalance;
  function approve(spender : address; value : uint) : bool
    raises ERC20InvalidApprover | ERC20InvalidSpender;
  function transferFrom(from : address; to : address; value : uint) : bool
    raises ERC20InsufficientAllowance | ERC20InvalidApprover | ERC20InvalidSpender | ERC20InvalidSender
      | ERC20InvalidReceiver | ERC20InsufficientBalance;
}

interface IERC20Metadata is {
  view function name() : string;
  view function symbol() : string;
  view function decimals() : uint8;
}

(* ERC-2612: approvals by signature. *)
interface IERC20Permit is {
  function permit(
    owner : address;
    spender : address;
    value : uint;
    deadline : uint;
    v : uint8;
    r : bytes32;
    s : bytes32
  )
    raises ERC2612ExpiredSignature | ERC2612InvalidSigner | ECDSAInvalidSignature | ECDSAInvalidSignatureS
      | ERC20InvalidApprover | ERC20InvalidSpender;
  view function nonces(owner : address) : uint;
  view function DOMAIN_SEPARATOR() : bytes32;
}
