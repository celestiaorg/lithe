(* ERC-2981 royalties, with the errors OpenZeppelin raises for a royalty it refuses to set.
   The interface is exactly the standard's function, so its ERC-165 id is `0x2a55205a`. *)

error ERC2981InvalidDefaultRoyalty of record {
  numerator : uint;
  denominator : uint;
}

error ERC2981InvalidDefaultRoyaltyReceiver of address;

error ERC2981InvalidTokenRoyalty of record {
  tokenId : uint;
  numerator : uint;
  denominator : uint;
}

error ERC2981InvalidTokenRoyaltyReceiver of record {
  tokenId : uint;
  receiver : address;
}

interface IERC2981 is {
  view function royaltyInfo(tokenId : uint; salePrice : uint) : (address, uint);
}
