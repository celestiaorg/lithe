(* ERC-721 tokens, their metadata and enumeration extensions, and the receiver callback,
   with the errors of ERC-6093 that OpenZeppelin raises. Each interface is exactly its
   standard's functions, so its ERC-165 id is the standard's: `0x80ac58cd`, `0x5b5e139f`,
   and `0x780e9d63`. *)

error ERC721InvalidOwner of address;

error ERC721NonexistentToken of nat;

error ERC721IncorrectOwner of record {
  sender : address;
  tokenId : nat;
  owner : address;
}

error ERC721InvalidSender of address;

error ERC721InvalidReceiver of address;

error ERC721InsufficientApproval of record {
  operator : address;
  tokenId : nat;
}

error ERC721InvalidApprover of address;

error ERC721InvalidOperator of address;

interface IERC721 is {
  view function balanceOf(owner : address) : nat
    raises ERC721InvalidOwner;
  view function ownerOf(tokenId : nat) : address
    raises ERC721NonexistentToken;
  view function getApproved(tokenId : nat) : address
    raises ERC721NonexistentToken;
  view function isApprovedForAll(owner : address; operator : address) : bool;
  function approve(to : address; tokenId : nat)
    raises ERC721NonexistentToken | ERC721InvalidApprover;
  function setApprovalForAll(operator : address; approved : bool)
    raises ERC721InvalidApprover | ERC721InvalidOperator;
  function transferFrom(from : address; to : address; tokenId : nat)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval;
  function safeTransferFrom(from : address; to : address; tokenId : nat)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
      | forwarded;
  function safeTransferFrom(from : address; to : address; tokenId : nat; data : bytes)
    raises ERC721InvalidReceiver | ERC721IncorrectOwner | ERC721NonexistentToken | ERC721InsufficientApproval
      | forwarded;
}

interface IERC721Metadata is {
  view function name() : string;
  view function symbol() : string;
  view function tokenURI(tokenId : nat) : string
    raises ERC721NonexistentToken;
}

(* OpenZeppelin's, for an index past the end of an enumeration. *)
error ERC721OutOfBoundsIndex of record {
  owner : address;
  index : nat;
}

interface IERC721Enumerable is {
  view function totalSupply() : nat;
  view function tokenOfOwnerByIndex(owner : address; index : nat) : nat
    raises ERC721InvalidOwner | ERC721OutOfBoundsIndex;
  view function tokenByIndex(index : nat) : nat
    raises ERC721OutOfBoundsIndex;
}

interface IERC721Receiver is {
  function onERC721Received(operator : address; from : address; tokenId : nat; data : bytes) : bytes4;
}
