(* Execution context: the message, the transaction, the block, and accounts, and the calls
   that send ether or raw calldata. Readable in `view` and stateful functions, and not in
   `pure` functions. *)

module Evm is {
  (* `msg.sender`: the caller of the current frame. *)
  intrinsic view function sender() : address;

  (* `msg.value`: the ether sent with the call. Only in `payable` functions. *)
  intrinsic view function value() : wei;

  (* `msg.data`: the whole calldata. *)
  intrinsic view function calldata() : bytes;

  (* `msg.sig`: the calldata's first four bytes. *)
  intrinsic view function selector() : bytes4;

  (* `tx.origin`: the account that signed the transaction. Do not use it for
     authorization. *)
  intrinsic view function txOrigin() : address;

  (* `tx.gasprice`. *)
  intrinsic view function txGasPrice() : wei;

  (* `block.number`. *)
  intrinsic view function blockNumber() : uint;

  (* `block.timestamp`. *)
  intrinsic view function blockTimestamp() : timestamp;

  (* `block.coinbase`. *)
  intrinsic view function blockCoinbase() : address;

  (* `block.basefee`. *)
  intrinsic view function blockBaseFee() : wei;

  (* `block.blobbasefee`. *)
  intrinsic view function blobBaseFee() : wei;

  (* `block.chainid`. *)
  intrinsic view function chainId() : uint;

  (* `block.prevrandao`. *)
  intrinsic view function blockPrevrandao() : bytes32;

  (* `block.gaslimit`. *)
  intrinsic view function blockGasLimit() : uint;

  (* `blockhash(n)`: the hash of one of the 256 most recent blocks, zero for any other. *)
  intrinsic view function blockHash(n : uint) : bytes32;

  (* `blobhash(i)`: the versioned hash of the transaction's `i`th blob. *)
  intrinsic view function blobHash(i : uint) : bytes32;

  (* `address(this)`. *)
  intrinsic view function self() : address;

  (* `a.balance`. *)
  intrinsic view function balance(a : address) : wei;

  (* `a.code.length`. *)
  intrinsic view function codeSize(a : address) : uint;

  (* `a.codehash`. *)
  intrinsic view function codeHash(a : address) : bytes32;

  (* `a.code`. *)
  intrinsic view function code(a : address) : bytes;

  (* creationCode(C) : bytes
     `type(C).creationCode`: the creation code `create C(...)` runs, for a contract `C` of
     this file or of a file it imports. Usable in `pure` functions; its hash is a
     constant. *)
  intrinsic creationCode;

  (* facetAddress(M) : address
     The address of the facet the contract runs a module `M` from, one it uses
     `delegated`. A constant, known once the facet is built; for contract code only. *)
  intrinsic facetAddress;

  (* `gasleft()`. *)
  intrinsic view function gasLeft() : uint;

  (* `payable(to).call{value: amount}("")`, as an operation: `defer Evm.transfer(to,
     amount);`. *)
  intrinsic function transfer(to : address; amount : wei) : operation;

  (* `to.call{value: v}(data)`, as an operation, with `with value = v`. A continuation gets
     the return data as `bytes`. *)
  intrinsic function call(to : address; data : bytes) : operation;

  (* `to.delegatecall(data)`, as an operation: `to`'s code runs as this contract. *)
  intrinsic function delegateCall(to : address; data : bytes) : operation;

  (* `to.staticcall(data)`, run with `query`: the return data. *)
  intrinsic view function staticCall(to : address; data : bytes) : bytes;

  (* osaka : bool
     Whether the code is built for Osaka or later, as `--evm-version` sets. A constant, so
     `pure` functions read it, and an `if` on it builds only the target's branch. *)
  intrinsic osaka;
}
