(* Growing and shrinking dynamic lists, stored or held in a `var`. Each is a statement that
   writes the list as an assignment does. *)

module List is {
  (* push(xs : list(T); v : T)
     `List.push(xs, v);`: appends `v`. *)
  intrinsic push;

  (* pop(xs : list(T))
     `List.pop(xs);`: drops the last element. `Panic(0x31)` if the list is empty. *)
  intrinsic pop;

  (* resized(xs : list(T); n : uint) : list(T)
     A new list of `xs`'s first `n` elements, padded with zero values to `n` when `xs` is
     shorter: `List.resized([], n)` is Solidity's `new T[](n)`. `Panic(0x41)` if `n` is
     2^64 or more. *)
  intrinsic resized;
}
