(* Conversions between `uint` and `int` that raise OpenZeppelin's `SafeCast` errors instead
   of the `Panic(0x11)` that `uint(x)` and `int(x)` raise when the value doesn't fit. *)

import "std/int";
import "std/uint";

module SafeCast is {
  error SafeCastOverflowedIntToUint of int;
  error SafeCastOverflowedUintToInt of uint;

  pure function toUint(const x : int) : uint
    raises SafeCastOverflowedIntToUint
  is {
    assert(x >= 0, SafeCastOverflowedIntToUint(x));
  } with Uint.fromBits(x)

  pure function toInt(const x : uint) : int
    raises SafeCastOverflowedUintToInt
  is {
    assert(x <= uint(Int.max), SafeCastOverflowedUintToInt(x));
  } with Int.fromBits(x)
}
