(* Signed integers. `min`, `max`, and the operations on two values take their width from
   the values, or from the type the context expects; with neither, 256 bits. *)

module Int is {
  (* min : int
     `type(int256).min`, or the expected signed type's. *)
  intrinsic min;

  (* max : int
     `type(int256).max`, or the expected signed type's. *)
  intrinsic max;

  (* divRem(a : T; b : T) : (T, T)
     `(a / b, a % b)`, truncating, for two values of one signed type. *)
  intrinsic divRem;

  (* wrappingAdd(a : T; b : T) : T
     `unchecked { a + b }`, in two's complement. *)
  intrinsic wrappingAdd;

  (* wrappingSub(a : T; b : T) : T
     `unchecked { a - b }`. *)
  intrinsic wrappingSub;

  (* wrappingMul(a : T; b : T) : T
     `unchecked { a * b }`. *)
  intrinsic wrappingMul;

  (* toString(n : T) : string
     A signed integer of any width in decimal, with `-` first when negative. *)
  intrinsic toString;

  (* `int256(n)`: the same 256 bits, unchecked. *)
  intrinsic pure function fromBits(n : uint) : int;
}
