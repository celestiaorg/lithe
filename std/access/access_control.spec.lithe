(* What `AccessControl` guarantees: only a role's admins grant and revoke it, and an account
   renounces only its own roles. *)

spec for module AccessControl is {
  spec for grantRole is {
    raises AccessControlUnauthorizedAccount
      when not old.storage.access.members[storage.access.admins[role]][Evm.sender()];
    ensures new.storage.access.members[role][account];
    ensures new.storage.access.admins[role] = old.storage.access.admins[role];
  }

  spec for revokeRole is {
    raises AccessControlUnauthorizedAccount
      when not old.storage.access.members[storage.access.admins[role]][Evm.sender()];
    ensures not new.storage.access.members[role][account];
    ensures new.storage.access.admins[role] = old.storage.access.admins[role];
  }

  spec for renounceRole is {
    raises AccessControlBadConfirmation when callerConfirmation <> Evm.sender();
    ensures not new.storage.access.members[role][callerConfirmation];
  }
}
