(* Two-step ownership transfer on top of `Ownable`: the owner proposes, and the new owner
   accepts. A mistyped address can't take ownership, because it never accepts. Matches
   OpenZeppelin's `Ownable2Step`, whose whole interface this module exposes:

     use Ownable;
     use Ownable2Step exposing IOwnable2Step; *)

import "std/address";
import "std/evm";
import "std/access/ownable";

module Ownable2Step is {
  requires Ownable;

  storage ownable2step at "lithe.std.ownable2step" is record {
    pending : address;
  }

  event OwnershipTransferStarted of record {
    indexed previousOwner : address;
    indexed newOwner : address;
  }

  external view function owner() : address is
    Ownable.ownable.owner

  external view function pendingOwner() : address is
    ownable2step.pending

  (* Proposes `newOwner`. Proposing the zero address cancels a pending transfer. *)
  external function transferOwnership(const newOwner : address)
    raises OwnableUnauthorizedAccount
  is {
    Ownable.checkOwner();
    ownable2step.pending := newOwner;
    emit OwnershipTransferStarted {
      previousOwner = Ownable.ownable.owner;
      newOwner = newOwner;
    };
  }

  external function acceptOwnership()
    raises OwnableUnauthorizedAccount
  is {
    assert(ownable2step.pending = Evm.sender(), OwnableUnauthorizedAccount(Evm.sender()));
    ownable2step.pending := Address.zero;
    Ownable.setOwner(Evm.sender());
  }

  external function renounceOwnership()
    raises OwnableUnauthorizedAccount
  is {
    Ownable.checkOwner();
    ownable2step.pending := Address.zero;
    Ownable.setOwner(Address.zero);
  }
}

interface IOwnable2Step is {
  view function owner() : address;
  view function pendingOwner() : address;
  function transferOwnership(newOwner : address)
    raises OwnableUnauthorizedAccount;
  function acceptOwnership()
    raises OwnableUnauthorizedAccount;
  function renounceOwnership()
    raises OwnableUnauthorizedAccount;
}
