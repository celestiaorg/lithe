(* What `Ownable` guarantees: only the owner moves ownership, and exactly as asked. *)

spec for module Ownable is {
  spec for transferOwnership is {
    raises OwnableUnauthorizedAccount when Evm.sender() <> old.storage.ownable.owner;
    raises OwnableInvalidOwner when newOwner = Address.zero;
    ensures new.storage.ownable.owner = newOwner;
  }

  spec for renounceOwnership is {
    raises OwnableUnauthorizedAccount when Evm.sender() <> old.storage.ownable.owner;
    ensures new.storage.ownable.owner = Address.zero;
  }
}
