(* EIP-712 typed structured data. `init` records the domain's name and version, usually
   from `deploy`; the chain id and this contract's address are read when a hash is made,
   so the domain stays correct on a fork.

     deploy() is {
       EIP712.init("My Token", "1");
     }

     const digest : bytes32 := EIP712.hash_typed_data(
       Crypto.keccak256(Abi.encode(mail_typehash(), from, to, contents_hash))
     ); *)

module EIP712 is {
  storage eip712 at "lithe.std.eip712" is record {
    hashed_name : bytes32;
    hashed_version : bytes32;
  }

  (* keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)") *)
  pure function domain_typehash() : bytes32 is
    0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f

  function init(const name : string; const version : string) is {
    eip712.hashed_name := Crypto.keccak256(name);
    eip712.hashed_version := Crypto.keccak256(version);
  }

  view function domain_separator() : bytes32 is
    Crypto.keccak256(Abi.encode(
      domain_typehash(),
      eip712.hashed_name,
      eip712.hashed_version,
      Evm.chain_id(),
      Evm.self()
    ))

  (* The digest to sign for a struct, given the struct's `hashStruct`. *)
  view function hash_typed_data(const struct_hash : bytes32) : bytes32 is
    to_typed_data_hash(domain_separator(), struct_hash)

  pure function to_typed_data_hash(const domain : bytes32; const struct_hash : bytes32) : bytes32 is {
    const prefix : bytes2 := 0x1901;
  } with Crypto.keccak256(Abi.encode_packed(prefix, domain, struct_hash))
}
