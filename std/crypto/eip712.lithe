(* EIP-712 typed structured data. `init` records the hashes of the domain's name and
   version as immutables, so it runs only from `deploy` or a migration, and a hash reads
   them from the code, or from storage in an upgradeable contract. The chain id and this
   contract's address are read when a hash is made, so the domain stays correct on a fork.

     deploy() is {
       EIP712.init("My Token", "1");
     }

     const digest : bytes32 := EIP712.hashTypedData(
       Crypto.keccak256(Abi.encode(mailTypehash(), from, to, contentsHash))
     );

   and exposes the domain separator for signers, and ERC-5267's description of it:

     use EIP712 exposing IERC5267, {
       view function DOMAIN_SEPARATOR() : bytes32;
     }

   The name and version are kept for `eip712Domain` much as OpenZeppelin's `ShortStrings`
   keeps them: a string under 32 bytes is an immutable word of its bytes and its length.
   If either is longer, both are stored, and the name's word is 255. *)

import "std/interfaces/erc5267";

import "std/abi";
import "std/crypto";
import "std/evm";
import "std/bytes";

module EIP712 is {
  immutable eip712 at "lithe.std.eip712" is record {
    hashedName : bytes32;
    hashedVersion : bytes32;
    name : bytes32;
    version : bytes32;
  }

  type Names is record {
    name : string;
    version : string;
  }

  storage eip712Strings at "lithe.std.eip712.strings" is record {
    long : Names;
  }

  pure function domainTypehash() : bytes32 is
    Crypto.keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")

  function init(const name : string; const version : string) is {
    eip712.hashedName := Crypto.keccak256(name);
    eip712.hashedVersion := Crypto.keccak256(version);
    eip712.name := bytes32(uint(bytes32(bytes(name))) | name.length);
    eip712.version := bytes32(uint(bytes32(bytes(version))) | version.length);
    if name.length > 31 or version.length > 31 then {
      eip712.name := bytes32(255);
      eip712Strings.long := { name = name; version = version; };
    }
  }

  pure function fromShortString(const s : bytes32) : string is
    string(Bytes.concat(s)[:uint(s) & 255])

  view function domainSeparator() : bytes32 is
    Crypto.keccak256(Abi.encode(
      domainTypehash(),
      eip712.hashedName,
      eip712.hashedVersion,
      Evm.chainId(),
      Evm.self()
    ))

  (* The digest to sign for a struct, given the struct's `hashStruct`. *)
  view function hashTypedData(const structHash : bytes32) : bytes32 is
    toTypedDataHash(domainSeparator(), structHash)

  pure function toTypedDataHash(const domain : bytes32; const structHash : bytes32) : bytes32 is {
    const prefix : bytes2 := 0x1901;
  } with Crypto.keccak256(Abi.encodePacked(prefix, domain, structHash))

  external view function DOMAIN_SEPARATOR() : bytes32 is
    domainSeparator()

  external view function eip712Domain() : EIP712Domain is {
    const extensions : list(uint) := [];
    const both : Names := if eip712.name = bytes32(255) then eip712Strings.long else {
      name = fromShortString(eip712.name);
      version = fromShortString(eip712.version);
    };
  } with {
    fields = 0x0f;
    name = both.name;
    version = both.version;
    chainId = Evm.chainId();
    verifyingContract = Evm.self();
    salt = bytes32(0);
    extensions = extensions;
  }
}
