(* RFC 4648 base64, with the same algorithm and lookup tables as Solady's `Base64`. `data`
   is `bytes` or a `string`. Usable in any function, `pure` ones included. *)

module Base64 is {
  (* encode(data : bytes | string) : string
     The standard alphabet, padded with `=`. *)
  intrinsic encode;

  (* encodeUrl(data : bytes | string) : string
     `-` and `_` for `+` and `/`, and no padding. *)
  intrinsic encodeUrl;

  (* encodeWith(data : bytes | string; fileSafe : bool; noPadding : bool) : string
     `encodeWith(data, fileSafe, noPadding)`, with `bool` flags. *)
  intrinsic encodeWith;

  (* decode(data : bytes | string) : bytes
     The bytes either alphabet encodes, padded or not. Other characters decode as
     Solady's table has them, or as zero bits where it has none; a byte from 0x80 decodes
     as its low seven bits. *)
  intrinsic decode;
}
