(* Booleans packed 256 to a storage slot, for claims, processed ids, and other flags over
   dense indexes. Setting a neighbor's flag costs a warm write instead of a fresh slot.

     storage is record {
       claimed : bitmap;
     } *)

module Bitmap is {
  type bitmap is map(nat, nat);

  view function get(storage bits : bitmap; const index : nat) : bool is
    (bits[index >> 8n] >> (index & 255n)) & 1n = 1n

  function set(storage bits : bitmap; const index : nat) is {
    bits[index >> 8n] := bits[index >> 8n] | (1n << (index & 255n));
  }

  function unset(storage bits : bitmap; const index : nat) is {
    bits[index >> 8n] := bits[index >> 8n] & ~(1n << (index & 255n));
  }

  function set_to(storage bits : bitmap; const index : nat; const value : bool) is {
    if value then {
      set(bits, index);
    } else {
      unset(bits, index);
    }
  }
}
