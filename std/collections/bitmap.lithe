(* Booleans packed 256 to a storage slot, for claims, processed ids, and other flags over
   dense indexes. Setting a neighbor's flag costs a warm write instead of a fresh slot.

     storage is record {
       claimed : bitmap;
     } *)

import "std/uint";

module Bitmap is {
  type Bitmap is map(uint, uint);

  view function get(storage bits : Bitmap; const index : uint) : bool is
    (bits[index >> 8] >> (index & 255)) & 1 = 1

  function set(storage bits : Bitmap; const index : uint) is {
    bits[index >> 8] |= 1 << (index & 255);
  }

  function unset(storage bits : Bitmap; const index : uint) is {
    bits[index >> 8] &= ~(1 << (index & 255));
  }

  function setTo(storage bits : Bitmap; const index : uint; const value : bool) is {
    if value then {
      set(bits, index);
    } else {
      unset(bits, index);
    }
  }

  (* Sets the `amount` flags from `start`: the first slot from `start` on, whole slots
     between, then the last one up to the end, as Solady's `setBatch` does. *)
  function setBatch(storage bits : Bitmap; const start : uint; const amount : uint) is {
    const _ : uint := start + amount;
    var bucket : uint := start >> 8;
    var shift : uint := start & 255;
    var n : uint := amount;
    const total : uint := Uint.wrappingAdd(shift, amount);
    if total > 256 then {
      bits[bucket] |= Uint.max << shift;
      const last : uint := Uint.wrappingAdd(bucket, total >> 8);
      for b : uint in Uint.wrappingAdd(bucket, 1) .. last do {
        bits[b] := Uint.max;
      }
      bucket := last;
      n := total & 255;
      shift := 0;
    }
    bits[bucket] |= (Uint.max >> Uint.wrappingSub(256, n)) << shift;
  }

  function unsetBatch(storage bits : Bitmap; const start : uint; const amount : uint) is {
    const _ : uint := start + amount;
    var bucket : uint := start >> 8;
    var shift : uint := start & 255;
    var n : uint := amount;
    const total : uint := Uint.wrappingAdd(shift, amount);
    if total > 256 then {
      bits[bucket] &= ~(Uint.max << shift);
      const last : uint := Uint.wrappingAdd(bucket, total >> 8);
      for b : uint in Uint.wrappingAdd(bucket, 1) .. last do {
        bits[b] := 0;
      }
      bucket := last;
      n := total & 255;
      shift := 0;
    }
    bits[bucket] &= ~((Uint.max >> Uint.wrappingSub(256, n)) << shift);
  }

  (* How many of the `amount` flags from `start` are set. *)
  view function popCount(storage bits : Bitmap; const start : uint; const amount : uint) : uint is {
    const _ : uint := start + amount;
    var bucket : uint := start >> 8;
    var shift : uint := start & 255;
    var n : uint := amount;
    var count : uint := 0;
    const total : uint := Uint.wrappingAdd(shift, amount);
    if total > 256 then {
      count := Uint.popCount(bits[bucket] >> shift);
      const last : uint := Uint.wrappingAdd(bucket, total >> 8);
      for b : uint in Uint.wrappingAdd(bucket, 1) .. last do {
        count := Uint.wrappingAdd(Uint.popCount(bits[b]), count);
      }
      bucket := last;
      n := total & 255;
      shift := 0;
    }
  } with Uint.wrappingAdd(Uint.popCount((bits[bucket] >> shift) << Uint.wrappingSub(256, n)), count)
}
