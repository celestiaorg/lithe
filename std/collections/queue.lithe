(* A first-in, first-out queue. Pushing and popping each touch one element and a
   counter, however long the queue is. Popping leaves the element in storage: a generic
   `T` has no zero value to write back.

     storage is record {
       pending : Queue(address);
     }

     Queue.push(storage.pending, Evm.sender());
     const next : address := Queue.pop(storage.pending); *)

module Queue(T) is {
  type self is record {
    items : map(uint, T);
    head : uint;
    tail : uint;
  }

  error QueueEmpty;
  error QueueOutOfBounds of uint;

  view function length(storage q : self) : uint is
    q.tail - q.head

  view function is_empty(storage q : self) : bool is
    q.tail = q.head

  (* The element `index` places from the front. *)
  view function at(storage q : self; const index : uint) : T
    raises QueueOutOfBounds
  is {
    assert(index < q.tail - q.head, QueueOutOfBounds(index));
  } with q.items[q.head + index]

  view function front(storage q : self) : T
    raises QueueEmpty
  is {
    assert(q.tail > q.head, QueueEmpty);
  } with q.items[q.head]

  view function back(storage q : self) : T
    raises QueueEmpty
  is {
    assert(q.tail > q.head, QueueEmpty);
  } with q.items[q.tail - 1]

  function push(storage q : self; const value : T) is {
    q.items[q.tail] := value;
    q.tail := q.tail + 1;
  }

  (* Removes and returns the front element. *)
  function pop(storage q : self) : T
    raises QueueEmpty
  is {
    assert(q.tail > q.head, QueueEmpty);
    const value : T := q.items[q.head];
    q.head := q.head + 1;
  } with value
}
